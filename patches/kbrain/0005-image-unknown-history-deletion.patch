+package imaging
+
+import (
+	"context"
+	"testing"
+	"time"
+)
+
+func TestResultUnknownDeletionWaitsOnlyForWorkerLease(t *testing.T) {
+	for _, deleteProject := range []bool{false, true} {
+		name := "job"
+		if deleteProject {
+			name = "project"
+		}
+		t.Run(name, func(t *testing.T) {
+			s, _, adapter, scope, request := engineFixture(t)
+			ctx := context.Background()
+			job, _, err := s.CreateJob(ctx, scope, "unknown-delete", request)
+			if err != nil {
+				t.Fatal(err)
+			}
+			setLease := func(owner string) {
+				t.Helper()
+				if err := s.store.Update(WithScope(ctx, scope), func(tx *Transaction) error {
+					j, err := tx.ReadJob(scope, job.ID)
+					if err != nil {
+						return err
+					}
+					ex, err := tx.ReadExecution(scope, job.ID)
+					if err != nil {
+						return err
+					}
+					x := ex.Items[j.Items[0].ID]
+					x.LeaseOwner = owner
+					x.LeaseExpiresAt = time.Now().Add(-time.Hour)
+					ex.Items[j.Items[0].ID] = x
+					j.Status, j.Items[0].Status = JobResultUnknown, JobResultUnknown
+					j.Error = &ImageError{Code: CodeResultUnknown}
+					if err := tx.PutExecution(ex); err != nil {
+						return err
+					}
+					return s.writeJob(tx, &j, EventJobStateChanged)
+				}); err != nil {
+					t.Fatal(err)
+				}
+			}
+			project, err := s.store.ReadProject(scope, request.ProjectID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			remove := func() error {
+				if deleteProject {
+					return s.store.DeleteProject(ctx, scope, project.ID, project.Revision)
+				}
+				return s.store.DeleteJob(ctx, scope, job.ID)
+			}
+			setLease("finishing-worker")
+			assertEngineError(t, remove(), CodeProjectBusy)
+			stillUnknown, err := s.store.ReadJob(scope, job.ID)
+			if err != nil || stillUnknown.Status != JobResultUnknown {
+				t.Fatalf("busy delete changed the unknown result: %+v, %v", stillUnknown, err)
+			}
+			setLease("")
+			if err := remove(); err != nil {
+				t.Fatalf("unknown result without a worker must be deletable: %v", err)
+			}
+			if err := remove(); err != nil {
+				t.Fatalf("repeated delete must be idempotent: %v", err)
+			}
+			_, err = s.store.ReadJob(scope, job.ID)
+			assertEngineError(t, err, CodeNotFound)
+			if _, exists := s.store.GetIdempotency(scope, "unknown-delete"); !exists {
+				t.Fatal("deletion lost the original request receipt")
+			}
+			_, replayed, err := s.CreateJob(ctx, scope, "unknown-delete", request)
+			assertEngineError(t, err, CodeNotFound)
+			if !replayed {
+				t.Fatal("deleted request was submitted as new work")
+			}
+			if submits, polls, reconciles, cancels := adapter.counts(); submits != 0 || polls != 0 || reconciles != 0 || cancels != 0 {
+				t.Fatalf("deletion made provider calls: %d %d %d %d", submits, polls, reconciles, cancels)
+			}
+		})
+	}
+}
