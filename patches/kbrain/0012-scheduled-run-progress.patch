new file mode 100644
index 0000000..627eed3
--- /dev/null
+++ b/internal/backend/cron_progress.go
@@ -0,0 +1,119 @@
+package backend
+
+import (
+	"encoding/json"
+	"net/http"
+	"strconv"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/Stack-Cairn/K-brain/internal/protocol"
+)
+
+const maxCronProgressBytes = 64 << 10
+
+type cronProgress struct {
+	SessionID string `json:"sessionId"`
+	RunID     string `json:"runId"`
+	Cursor    int64  `json:"cursor"`
+	Text      string `json:"text"`
+	Done      bool   `json:"done"`
+	More      bool   `json:"more"`
+	Truncated bool   `json:"truncated,omitempty"`
+}
+
+func (c *cronStore) findExecution(taskID, executionID string) (CronRunRecord, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.task(taskID) != nil {
+		for i := len(c.disk.Runs) - 1; i >= 0; i-- {
+			run := c.disk.Runs[i]
+			if run.TaskID == taskID && run.ID == executionID {
+				return run, true
+			}
+		}
+	}
+	return CronRunRecord{}, false
+}
+
+// Resolve the session and run from the scheduler record. A cursor cannot
+// select another run, and only parent assistant text can leave this endpoint.
+func (s *Server) cronRunProgress(w http.ResponseWriter, r *http.Request, taskID, executionID string) {
+	w.Header().Set("Cache-Control", "no-store")
+	after, err := strconv.ParseInt(r.URL.Query().Get("after"), 10, 64)
+	if err != nil || after < 0 {
+		writeJSONError(w, http.StatusBadRequest, "invalid progress cursor")
+		return
+	}
+	run, ok := s.cron.store.findExecution(taskID, executionID)
+	if !ok || !validID(run.SessionID) || run.RunID == "" {
+		writeJSONError(w, http.StatusNotFound, "cron execution has no conversation")
+		return
+	}
+	rt, err := s.historyRuntime(run.SessionID)
+	if err != nil {
+		mutationError(w, err)
+		return
+	}
+	defer s.releaseRuntime(rt)
+	rt.mu.Lock()
+	var accepted int64
+	for _, record := range rt.runs {
+		if record.RunID == run.RunID {
+			accepted = record.AcceptedSeq
+			break
+		}
+	}
+	if rt.deleted || accepted == 0 {
+		rt.mu.Unlock()
+		writeJSONError(w, http.StatusNotFound, "cron conversation run not found")
+		return
+	}
+	if after > rt.nextSeq {
+		rt.mu.Unlock()
+		writeJSONError(w, http.StatusBadRequest, "progress cursor is beyond the journal")
+		return
+	}
+	result := cronProgress{SessionID: run.SessionID, RunID: run.RunID, Cursor: max(after, accepted)}
+	events, err := rt.eventsAfterLocked(result.Cursor)
+	head := rt.nextSeq
+	rt.mu.Unlock()
+	if err != nil {
+		writeJSONError(w, http.StatusInternalServerError, "cannot read cron run progress")
+		return
+	}
+	var text strings.Builder
+readEvents:
+	for _, event := range events {
+		if event.RunID == run.RunID && event.ParentRunID == "" {
+			switch event.Type {
+			case protocol.EventTextDelta:
+				var delta protocol.TextDelta
+				if err := json.Unmarshal(event.Payload, &delta); err != nil {
+					writeJSONError(w, http.StatusInternalServerError, "cannot read cron run text")
+					return
+				}
+				if text.Len() > 0 && len(delta.Text) > maxCronProgressBytes-text.Len() {
+					break readEvents
+				}
+				if len(delta.Text) > maxCronProgressBytes {
+					end := maxCronProgressBytes
+					for !utf8.RuneStart(delta.Text[end]) {
+						end--
+					}
+					delta.Text, result.Truncated = delta.Text[:end], true
+				}
+				text.WriteString(delta.Text)
+			case protocol.EventRunCompleted, protocol.EventRunFailed, protocol.EventRunCancelled:
+				result.Cursor, result.Done = event.Seq, true
+				break readEvents
+			}
+		}
+		result.Cursor = event.Seq
+	}
+
+	result.Text = text.String()
+	result.More = !result.Done && result.Cursor < head
+	result.Done = result.Done || (!result.More && run.FinishedAt != nil)
+	writeJSON(w, http.StatusOK, result)
+}
