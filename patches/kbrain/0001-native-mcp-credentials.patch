+func TestNativeCredentialsSavedEnabledServerStartsCallsToolsAndNeverPersistsTokens(t *testing.T) {
+	for _, streaming := range []bool{false, true} {
+		t.Run(map[bool]string{false: "json", true: "sse"}[streaming], func(t *testing.T) {
+			const old, fresh, hostToken = "stale-fixture-access", "fresh-fixture-access", "fixture-host-capability-0123456789abcdef"
+			var lookups, refreshes atomic.Int32
+			var tokenMu sync.Mutex
+			current := old
+			rpc := sdkmcp.NewServer(&sdkmcp.Implementation{Name: "native-auth-fixture"}, nil)
+			sdkmcp.AddTool(rpc, &sdkmcp.Tool{Name: "echo", InputSchema: map[string]any{"type": "object"}}, func(context.Context, *sdkmcp.CallToolRequest, struct{}) (*sdkmcp.CallToolResult, any, error) {
+				return &sdkmcp.CallToolResult{Content: []sdkmcp.Content{&sdkmcp.TextContent{Text: "echo " + fresh}}}, nil, nil
+			})
+			rpcHandler := sdkmcp.NewStreamableHTTPHandler(func(*http.Request) *sdkmcp.Server { return rpc }, &sdkmcp.StreamableHTTPOptions{Stateless: true, JSONResponse: !streaming})
+			upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("Authorization") != "Bearer "+fresh {
+					w.WriteHeader(401)
+					_, _ = io.WriteString(w, old)
+					return
+				}
+				rpcHandler.ServeHTTP(w, r)
+			}))
+			defer upstream.Close()
+			host := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Method != "POST" || r.URL.Path != "/v1/mcp/credential" || r.Header.Get("Authorization") != "Bearer "+hostToken {
+					t.Error("invalid host request")
+					w.WriteHeader(401)
+					return
+				}
+				var request struct {
+					Protocol string                 `json:"protocol"`
+					Target   NativeCredentialTarget `json:"target"`
+					Previous string                 `json:"previousTokenHash"`
+				}
+				if json.NewDecoder(r.Body).Decode(&request) != nil || request.Protocol != NativeCredentialProtocol || request.Target.ID != "remote" || request.Target.URL != upstream.URL || request.Target.CredentialRef != "private-ref" || request.Target.Scope != "read" || request.Target.ClientID != "static-client" {
+					t.Error("unbound target")
+					w.WriteHeader(400)
+					return
+				}
+				lookups.Add(1)
+				tokenMu.Lock()
+				defer tokenMu.Unlock()
+				if request.Previous != "" {
+					sum := sha256.Sum256([]byte(old))
+					if request.Previous != hex.EncodeToString(sum[:]) {
+						t.Error("incorrect rejected-token digest")
+					}
+					refreshes.Add(1)
+					current = fresh
+				}
+				_ = json.NewEncoder(w).Encode(map[string]string{"protocol": NativeCredentialProtocol, "accessToken": current})
+			}))
+			defer host.Close()
+			bridge, err := NewNativeCredentialBridge(host.URL+"/v1/mcp/credential", hostToken)
+			if err != nil {
