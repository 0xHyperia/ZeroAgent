+			}
+			file := filepath.Join(t.TempDir(), "mcp.json")
+			settings := LiveSettings{Servers: []LiveServer{{ID: "remote", Enabled: true, Transport: "http", URL: upstream.URL,
+				Headers: map[string]string{"Authorization": "must-not-override-native"}, Auth: &LiveAuth{Type: "oauth", Scope: "read", ClientID: "static-client", CredentialRef: "private-ref"}, Policy: map[string]string{"echo": "allow"}}}}
+			if err := saveLiveSettings(file, settings); err != nil {
+				t.Fatal(err)
+			}
+			live, err := OpenLiveManagerWithNativeCredentials(context.Background(), file, nil, bridge)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer live.Close()
+			waitLiveStatus(t, live, "remote", "ready")
+			before := lookups.Load()
+			result := toolsExecute(t, live.ToolsFor(context.Background(), t.TempDir(), nil), ToolName("remote", "echo"), nil)
+			if result != "echo [redacted]" || lookups.Load() <= before || refreshes.Load() != 1 {
+				t.Fatalf("result=%q lookups=%d refresh=%d", result, lookups.Load(), refreshes.Load())
