diff --git a/internal/mcp/native_credentials.go b/internal/mcp/native_credentials.go
new file mode 100644
index 0000000000000000000000000000000000000000..395bd63e62fe83a7c2272d1c5ea642e9244daf27
--- /dev/null
+++ b/internal/mcp/native_credentials.go
@@ -0,0 +1,297 @@
+package mcp
+
+import (
+	"bytes"
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"time"
+)
+
+const NativeCredentialProtocol = "zeroagent.mcp-credentials.v1"
+const nativeAuthRequired = "MCP_OAUTH_AUTHORIZATION_REQUIRED"
+
+// NativeCredentialTarget describes the saved recipient, never a bearer token.
+// Headers retain their saved form for the host's private target comparison.
+type NativeCredentialTarget struct {
+	ID            string            `json:"id"`
+	Transport     string            `json:"transport"`
+	URL           string            `json:"url"`
+	Scope         string            `json:"scope,omitempty"`
+	ClientID      string            `json:"clientId,omitempty"`
+	CredentialRef string            `json:"credentialRef,omitempty"`
+	Headers       map[string]string `json:"headers,omitempty"`
+}
+
+// previousTokenHash is empty for ordinary requests; a 401 supplies the digest
+// of the rejected token so concurrent refreshes cannot consume the same grant.
+type NativeCredentialBridge func(context.Context, NativeCredentialTarget, string) (string, error)
+
+func NativeCredentialBridgeFromEnv() (NativeCredentialBridge, error) {
+	endpoint, token := os.Getenv("ZEROAGENT_MCP_CREDENTIAL_ENDPOINT"), os.Getenv("ZEROAGENT_MCP_CREDENTIAL_TOKEN")
+	// Consume the capability before tool and stdio subprocesses are initialized.
+	_ = os.Unsetenv("ZEROAGENT_MCP_CREDENTIAL_ENDPOINT")
+	_ = os.Unsetenv("ZEROAGENT_MCP_CREDENTIAL_TOKEN")
+	if endpoint == "" && token == "" {
+		return nil, nil
+	}
+	return NewNativeCredentialBridge(endpoint, token)
+}
+
+func NewNativeCredentialBridge(endpoint, token string) (NativeCredentialBridge, error) {
+	u, err := url.Parse(endpoint)
+	if err != nil || u.Scheme != "http" || u.Hostname() != "127.0.0.1" || u.Port() == "" || u.User != nil ||
+		u.Path != "/v1/mcp/credential" || u.RawPath != "" || u.RawQuery != "" || u.Fragment != "" ||
+		len(token) < 32 || len(token) > 256 || strings.IndexFunc(token, func(r rune) bool { return r < 33 || r > 126 }) >= 0 {
+		return nil, errors.New("invalid Native MCP credential bridge configuration")
+	}
+	client := &http.Client{Timeout: 30 * time.Second, Transport: &http.Transport{Proxy: nil},
+		CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
+	return func(ctx context.Context, target NativeCredentialTarget, previous string) (string, error) {
+		payload, err := json.Marshal(struct {
+			Protocol string                 `json:"protocol"`
+			Target   NativeCredentialTarget `json:"target"`
+			Previous string                 `json:"previousTokenHash,omitempty"`
+		}{NativeCredentialProtocol, target, previous})
+		if err != nil || len(payload) > 1024*1024 {
+			return "", errors.New(nativeAuthRequired)
+		}
+		req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(payload))
+		if err != nil {
+			return "", errors.New(nativeAuthRequired)
+		}
+		req.Header.Set("Authorization", "Bearer "+token)
+		req.Header.Set("Content-Type", "application/json")
+		resp, err := client.Do(req)
+		if err != nil {
+			if ctx.Err() != nil {
+				return "", ctx.Err()
+			}
+			return "", errors.New(nativeAuthRequired)
+		}
+		defer resp.Body.Close()
+		if resp.StatusCode != http.StatusOK {
+			return "", errors.New(nativeAuthRequired)
+		}
+		body, err := io.ReadAll(io.LimitReader(resp.Body, 1024*1024+1))
+		if err != nil || len(body) > 1024*1024 {
+			return "", errors.New(nativeAuthRequired)
+		}
+		var result struct {
+			Protocol    string `json:"protocol"`
+			AccessToken string `json:"accessToken"`
+		}
+		decoder := json.NewDecoder(bytes.NewReader(body))
+		decoder.DisallowUnknownFields()
+		if decoder.Decode(&result) != nil || decoder.Decode(new(any)) != io.EOF || result.Protocol != NativeCredentialProtocol || !validNativeBearer(result.AccessToken) {
+			return "", errors.New(nativeAuthRequired)
+		}
+		return result.AccessToken, nil
+	}, nil
+}
+
+func validNativeBearer(value string) bool {
+	return len(value) > 0 && len(value) <= 64*1024 && strings.IndexFunc(value, func(r rune) bool { return r < 33 || r > 126 }) < 0
+}
+
+type nativeCredentialTransport struct {
+	base     http.RoundTripper
+	endpoint string
+	resolve  func(context.Context, string) (string, error)
+}
+
+func (t *nativeCredentialTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	performed := false
+	defer func() {
+		if !performed && req.Body != nil {
+			_ = req.Body.Close()
+		}
+	}()
+	failure := func(message string) error {
+		if err := req.Context().Err(); err != nil {
+			return err
+		}
+		return errors.New(message)
+	}
+	configured, err := url.Parse(t.endpoint)
+	if err != nil || req.URL.User != nil || !sameCredentialOrigin(configured, req.URL) {
+		return nil, errors.New(nativeAuthRequired)
+	}
+	if err := req.Context().Err(); err != nil {
+		return nil, err
+	}
+	token, err := t.resolve(req.Context(), "")
+	if err != nil || !validNativeBearer(token) {
+		return nil, failure(nativeAuthRequired)
+	}
+	perform := func(request *http.Request, token string) (*http.Response, error) {
+		performed = true
+		copy := request.Clone(request.Context())
+		copy.Header.Set("Authorization", "Bearer "+token)
+		return t.base.RoundTrip(copy)
+	}
+	resp, err := perform(req, token)
+	if err != nil {
+		return nil, failure("MCP HTTP request failed")
+	}
+	secrets := []string{token}
+	if resp.StatusCode == http.StatusUnauthorized {
+		_, _ = io.Copy(io.Discard, io.LimitReader(resp.Body, 64*1024))
+		_ = resp.Body.Close()
+		if req.Body != nil && req.GetBody == nil {
+			return nil, errors.New(nativeAuthRequired)
+		}
+		digest := sha256.Sum256([]byte(token))
+		next, err := t.resolve(req.Context(), hex.EncodeToString(digest[:]))
+		if err != nil || !validNativeBearer(next) {
+			return nil, failure(nativeAuthRequired)
+		}
+		retry := req.Clone(req.Context())
+		if req.Body != nil {
+			retry.Body, err = req.GetBody()
+			if err != nil {
+				return nil, errors.New(nativeAuthRequired)
+			}
+		}
+		resp, err = perform(retry, next)
+		if err != nil {
+			return nil, failure("MCP HTTP request failed")
+		}
+		if resp.StatusCode == http.StatusUnauthorized {
+			_ = resp.Body.Close()
+			return nil, errors.New(nativeAuthRequired)
+		}
+		secrets = append(secrets, next)
+	}
+	// Reflecting servers cannot return a known bearer in status, headers, JSON or
+	// SSE chunks. The streaming reader retains only possible secret prefixes.
+	for _, secret := range secrets {
+		resp.Status = strings.ReplaceAll(resp.Status, secret, "[redacted]")
+		for key, values := range resp.Header {
+			for i, value := range values {
+				values[i] = strings.ReplaceAll(value, secret, "[redacted]")
+			}
+			resp.Header[key] = values
+		}
+	}
+	resp.Body = newCredentialRedactingBody(resp.Body, secrets)
+	resp.ContentLength = -1
+	resp.Header.Del("Content-Length")
+	return resp, nil
+}
+
+func sameCredentialOrigin(a, b *url.URL) bool {
+	port := func(u *url.URL) string {
+		if p := u.Port(); p != "" {
+			return p
+		}
+		if u.Scheme == "https" {
+			return "443"
+		}
+		return "80"
+	}
+	return strings.EqualFold(a.Scheme, b.Scheme) && strings.EqualFold(a.Hostname(), b.Hostname()) && port(a) == port(b)
+}
+
+type credentialPattern struct {
+	value   []byte
+	failure []int
+	matched int
+}
+type credentialRedactingBody struct {
+	body           io.ReadCloser
+	patterns       []credentialPattern
+	pending, ready []byte
+	terminal       error
+}
+
+func newCredentialRedactingBody(body io.ReadCloser, secrets []string) io.ReadCloser {
+	r := &credentialRedactingBody{body: body}
+	seen := map[string]bool{}
+	for _, secret := range secrets {
+		encoded, _ := json.Marshal(secret)
+		for _, value := range []string{secret, string(encoded[1 : len(encoded)-1])} {
+			if value == "" || seen[value] {
+				continue
+			}
+			seen[value] = true
+			p := credentialPattern{value: []byte(value), failure: make([]int, len(value))}
+			for i, j := 1, 0; i < len(value); i++ {
+				for j > 0 && value[i] != value[j] {
+					j = p.failure[j-1]
+				}
+				if value[i] == value[j] {
+					j++
+				}
+				p.failure[i] = j
+			}
+			r.patterns = append(r.patterns, p)
+		}
+	}
+	return r
+}
+
+func (r *credentialRedactingBody) Read(out []byte) (int, error) {
+	if len(out) == 0 {
+		return 0, nil
+	}
+	for len(r.ready) == 0 && r.terminal == nil {
+		var chunk [16 * 1024]byte
+		n, err := r.body.Read(chunk[:])
+		for _, b := range chunk[:n] {
+			r.pending = append(r.pending, b)
+			full, keep := 0, 0
+			for i := range r.patterns {
+				p := &r.patterns[i]
+				for p.matched > 0 && b != p.value[p.matched] {
+					p.matched = p.failure[p.matched-1]
+				}
+				if b == p.value[p.matched] {
+					p.matched++
+				}
+				if p.matched == len(p.value) {
+					if len(p.value) > full {
+						full = len(p.value)
+					}
+					p.matched = p.failure[p.matched-1]
+				}
+				if p.matched > keep {
+					keep = p.matched
+				}
+			}
+			if full > 0 {
+				r.ready = append(r.ready, r.pending[:len(r.pending)-full]...)
+				r.ready = append(r.ready, []byte("[redacted]")...)
+				r.pending = r.pending[:0]
+				for i := range r.patterns {
+					r.patterns[i].matched = 0
+				}
+			} else if safe := len(r.pending) - keep; safe > 0 {
+				r.ready = append(r.ready, r.pending[:safe]...)
+				r.pending = append(r.pending[:0], r.pending[safe:]...)
+			}
+		}
+		if err != nil {
+			r.ready = append(r.ready, r.pending...)
+			r.pending = nil
+			r.terminal = err
+		}
+		if n == 0 && err == nil {
+			return 0, nil
+		}
+	}
+	if len(r.ready) > 0 {
+		n := copy(out, r.ready)
+		r.ready = r.ready[n:]
+		return n, nil
+	}
+	return 0, r.terminal
+}
+func (r *credentialRedactingBody) Close() error { return r.body.Close() }
