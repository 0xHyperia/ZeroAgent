+func TestNativeCredentialsRedactionHandlesChunkBoundariesEscapingAndOverlaps(t *testing.T) {
+	for _, secret := range []string{"long-private-token", "overlap-ababa", `quoted-"-backslash-\-token`} {
+		encoded, _ := json.Marshal(secret)
+		body := "data: " + secret + "\njson: " + string(encoded) + "\ntail"
+		reader := newCredentialRedactingBody(oneByteReadCloser{strings.NewReader(body)}, []string{secret, secret})
+		result, err := io.ReadAll(reader)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(string(result), secret) || strings.Contains(string(result), string(encoded[1:len(encoded)-1])) || strings.Count(string(result), "[redacted]") != 2 || !strings.HasSuffix(string(result), "tail") {
+			t.Fatalf("redaction output=%q", result)
+		}
+	}
+}
