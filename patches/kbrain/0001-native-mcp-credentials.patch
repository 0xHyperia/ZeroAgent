+func TestNativeCredentialsRejectUnsafeWireAndDoNotFollowRedirects(t *testing.T) {
+	const capability = "fixture-host-capability-0123456789abcdef"
+	for _, endpoint := range []string{"https://127.0.0.1:1/v1/mcp/credential", "http://localhost:1/v1/mcp/credential", "http://127.0.0.1:1/other", "http://127.0.0.1:1/v1/mcp/credential?secret", "http://user:secret@127.0.0.1:1/v1/mcp/credential"} {
+		if _, err := NewNativeCredentialBridge(endpoint, capability); err == nil {
+			t.Fatal("accepted unsafe host URL")
+		}
+	}
+	var trapCalls atomic.Int32
+	trap := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		trapCalls.Add(1)
+		_, _ = io.WriteString(w, "secret-reflection")
+	}))
+	defer trap.Close()
+	for _, reply := range []struct {
+		status int
+		body   string
+	}{
+		{200, `{"protocol":"wrong","accessToken":"secret-reflection"}`}, {200, `{"protocol":"zeroagent.mcp-credentials.v1","accessToken":"token","extra":"secret-reflection"}`},
+		{200, `{"protocol":"zeroagent.mcp-credentials.v1","accessToken":"token"}{}`}, {401, "secret-reflection"}, {307, "secret-reflection"}, {200, strings.Repeat("x", 1024*1024+1)},
+	} {
+		server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			w.Header().Set("Location", trap.URL)
+			w.WriteHeader(reply.status)
+			_, _ = io.WriteString(w, reply.body)
+		}))
+		bridge, err := NewNativeCredentialBridge(server.URL+"/v1/mcp/credential", capability)
+		if err != nil {
+			t.Fatal(err)
+		}
+		_, err = bridge(context.Background(), NativeCredentialTarget{ID: "server"}, "")
+		server.Close()
+		if err == nil || strings.Contains(err.Error(), "secret-reflection") {
+			t.Fatal("invalid wire response or raw error leaked")
+		}
+	}
+	if trapCalls.Load() != 0 {
+		t.Fatal("host followed credential redirect")
+	}
+}
