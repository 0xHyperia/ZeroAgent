+type nativeCloseCounter struct {
+	io.Reader
+	closed atomic.Int32
+}
+
+func (r *nativeCloseCounter) Close() error { r.closed.Add(1); return nil }
+
+func TestNativeCredentialsCancellationDuringResolutionClosesBodyWithoutCallingUpstream(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	started := make(chan struct{})
+	finished := make(chan error, 1)
+	body := &nativeCloseCounter{Reader: strings.NewReader("private request")}
+	var called atomic.Int32
+	tr := &nativeCredentialTransport{endpoint: "https://mcp.invalid", base: nativeRoundTripFunc(func(*http.Request) (*http.Response, error) { called.Add(1); return nil, errors.New("unexpected") }),
+		resolve: func(ctx context.Context, _ string) (string, error) {
+			close(started)
+			<-ctx.Done()
+			return "", ctx.Err()
+		}}
+	req, _ := http.NewRequestWithContext(ctx, "POST", "https://mcp.invalid", body)
+	go func() { _, err := tr.RoundTrip(req); finished <- err }()
+	<-started
+	cancel()
+	if err := <-finished; !errors.Is(err, context.Canceled) {
+		t.Fatalf("cancellation lost: %v", err)
+	}
+	if called.Load() != 0 || body.closed.Load() != 1 {
+		t.Fatal("cancelled credential request leaked body or called upstream")
+	}
+}
+
+func (f nativeRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestNativeCredentialsRefreshIsBoundedAndNonReplayableRequestsAreNotRepeated(t *testing.T) {
+	for _, replayable := range []bool{false, true} {
+		calls, refresh := 0, 0
+		tr := &nativeCredentialTransport{endpoint: "https://mcp.invalid", base: nativeRoundTripFunc(func(*http.Request) (*http.Response, error) {
+			calls++
+			return &http.Response{StatusCode: 401, Body: io.NopCloser(strings.NewReader("secret-body")), Header: make(http.Header)}, nil
+		}), resolve: func(_ context.Context, previous string) (string, error) {
+			if previous != "" {
+				refresh++
+			}
+			return "bearer-value", nil
+		}}
+		req, _ := http.NewRequest("POST", "https://mcp.invalid", strings.NewReader("request"))
+		if !replayable {
+			req.GetBody = nil
+		}
+		_, err := tr.RoundTrip(req)
+		if err == nil || err.Error() != nativeAuthRequired || calls != map[bool]int{false: 1, true: 2}[replayable] || refresh != map[bool]int{false: 0, true: 1}[replayable] {
+			t.Fatalf("calls=%d refresh=%d err=%v", calls, refresh, err)
+		}
+	}
+	tr := &nativeCredentialTransport{endpoint: "https://mcp.invalid", resolve: func(context.Context, string) (string, error) { return "", errors.New("private-host-error") }}
+	req, _ := http.NewRequest("GET", "https://other.invalid", nil)
+	if _, err := tr.RoundTrip(req); err == nil || err.Error() != nativeAuthRequired {
+		t.Fatal("cross-origin request accepted")
+	}
+	req, _ = http.NewRequest("GET", "https://mcp.invalid", nil)
+	if _, err := tr.RoundTrip(req); err == nil || strings.Contains(err.Error(), "private-host-error") {
+		t.Fatal("host error leaked")
+	}
+}
