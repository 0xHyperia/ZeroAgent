+func TestNativeCredentialsRetryPreservesBodyAndRequestID(t *testing.T) {
+	var requests, refreshes int
+	const body = `{"jsonrpc":"2.0","id":42,"method":"tools/call"}`
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests++
+		raw, _ := io.ReadAll(r.Body)
+		if string(raw) != body {
+			t.Error("retry changed RPC body or ID")
+		}
+		if requests == 1 {
+			w.WriteHeader(401)
+			return
+		}
+		if r.Header.Get("Authorization") != "Bearer new-token" {
+			t.Error("missing rotated token")
+		}
+		_, _ = io.WriteString(w, "ok")
+	}))
+	defer server.Close()
+	transport := &nativeCredentialTransport{base: http.DefaultTransport, endpoint: server.URL, resolve: func(_ context.Context, previous string) (string, error) {
+		if previous != "" {
+			refreshes++
+			return "new-token", nil
+		}
+		return "old-token", nil
+	}}
+	request, _ := http.NewRequest("POST", server.URL, strings.NewReader(body))
+	request.Header.Set("X-Request", "stable")
+	response, err := (&http.Client{Transport: transport}).Do(request)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer response.Body.Close()
+	_, _ = io.Copy(io.Discard, response.Body)
+	if requests != 2 || refreshes != 1 || request.Header.Get("Authorization") != "" {
+		t.Fatalf("requests=%d refreshes=%d original request mutated", requests, refreshes)
+	}
+}
