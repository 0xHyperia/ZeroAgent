index 0000000000000000000000000000000000000000..c4e9777ea4c2e5afaa6bd4d41e13a51c37f9798b
--- /dev/null
+++ b/internal/mcp/control_transport_test.go
@@ -0,0 +1,98 @@
+package mcp
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	sdkmcp "github.com/modelcontextprotocol/go-sdk/mcp"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestLiveManagerSSECloseBoundsDetachedCancellation(t *testing.T) {
+	started, notification, expired := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	release := make(chan struct{})
+	var notifyOnce, expireOnce sync.Once
+	rpc := sdkmcp.NewServer(&sdkmcp.Implementation{Name: "sse-cleanup"}, nil)
+	sdkmcp.AddTool(rpc, &sdkmcp.Tool{Name: "block", InputSchema: map[string]any{"type": "object"}}, func(ctx context.Context, _ *sdkmcp.CallToolRequest, _ struct{}) (*sdkmcp.CallToolResult, any, error) {
+		close(started)
+		select {
+		case <-ctx.Done():
+			return nil, nil, ctx.Err()
+		case <-release:
+			return &sdkmcp.CallToolResult{}, nil, nil
+		}
+	})
+	handler := sdkmcp.NewSSEHandler(func(*http.Request) *sdkmcp.Server { return rpc }, nil)
+	remote := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == http.MethodPost {
+			raw, err := io.ReadAll(r.Body)
+			if err != nil {
+				return
+			}
+			r.Body = io.NopCloser(bytes.NewReader(raw))
+			var message struct {
+				Method string `json:"method"`
+			}
+			_ = json.Unmarshal(raw, &message)
+			if message.Method == "notifications/cancelled" {
+				notifyOnce.Do(func() { close(notification) })
+				select {
+				case <-r.Context().Done():
+					expireOnce.Do(func() { close(expired) })
+				case <-release:
+				}
+				return
+			}
+		}
+		handler.ServeHTTP(w, r)
+	}))
+	defer func() { close(release); remote.CloseClientConnections(); remote.Close() }()
+	live, err := NewLiveManager(t.Context(), filepath.Join(t.TempDir(), "mcp.json"), LiveSettings{Servers: []LiveServer{{ID: "sse", Enabled: true, Transport: "sse", URL: remote.URL}}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(live.Close)
+	waitLiveStatus(t, live, "sse", "ready")
+	result := make(chan error, 1)
+	available := live.ToolsFor(t.Context(), "", nil)
+	if len(available) != 1 {
+		t.Fatal("SSE tool did not become available")
+	}
+	go func() { _, err := available[0].Run(t.Context(), nil); result <- err }()
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("SSE call did not start")
+	}
+	stop := make(chan struct{})
+	go func() { live.Close(); close(stop) }()
+	select {
+	case <-notification:
+	case <-time.After(3 * time.Second):
+		t.Fatal("SDK cancellation was not sent")
+	}
+	select {
+	case <-stop:
+	case <-time.After(3 * time.Second):
+		t.Fatal("SSE close waited on an unbounded cancellation POST")
+	}
+	select {
+	case <-expired:
+	case <-time.After(time.Second):
+		t.Fatal("cleanup deadline did not cancel the HTTP exchange")
+	}
+	select {
+	case err := <-result:
+		if err == nil {
+			t.Fatal("canceled call succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("canceled call remained registered")
+	}
+}
