+//go:build !windows
+
+package mcp
+
+import (
+	"context"
+	"errors"
+	"os/exec"
+	"syscall"
+
+	"github.com/Stack-Cairn/K-brain/internal/process"
+)
+
+type unixStdioOwner struct{}
+
+func newStdioProcessOwner(*exec.Cmd) (stdioProcessOwner, error) { return unixStdioOwner{}, nil }
+func (unixStdioOwner) started(*exec.Cmd) error                  { return nil }
+func (unixStdioOwner) exited(cmd *exec.Cmd) (bool, error)       { return stdioExitedWithoutReaping(cmd) }
+func (unixStdioOwner) terminate(cmd *exec.Cmd) error {
+	err := process.Kill(cmd)
+	if errors.Is(err, syscall.ESRCH) {
+		return nil
+	}
+	return err
+}
+func (unixStdioOwner) release() error { return nil }
+func newStdioCommand(ctx context.Context, argv []string, cwd string) (*exec.Cmd, error) {
+	cmd := exec.CommandContext(context.WithoutCancel(ctx), expandStdioHome(argv[0]), argv[1:]...)
+	cmd.Dir = expandStdioHome(cwd)
+	return cmd, nil
+}
diff --git a/internal/mcp/owned_stdio_windows.go b/internal/mcp/owned_stdio_windows.go
new file mode 100644
index 0000000000000000000000000000000000000000..d3c0217537887dab1ea1f4082ad9be5ab1764484
--- /dev/null
+++ b/internal/mcp/owned_stdio_windows.go
@@ -0,0 +1,232 @@
+package mcp
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+type windowsStdioOwner struct {
+	mu  sync.Mutex
+	job windows.Handle
+}
+
+func newStdioProcessOwner(cmd *exec.Cmd) (stdioProcessOwner, error) {
+	job, err := windows.CreateJobObject(nil, nil)
+	if err != nil {
+		return nil, err
+	}
+	var info windows.JOBOBJECT_EXTENDED_LIMIT_INFORMATION
+	info.BasicLimitInformation.LimitFlags = windows.JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
+	if _, err = windows.SetInformationJobObject(job, windows.JobObjectExtendedLimitInformation, uintptr(unsafe.Pointer(&info)), uint32(unsafe.Sizeof(info))); err != nil {
+		_ = windows.CloseHandle(job)
+		return nil, err
+	}
+	if cmd.SysProcAttr == nil {
+		cmd.SysProcAttr = &syscall.SysProcAttr{}
+	}
+	cmd.SysProcAttr.CreationFlags |= windows.CREATE_SUSPENDED
+	return &windowsStdioOwner{job: job}, nil
+}
+func (o *windowsStdioOwner) started(cmd *exec.Cmd) error {
+	var assignment error
+	if err := cmd.Process.WithHandle(func(h uintptr) { assignment = windows.AssignProcessToJobObject(o.job, windows.Handle(h)) }); err != nil {
+		return err
+	}
+	if assignment != nil {
+		return assignment
+	}
+	return resumeStdioPrimaryThread(uint32(cmd.Process.Pid))
+}
+func (o *windowsStdioOwner) exited(cmd *exec.Cmd) (bool, error) {
+	var done bool
+	var queryErr error
+	err := cmd.Process.WithHandle(func(h uintptr) {
+		var state uint32
+		state, queryErr = windows.WaitForSingleObject(windows.Handle(h), 0)
+		done = state == windows.WAIT_OBJECT_0
+	})
+	return done, errors.Join(err, queryErr)
+}
+func (o *windowsStdioOwner) terminate(cmd *exec.Cmd) error {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	var jobErr error
+	if o.job != 0 {
+		jobErr = windows.TerminateJobObject(o.job, 1)
+	}
+	// Activation may fail before assignment. The root is still suspended and
+	// belongs to this exec.Cmd; terminate it explicitly in that case too.
+	rootErr := cmd.Process.Kill()
+	if errors.Is(rootErr, os.ErrProcessDone) {
+		rootErr = nil
+	}
+	if errors.Is(rootErr, windows.ERROR_ACCESS_DENIED) {
+		if exited, err := o.exited(cmd); exited && err == nil {
+			rootErr = nil
+		}
+	}
+	return errors.Join(jobErr, rootErr)
+}
+func (o *windowsStdioOwner) release() error {
+	o.mu.Lock()
+	defer o.mu.Unlock()
+	if o.job == 0 {
+		return nil
+	}
+	err := windows.CloseHandle(o.job)
+	o.job = 0
+	return err
+}
+
+var stdioGetThreadTimes = windows.NewLazySystemDLL("kernel32.dll").NewProc("GetThreadTimes")
+
+func resumeStdioPrimaryThread(pid uint32) error {
+	snapshot, err := windows.CreateToolhelp32Snapshot(windows.TH32CS_SNAPTHREAD, 0)
+	if err != nil {
+		return err
+	}
+	defer windows.CloseHandle(snapshot)
+	var entry windows.ThreadEntry32
+	entry.Size = uint32(unsafe.Sizeof(entry))
+	var primary windows.Handle
+	var oldest uint64
+	defer func() {
+		if primary != 0 {
+			_ = windows.CloseHandle(primary)
+		}
+	}()
+	for err = windows.Thread32First(snapshot, &entry); err == nil; err = windows.Thread32Next(snapshot, &entry) {
+		if entry.OwnerProcessID != pid {
+			continue
+		}
+		thread, openErr := windows.OpenThread(windows.THREAD_SUSPEND_RESUME|windows.THREAD_QUERY_LIMITED_INFORMATION, false, entry.ThreadID)
+		if openErr != nil {
+			return openErr
+		}
+		var created, exited, kernel, user windows.Filetime
+		ok, _, timeErr := stdioGetThreadTimes.Call(uintptr(thread), uintptr(unsafe.Pointer(&created)), uintptr(unsafe.Pointer(&exited)), uintptr(unsafe.Pointer(&kernel)), uintptr(unsafe.Pointer(&user)))
+		if ok == 0 {
+			_ = windows.CloseHandle(thread)
+			return timeErr
+		}
+		time := uint64(created.HighDateTime)<<32 | uint64(created.LowDateTime)
+		if primary == 0 || time < oldest {
+			if primary != 0 {
+				_ = windows.CloseHandle(primary)
+			}
+			primary, oldest = thread, time
+		} else {
+			_ = windows.CloseHandle(thread)
+		}
+	}
+	if !errors.Is(err, windows.ERROR_NO_MORE_FILES) {
+		return err
+	}
+	if primary == 0 {
+		return errors.New("MCP command primary thread was not found")
+	}
+	previous, err := windows.ResumeThread(primary)
+	if err != nil {
+		return err
+	}
+	if previous != 1 {
+		return errors.New("MCP command primary thread was not suspended exactly once")
+	}
+	return nil
+}
+
+func newStdioCommand(ctx context.Context, argv []string, cwd string) (*exec.Cmd, error) {
+	cwd = expandStdioHome(cwd)
+	program := expandStdioHome(argv[0])
+	if !filepath.IsAbs(program) && strings.ContainsAny(program, `/\`) {
+		if cwd != "" {
+			program = filepath.Join(cwd, program)
+		}
+	}
+	if cwd != "" && !filepath.IsAbs(program) && !strings.ContainsAny(program, `/\`) {
+		for _, extension := range []string{"", ".exe", ".com", ".cmd", ".bat"} {
+			candidate := filepath.Join(cwd, program+extension)
+			if info, err := os.Stat(candidate); err == nil && !info.IsDir() {
+				program = candidate
+				break
+			}
+		}
+	}
+	resolved, err := exec.LookPath(program)
+	if err != nil {
+		return nil, err
+	}
+	resolved, err = filepath.Abs(resolved)
+	if err != nil {
+		return nil, err
+	}
+	if strings.EqualFold(filepath.Ext(resolved), ".cmd") || strings.EqualFold(filepath.Ext(resolved), ".bat") {
+		absolute, err := filepath.Abs(resolved)
+		if err != nil {
+			return nil, err
+		}
+		shell := filepath.Join(os.Getenv("SystemRoot"), "System32", "cmd.exe")
+		cmd := exec.CommandContext(context.WithoutCancel(ctx), shell)
+		cmd.Dir = cwd
+		// The script path is parsed once; arguments are parsed both by cmd /C
+		// and by the script's %* forwarding line (e.g. npm/npx shims).
+		quoted := []string{quoteStdioBatchCommand(absolute)}
+		for _, value := range argv[1:] {
+			part, err := quoteStdioBatchArgument(value)
+			if err != nil {
+				return nil, err
+			}
+			quoted = append(quoted, part)
+		}
+		cmd.SysProcAttr = &syscall.SysProcAttr{CmdLine: syscall.EscapeArg(shell) + ` /E:ON /V:OFF /D /S /C "` + strings.Join(quoted, " ") + `"`}
+		return cmd, nil
+	}
+	cmd := exec.CommandContext(context.WithoutCancel(ctx), resolved, argv[1:]...)
+	cmd.Dir = cwd
+	return cmd, nil
+}
+func quoteStdioBatchArgument(value string) (string, error) {
+	if strings.ContainsAny(value, "\x00\r\n") {
+		return "", fmt.Errorf("MCP batch arguments cannot contain NUL, CR or LF")
+	}
+	var out strings.Builder
+	out.WriteByte('"')
+	slashes := 0
+	for _, char := range value {
+		if char == '\\' {
+			slashes++
+		} else {
+			if char == '"' {
+				out.WriteString(strings.Repeat(`\`, slashes+1))
+			}
+			slashes = 0
+		}
+		out.WriteRune(char)
+	}
+	out.WriteString(strings.Repeat(`\`, slashes))
+	out.WriteByte('"')
+	return escapeStdioBatchMeta(escapeStdioBatchMeta(out.String())), nil
+}
+
+func quoteStdioBatchCommand(value string) string { return escapeStdioBatchMeta(value) }
+
+func escapeStdioBatchMeta(value string) string {
+	var out strings.Builder
+	for _, char := range value {
+		if strings.ContainsRune("()[]%!^\"`<>&|;, \t*?", char) {
+			out.WriteByte('^')
+		}
+		out.WriteRune(char)
+	}
+	return out.String()
+}
diff --git a/internal/mcp/owned_stdio_windows_test.go b/internal/mcp/owned_stdio_windows_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a929e98d6cb7f9a1e95b9795cb115a4df1b92fcf
--- /dev/null
+++ b/internal/mcp/owned_stdio_windows_test.go
@@ -0,0 +1,114 @@
+package mcp
+
+import (
+	"encoding/binary"
+	"os"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+	"time"
+	"unicode/utf16"
+
+	"github.com/Stack-Cairn/K-brain/internal/process"
+	"golang.org/x/sys/windows"
+)
+
+func ownedTestProcessAlive(pid int) bool { return ownedProcessAliveByHandle(pid) }
+
+func TestNativeOwnedStdioWindowsBatchPreservesArgumentBoundaries(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "batch with spaces")
+	if err := os.Mkdir(dir, 0700); err != nil {
+		t.Fatal(err)
+	}
+	program := filepath.Join(dir, "wrapper.CmD")
+	// Echo exposes the command line after both real cmd parsing passes.
+	// Decode it with Windows' legacy argv API, which detects the same doubled
+	// quote problem as Go's parser, without starting the entire test suite again.
+	script := "@echo off\r\necho %*\r\n"
+	if err := os.WriteFile(program, []byte(script), 0600); err != nil {
+		t.Fatal(err)
+	}
+	args := []string{"", "a b", "tab\tvalue", `C:\trailing\`, `embedded"quote`, `slashes\\"quote`, "%PATH%", "!PATH!", "&|<>^()[];,`*?", "中文"}
+	command, err := newStdioCommand(t.Context(), append([]string{"wrapper.CmD"}, args...), dir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	process.Configure(command, false)
+	if command.SysProcAttr == nil || !command.SysProcAttr.HideWindow {
+		t.Fatal("MCP batch command did not hide its window")
+	}
+	// Unicode output avoids depending on the machine's OEM code page. /U only
+	// changes this built-in receiver's output, not the argument escaping.
+	command.SysProcAttr.CmdLine = strings.Replace(command.SysProcAttr.CmdLine, " /E:ON", " /U /E:ON", 1)
+	timeout := time.AfterFunc(5*time.Second, func() { _ = process.Kill(command) })
+	defer timeout.Stop()
+	output, err := command.CombinedOutput()
+	if err != nil {
+		t.Fatalf("batch failed: %v output=%x", err, output)
+	}
+	if len(output)%2 != 0 {
+		t.Fatal("receiver did not emit UTF-16")
+	}
+	units := make([]uint16, len(output)/2)
+	for i := range units {
+		units[i] = binary.LittleEndian.Uint16(output[2*i:])
+	}
+	raw := strings.TrimSuffix(string(utf16.Decode(units)), "\r\n")
+	received := ownedDecodeWindowsArgv(t, "fixture "+raw)[1:]
+	if !reflect.DeepEqual(received, args) {
+		t.Fatalf("batch argv=%q want=%q raw=%q", received, args, raw)
+	}
+	if reflect.DeepEqual(ownedDecodeWindowsArgv(t, `fixture "embedded""quote" "next"`)[1:], []string{`embedded"quote`, "next"}) {
+		t.Fatal("receiver did not detect the original doubled-quote incompatibility")
+	}
+}
+
+func ownedDecodeWindowsArgv(t *testing.T, line string) []string {
+	t.Helper()
+	out, err := windows.DecomposeCommandLine(line)
+	if err != nil || len(out) == 0 {
+		t.Fatalf("native argv decoder: %v", err)
+	}
+	return out
+}
+
+func TestNativeOwnedStdioWindowsBatchRejectsUnrepresentableArguments(t *testing.T) {
+	for _, value := range []string{"line\nfeed", "carriage\rreturn", "nul\x00byte"} {
+		if _, err := quoteStdioBatchArgument(value); err == nil {
+			t.Fatal("unrepresentable batch argument accepted")
+		}
+	}
+}
+
+func TestNativeOwnedStdioWindowsBatchShutdownReapsDescendants(t *testing.T) {
+	cfg, file := ownedFixtureConfig(t, "orphan")
+	dir := filepath.Join(t.TempDir(), "batch tree with spaces")
