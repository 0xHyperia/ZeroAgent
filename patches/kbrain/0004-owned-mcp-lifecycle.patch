+
+// Caller holds s.mu. A new session receives a distinct context, so enabling or
+// reconnecting cannot revive work abandoned by an older generation.
+func (s *server) cancelCallsLocked() *sync.WaitGroup {
+	workers := s.callWorkers
+	if s.callCancel != nil {
+		s.callCancel()
+	}
+	s.callCancel, s.callCtx = nil, nil
+	s.callWorkers = nil
+	return workers
+}
+
+func waitCalls(workers *sync.WaitGroup) {
+	if workers != nil {
+		workers.Wait()
+	}
+}
