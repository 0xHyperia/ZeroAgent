new file mode 100644
index 0000000000000000000000000000000000000000..83857498f21744b387db8af4fd9e3f6e28b2e1eb
--- /dev/null
+++ b/internal/mcp/control_transport.go
@@ -0,0 +1,37 @@
+package mcp
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"time"
+)
+
+// The SDK gives cancellation notifications a detached context and gracefully
+// closes sessions only after retiring outgoing calls. Bound cleanup exchanges
+// independently of the unchanged startup/tool budgets.
+type boundedMCPControlTransport struct{ base http.RoundTripper }
+
+func (t *boundedMCPControlTransport) RoundTrip(req *http.Request) (*http.Response, error) {
+	control := req.Method == http.MethodDelete
+	if req.Method == http.MethodPost && req.GetBody != nil {
+		body, err := req.GetBody()
+		if err == nil {
+			raw, readErr := io.ReadAll(io.LimitReader(body, 4097))
+			_ = body.Close()
+			if readErr == nil && len(raw) <= 4096 {
+				var message struct {
+					Method string `json:"method"`
+				}
+				control = json.Unmarshal(raw, &message) == nil && message.Method == "notifications/cancelled"
+			}
+		}
+	}
+	if !control {
+		return t.base.RoundTrip(req)
+	}
+	ctx, cancel := context.WithTimeout(req.Context(), time.Second)
+	defer cancel()
+	return t.base.RoundTrip(req.Clone(ctx))
+}
