+package mcp
+
+import (
+	"fmt"
+	"os"
+	"strings"
+)
+
+func ownedTestProcessAlive(pid int) bool {
+	data, err := os.ReadFile(fmt.Sprintf("/proc/%d/stat", pid))
+	if err != nil {
+		return false
+	}
+	at := strings.LastIndexByte(string(data), ')')
+	return at >= 0 && len(data) > at+2 && data[at+2] != 'Z' && data[at+2] != 'X'
+}
