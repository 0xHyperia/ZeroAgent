index 0000000000000000000000000000000000000000..b2f8905302a9b9693a845e01db616dbef134c27c
--- /dev/null
+++ b/internal/mcp/client_identity_test.go
@@ -0,0 +1,146 @@
+package mcp
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/Stack-Cairn/K-brain/internal/tools"
+	"github.com/modelcontextprotocol/go-sdk/jsonrpc"
+	sdkmcp "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func TestMCPZeroAgentClientIdentityOnWire(t *testing.T) {
+	for _, mode := range []string{"modern-http", "legacy-http", "legacy-sse"} {
+		for _, operation := range []string{"runtime", "probe"} {
+			t.Run(mode+"/"+operation, func(t *testing.T) {
+				rpc := sdkmcp.NewServer(&sdkmcp.Implementation{Name: "identity-fixture"}, nil)
+				sdkmcp.AddTool(rpc, &sdkmcp.Tool{Name: "echo"}, func(_ context.Context, _ *sdkmcp.CallToolRequest, input struct {
+					Value string `json:"value"`
+				}) (*sdkmcp.CallToolResult, any, error) {
+					return &sdkmcp.CallToolResult{Content: []sdkmcp.Content{&sdkmcp.TextContent{Text: input.Value}}}, nil, nil
+				})
+				if mode != "modern-http" {
+					rpc.AddReceivingMiddleware(func(next sdkmcp.MethodHandler) sdkmcp.MethodHandler {
+						return func(ctx context.Context, method string, request sdkmcp.Request) (sdkmcp.Result, error) {
+							if method == "server/discover" {
+								return nil, &jsonrpc.Error{Code: -32601, Message: "legacy fixture"}
+							}
+							return next(ctx, method, request)
+						}
+					})
+				}
+				var delegate http.Handler = sdkmcp.NewStreamableHTTPHandler(func(*http.Request) *sdkmcp.Server { return rpc }, &sdkmcp.StreamableHTTPOptions{Stateless: mode == "modern-http"})
+				if mode == "legacy-sse" {
+					delegate = sdkmcp.NewSSEHandler(func(*http.Request) *sdkmcp.Server { return rpc }, nil)
+				}
+				type observation struct {
+					Method string
+					Info   *sdkmcp.Implementation
+				}
+				var mu sync.Mutex
+				var observed []observation
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					if r.Method == http.MethodPost {
+						raw, err := io.ReadAll(r.Body)
+						if err != nil {
+							t.Errorf("read actual request: %v", err)
+							w.WriteHeader(400)
+							return
+						}
+						r.Body = io.NopCloser(bytes.NewReader(raw))
+						var request struct {
+							Method string `json:"method"`
+							Params struct {
+								ClientInfo *sdkmcp.Implementation     `json:"clientInfo"`
+								Meta       map[string]json.RawMessage `json:"_meta"`
+							} `json:"params"`
+						}
+						if err := json.Unmarshal(raw, &request); err != nil {
+							t.Errorf("decode actual request: %v", err)
+							w.WriteHeader(400)
+							return
+						}
+						if request.Method == "server/discover" || request.Method == "initialize" || request.Method == "tools/list" || request.Method == "tools/call" {
+							info := request.Params.ClientInfo
+							if wire := request.Params.Meta[sdkmcp.MetaKeyClientInfo]; len(wire) != 0 {
+								if err := json.Unmarshal(wire, &info); err != nil {
+									t.Errorf("decode wire clientInfo: %v", err)
+								}
+							}
+							mu.Lock()
+							observed = append(observed, observation{request.Method, info})
+							mu.Unlock()
+						}
+					}
+					delegate.ServeHTTP(w, r)
+				}))
+				t.Cleanup(func() { server.CloseClientConnections(); server.Close() })
+				ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
+				defer cancel()
+				cfg := ServerConfig{URL: server.URL, StartupTimeout: 5}
+				if mode == "legacy-sse" {
+					cfg.URL += "/sse"
+					cfg.remoteTransport = "sse"
+				}
+				if operation == "probe" {
+					result := Probe(ctx, "identity", cfg)
+					if result.Status != StatusReady || len(result.ToolNames) != 1 {
+						t.Fatalf("probe=%+v", result)
+					}
+				} else {
+					manager := NewManager(map[string]ServerConfig{"identity": cfg})
+					t.Cleanup(manager.Close)
+					manager.Start(ctx)
+					select {
+					case <-manager.servers["identity"].ready:
+					case <-ctx.Done():
+						t.Fatal(ctx.Err())
+					}
+					if status := manager.Statuses()[0]; status.Status != StatusReady {
+						t.Fatalf("runtime=%+v", status)
+					}
+					result := tools.Execute(ctx, manager.Tools(), "mcp__identity__echo", json.RawMessage("{\"value\":\"identity-ok\"}"))
+					if result != "identity-ok" {
+						t.Fatalf("tool result=%q", result)
+					}
+				}
+				mu.Lock()
+				snapshot := append([]observation(nil), observed...)
+				mu.Unlock()
+				seen := map[string]bool{}
+				for _, item := range snapshot {
+					seen[item.Method] = true
+					if item.Info == nil {
+						if item.Method == "initialize" || mode == "modern-http" {
+							t.Errorf("%s omitted wire clientInfo", item.Method)
+						}
+						continue
+					}
+					if item.Info.Name != "ZeroAgent" || item.Info.Title != "ZeroAgent" {
+						t.Errorf("%s wire identity=%+v", item.Method, item.Info)
+					}
+				}
+				if !seen["tools/list"] {
+					t.Fatal("no actual tools/list request")
+				}
+				if operation == "runtime" && !seen["tools/call"] {
+					t.Fatal("no actual tool execution")
+				}
+				if mode == "modern-http" {
+					if !seen["server/discover"] || seen["initialize"] {
+						t.Fatalf("modern fixture did not exercise modern negotiation: %v", seen)
+					}
+				} else if !seen["initialize"] {
+					t.Fatal("legacy fixture did not exercise initialize")
+				}
+			})
+		}
+	}
+}
