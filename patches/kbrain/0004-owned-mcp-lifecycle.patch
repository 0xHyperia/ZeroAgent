--- /dev/null
+++ b/internal/mcp/owned_stdio_darwin.go
@@ -0,0 +1,18 @@
+package mcp
+
+import (
+	"golang.org/x/sys/unix"
+	"os/exec"
+)
+
+// SZOMB in the supported Darwin process state ABI. Sysctl observes the root
+// without reaping it, so its process-group identity remains reserved.
+const stdioDarwinZombie = 5
+
+func stdioExitedWithoutReaping(cmd *exec.Cmd) (bool, error) {
+	info, err := unix.SysctlKinfoProc("kern.proc.pid", cmd.Process.Pid)
+	if err != nil {
+		return false, err
+	}
+	return info.Proc.P_stat == stdioDarwinZombie, nil
+}
