diff --git a/internal/mcp/owned_stdio.go b/internal/mcp/owned_stdio.go
new file mode 100644
index 0000000000000000000000000000000000000000..9de89c3f50a32bf10711a9b765b0d1787c0b3eab
--- /dev/null
+++ b/internal/mcp/owned_stdio.go
@@ -0,0 +1,184 @@
+package mcp
+
+import (
+	"context"
+	"errors"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/modelcontextprotocol/go-sdk/jsonrpc"
+	sdkmcp "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+// Process ownership is separate from SDK protocol/session handling. In
+// particular, abort can close a blocked pipe before ClientSession.Close waits
+// for outgoing calls, and descendants cannot retain the session's handles.
+type stdioProcessOwner interface {
+	started(*exec.Cmd) error
+	exited(*exec.Cmd) (bool, error)
+	terminate(*exec.Cmd) error
+	release() error
+}
+
+type ownedStdioTransport struct {
+	command    *exec.Cmd
+	connection atomic.Pointer[ownedStdioConnection]
+}
+type ownedStdioConnection struct {
+	sdkmcp.Connection
+	command                         *exec.Cmd
+	owner                           stdioProcessOwner
+	input                           *os.File
+	output                          *os.File
+	inputOnce, abortOnce, closeOnce sync.Once
+	aborted                         chan struct{}
+	abortErr, closeErr              error
+}
+
+func (t *ownedStdioTransport) Connect(ctx context.Context) (sdkmcp.Connection, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	owner, err := newStdioProcessOwner(t.command)
+	if err != nil {
+		return nil, err
+	}
+	stdout, err := t.command.StdoutPipe()
+	if err != nil {
+		_ = owner.release()
+		return nil, err
+	}
+	stdin, err := t.command.StdinPipe()
+	if err != nil {
+		_ = stdout.Close()
+		_ = owner.release()
+		return nil, err
+	}
+	// StdoutPipe/StdinPipe are OS pipes for exec.Cmd. Retain their actual closers,
+	// rather than the SDK CommandTransport's deliberately non-closing stdout.
+	input, inputOK := stdin.(*os.File)
+	output, outputOK := stdout.(*os.File)
+	if !inputOK || !outputOK {
+		_ = stdin.Close()
+		_ = stdout.Close()
+		_ = owner.release()
+		return nil, errors.New("MCP command did not create owned OS pipes")
+	}
+	t.command.WaitDelay = 3 * time.Second
+	if err := t.command.Start(); err != nil {
+		_ = stdin.Close()
+		_ = stdout.Close()
+		_ = owner.release()
+		return nil, err
+	}
+	wire, wireErr := (&sdkmcp.IOTransport{Reader: output, Writer: input}).Connect(ctx)
+	if wireErr != nil {
+		_ = owner.terminate(t.command)
+		_ = stdin.Close()
+		_ = stdout.Close()
+		_ = t.command.Wait()
+		_ = owner.release()
+		return nil, wireErr
+	}
+	connection := &ownedStdioConnection{Connection: wire, command: t.command, owner: owner, input: input, output: output, aborted: make(chan struct{})}
+	t.connection.Store(connection)
+	if err := owner.started(t.command); err != nil {
+		connection.abort()
+		_ = connection.Close()
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		connection.abort()
+		_ = connection.Close()
+		return nil, err
+	}
+	return connection, nil
+}
+
+func (c *ownedStdioConnection) closeInput() { c.inputOnce.Do(func() { _ = c.input.Close() }) }
+func (c *ownedStdioConnection) abort() {
+	c.abortOnce.Do(func() {
+		// Terminate first: closing a pipe with a blocked OS write must not prevent
+		// the process tree from losing its read handle.
+		c.abortErr = c.owner.terminate(c.command)
+		c.closeInput()
+		_ = c.output.Close()
+		close(c.aborted)
+	})
+}
+func (c *ownedStdioConnection) Read(ctx context.Context) (jsonrpc.Message, error) {
+	message, err := c.Connection.Read(ctx)
+	if err != nil {
+		c.abort()
+	}
+	return message, err
+}
+func (c *ownedStdioConnection) Write(ctx context.Context, message jsonrpc.Message) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if request, ok := message.(*jsonrpc.Request); ok && request.Method == "notifications/cancelled" {
+		var cancel context.CancelFunc
+		ctx, cancel = context.WithTimeout(ctx, time.Second)
+		defer cancel()
+	}
+	stop := context.AfterFunc(ctx, c.abort)
+	defer stop()
+	err := c.Connection.Write(ctx, message)
+	if ctx.Err() != nil {
+		return ctx.Err()
+	}
+	if err != nil {
+		c.abort()
+	}
+	return err
+}
+func (c *ownedStdioConnection) Close() error {
+	c.closeOnce.Do(func() {
+		go c.closeInput()
+		// Keep the root unreaped until its tree has been terminated. This retains
+		// the original process identity while a graceful EOF shutdown is pending.
+		grace := time.NewTimer(3 * time.Second)
+		defer grace.Stop()
+		tick := time.NewTicker(10 * time.Millisecond)
+		defer tick.Stop()
+	wait:
+		for {
+			select {
+			case <-c.aborted:
+				break wait
+			case <-grace.C:
+				break wait
+			case <-tick.C:
+				exited, err := c.owner.exited(c.command)
+				if exited || err != nil {
+					break wait
+				}
+			}
+		}
+		c.abort()
+		waitErr := c.command.Wait()
+		_ = c.Connection.Close()
+		c.closeErr = errors.Join(c.abortErr, waitErr, c.owner.release())
+	})
+	return c.closeErr
+}
+
+func expandStdioHome(value string) string {
+	if value == "~" {
+		if home, err := os.UserHomeDir(); err == nil {
+			return home
+		}
+	}
+	if strings.HasPrefix(value, "~/") || strings.HasPrefix(value, `~\`) {
+		if home, err := os.UserHomeDir(); err == nil {
+			return filepath.Join(home, value[2:])
+		}
+	}
+	return value
+}
diff --git a/internal/mcp/owned_stdio_darwin.go b/internal/mcp/owned_stdio_darwin.go
