+				chunk := make([]byte, 64)
+				for !bytes.Contains(prefix, bytes.Repeat([]byte{'x'}, 64)) && len(prefix) < 4096 {
+					if _, err := io.ReadFull(reader, chunk); err != nil {
+						os.Exit(8)
+					}
+					prefix = append(prefix, chunk...)
+				}
+				if !bytes.Contains(prefix, bytes.Repeat([]byte{'x'}, 64)) {
+					fmt.Fprintf(os.Stderr, "unexpected call prefix: %.256q", prefix)
+					os.Exit(9)
+				}
+				announce("blocked")
+				for {
+					time.Sleep(time.Hour)
+				}
+			}
+		}
+	default:
+		os.Exit(7)
+	}
+}
+
+func ownedFixtureConfig(t *testing.T, mode string) (ServerConfig, string) {
+	t.Helper()
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	file := filepath.Join(t.TempDir(), "pids.json")
+	return ServerConfig{Command: []string{executable, "-test.run=^TestNativeOwnedStdioProcessFixture$", "--", mode}, Env: map[string]string{ownedFixtureFlag: "1", "ZEROAGENT_MCP_PIDFILE": file}}, file
+}
+func waitOwnedFixture(t *testing.T, file string) ownedFixturePIDs {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		if data, err := os.ReadFile(file); err == nil {
+			var pids ownedFixturePIDs
+			if json.Unmarshal(data, &pids) == nil && pids.Root > 0 && pids.Child > 0 {
+				return pids
+			}
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("owned fixture did not publish its process identities")
+	return ownedFixturePIDs{}
+}
+func assertOwnedFixtureExited(t *testing.T, pids ownedFixturePIDs) {
+	t.Helper()
+	deadline := time.Now().Add(2 * time.Second)
+	for time.Now().Before(deadline) {
+		if !ownedTestProcessAlive(pids.Root) && !ownedTestProcessAlive(pids.Child) {
+			return
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatalf("owned process tree remained alive: root=%d child=%d", pids.Root, pids.Child)
+}
+
+func TestNativeOwnedStdioBlockedWriteCancellationReapsTree(t *testing.T) {
+	cfg, file := ownedFixtureConfig(t, "blocked")
+	transport, err := defaultTransport(t.Context(), cfg, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire, err := transport.Connect(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	connection := wire.(*ownedStdioConnection)
+	defer connection.Close()
+	defer connection.abort()
+	pids := waitOwnedFixture(t, file)
+	ctx, cancel := context.WithCancel(t.Context())
+	defer cancel()
+	id, _ := jsonrpc.MakeID(float64(1))
+	raw, _ := json.Marshal(map[string]string{"payload": strings.Repeat("x", 1<<20)})
+	done := make(chan error, 1)
+	go func() { done <- wire.Write(ctx, &jsonrpc.Request{ID: id, Method: "tools/call", Params: raw}) }()
+	select {
+	case err := <-done:
+		t.Fatalf("fixture did not block its input: %v", err)
+	case <-time.After(50 * time.Millisecond):
+	}
+	cancel()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("canceled blocked write succeeded")
+		}
+	case <-time.After(2 * time.Second):
+		t.Fatal("blocked stdin write ignored cancellation")
+	}
+	_ = connection.Close()
+	assertOwnedFixtureExited(t, pids)
+}
+
+func TestNativeOwnedStdioEOFReapsRootAndOrphanedPipeHolders(t *testing.T) {
+	cfg, file := ownedFixtureConfig(t, "orphan")
+	transport, err := defaultTransport(t.Context(), cfg, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	wire, err := transport.Connect(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+	connection := wire.(*ownedStdioConnection)
+	defer connection.abort()
+	defer connection.Close()
+	pids := waitOwnedFixture(t, file)
+	done := make(chan error, 1)
+	go func() { done <- connection.Close() }()
+	select {
+	case <-done:
+	case <-time.After(4 * time.Second):
+		connection.abort()
+		t.Fatal("EOF shutdown waited on inherited pipes")
+	}
+	assertOwnedFixtureExited(t, pids)
+}
+
+func TestNativeOwnedStdioManagerStopInterruptsBlockedCall(t *testing.T) {
+	cfg, _ := ownedFixtureConfig(t, "mcp-blocked")
+	manager := NewManager(map[string]ServerConfig{"owned": cfg})
+	var mu sync.Mutex
+	var current *ownedStdioTransport
+	signals := &ownedFixtureSignals{ready: make(chan ownedFixturePIDs, 1), writing: make(chan struct{})}
+	manager.connectTransport = func(ctx context.Context, cfg ServerConfig, stderr *ringBuffer) (sdkmcp.Transport, error) {
+		transport, err := defaultTransport(ctx, cfg, stderr)
+		if owned, ok := transport.(*ownedStdioTransport); ok {
+			mu.Lock()
+			current = owned
+			mu.Unlock()
+		}
+		if err != nil {
+			return nil, err
+		}
+		return &ownedObservedTransport{Transport: transport, signals: signals}, nil
+	}
+	t.Cleanup(func() {
+		mu.Lock()
+		owned := current
+		mu.Unlock()
+		if owned != nil {
+			if connection := owned.connection.Load(); connection != nil {
+				connection.abort()
+			}
+		}
+		manager.Close()
+	})
+	manager.Start(t.Context())
+	var pids ownedFixturePIDs
+	select {
+	case pids = <-signals.ready:
+	case <-time.After(5 * time.Second):
+		t.Fatal("stdio fixture did not announce readiness")
+	}
+	if pids.Root <= 0 || pids.Child <= 0 {
+		t.Fatal("fixture did not provide owned process identities")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for len(manager.Tools()) == 0 && time.Now().Before(deadline) {
+		time.Sleep(5 * time.Millisecond)
+	}
+	tools := manager.Tools()
+	if len(tools) != 1 {
+		t.Fatal("stdio tool did not become ready")
+	}
+	raw, _ := json.Marshal(map[string]string{"payload": strings.Repeat("x", 1<<20)})
+	result := make(chan error, 1)
+	go func() { _, err := tools[0].Run(t.Context(), raw); result <- err }()
+	// Confirm the peer actually received the start of a call larger than its
+	// pipe buffer. A sleep could cancel before the client entered Write at all,
+	// exercising a three-second graceful close instead of blocked-write abort.
+	select {
+	case <-signals.writing:
+	case err := <-result:
+		t.Fatalf("fixture did not block tool write: %v", err)
+	case <-time.After(2 * time.Second):
+		t.Fatalf("fixture did not receive payload prefix: %+v", manager.Statuses())
+	}
+	stopped := make(chan struct{})
+	go func() { manager.Disable("owned"); close(stopped) }()
+	select {
+	case <-stopped:
+	case <-time.After(3 * time.Second):
+		t.Fatal("manager stop waited on a blocked stdio call")
+	}
+	select {
+	case err := <-result:
+		if err == nil {
+			t.Fatal("abandoned stdio call succeeded")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("stdio call remained registered")
+	}
+	assertOwnedFixtureExited(t, pids)
+}
+
+type ownedObservedTransport struct {
+	sdkmcp.Transport
+	signals *ownedFixtureSignals
+}
+
+type ownedFixtureSignals struct {
+	ready                  chan ownedFixturePIDs
+	writing                chan struct{}
+	readyOnce, writingOnce sync.Once
+}
+
+func (t *ownedObservedTransport) Connect(ctx context.Context) (sdkmcp.Connection, error) {
+	connection, err := t.Transport.Connect(ctx)
+	if err != nil {
+		return nil, err
+	}
+	return &ownedObservedConnection{Connection: connection, signals: t.signals}, nil
+}
+
+type ownedObservedConnection struct {
+	sdkmcp.Connection
+	signals *ownedFixtureSignals
+}
+
+func (c *ownedObservedConnection) Read(ctx context.Context) (jsonrpc.Message, error) {
+	for {
+		message, err := c.Connection.Read(ctx)
+		if err != nil {
+			return message, err
+		}
+		if request, ok := message.(*jsonrpc.Request); ok && request.Method == "notifications/message" {
+			var params struct {
+				Data struct {
+					Fixture, State string
+					Root, Child    int
+				}
+			}
+			if json.Unmarshal(request.Params, &params) == nil && params.Data.Fixture == "owned-stdio" {
+				switch params.Data.State {
+				case "ready":
+					c.signals.readyOnce.Do(func() { c.signals.ready <- ownedFixturePIDs{Root: params.Data.Root, Child: params.Data.Child} })
+				case "blocked":
+					c.signals.writingOnce.Do(func() { close(c.signals.writing) })
+				}
+				continue
+			}
+		}
+		return message, nil
+	}
+}
+
+// Used by platform tests too: only inspect identities, never kill a PID obtained
+// from the OS inventory. All cleanup goes through the owned connection/job.
+func ownedProcessAliveByHandle(pid int) bool {
+	p, err := os.FindProcess(pid)
+	if err != nil {
+		return false
+	}
+	defer p.Release()
+	return process.Alive(&exec.Cmd{Process: p})
+}
