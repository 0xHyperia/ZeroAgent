+// ValidProfileWebSearchURL keeps private credentials out of the public settings projection.
+func ValidProfileWebSearchURL(raw string) bool {
+	u, err := url.Parse(raw)
+	return err == nil && validWebSearchURL(raw) && u.User == nil && u.RawQuery == "" && !u.ForceQuery && u.Fragment == ""
+}
