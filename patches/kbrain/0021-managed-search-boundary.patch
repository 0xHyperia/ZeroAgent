+
+func TestManagedWebSearchUsesSavedService(t *testing.T) {
+	clearWebSearchEnvBackend(t)
+	t.Setenv("ZEROAGENT_WEB_SEARCH_PROFILE_ONLY", "1")
+	t.Setenv(config.EnvWebSearchProvider, "tavily")
+	t.Setenv(config.EnvWebSearchAPIKey, "unused-environment-key")
+	fx := newWebSearchSettingsServer(t, &config.Config{})
+	a := agent.New(nil, "model", 100, "system")
+	a.NativeWebSearch = true
+	fx.server.attachWebSearch(a)
+	if _, ok := a.WebSearchFallbackTool(); ok {
+		t.Fatal("inherited search settings must not enable the tool")
+	}
+	requests := make(chan *http.Request, 1)
+	search := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		requests <- r.Clone(r.Context())
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(`{"results":[{"title":"Fixture search result","url":"https://example.org/result"}]}`))
+	}))
+	defer search.Close()
+	code, body, view := fx.do(t, http.MethodPut, `{"webSearch":{"provider":"searxng","baseUrl":"`+search.URL+`","apiKey":"`+fixtureWebSearchKey+`"}}`)
+	if code != http.StatusOK || view.Provider != "searxng" || !view.Available || view.APIKeySource != "config" || strings.Contains(body, fixtureWebSearchKey) {
+		t.Fatalf("search settings did not round-trip through the public projection: %d %s", code, body)
+	}
+	tool, ok := a.WebSearchFallbackTool()
+	if !ok {
+		t.Fatal("saved service did not enable the tool")
+	}
+	result, err := tool.Run(context.Background(), json.RawMessage(`{"query":"offline fixture"}`))
+	if err != nil || !strings.Contains(result, "Fixture search result") || strings.Contains(result, fixtureWebSearchKey) {
+		t.Fatalf("unexpected search result: %q, %v", result, err)
+	}
+	select {
+	case req := <-requests:
+		if req.URL.Path != "/search" || req.URL.Query().Get("q") != "offline fixture" || req.Header.Get("Authorization") != "Bearer "+fixtureWebSearchKey {
+			t.Fatal("search did not use the saved endpoint and key")
+		}
+	default:
+		t.Fatal("configured service received no request")
+	}
+	code, body, view = fx.do(t, http.MethodPut, `{"webSearch":{"provider":"brave","baseUrl":""}}`)
+	if code != http.StatusOK || view.Available || view.APIKeyConfigured || fx.saved.WebSearch.APIKey != "" {
+		t.Fatalf("changing services did not clear the previous key: %d %s", code, body)
+	}
+}
