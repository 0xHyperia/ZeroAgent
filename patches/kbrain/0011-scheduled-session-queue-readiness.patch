 	"github.com/Stack-Cairn/K-brain/internal/session"
 )
 
+// Report the same busy predicate used to admit a prompt, without loading a
+// model or exposing run content. Scheduled prompts use this session runtime.
+func (s *Server) sessionRunActivity(w http.ResponseWriter, id string) {
+	rt, err := s.historyRuntime(id)
+	if err != nil {
+		mutationError(w, err)
+		return
+	}
+	defer s.releaseRuntime(rt)
+	rt.mu.Lock()
+	defer rt.mu.Unlock()
+	if rt.deleted {
+		mutationError(w, session.ErrNotFound)
+		return
+	}
+	if rt.runtimeErr != nil {
+		writeJSONError(w, http.StatusInternalServerError, "session runtime is quarantined")
+		return
+	}
+	writeJSON(w, http.StatusOK, struct {
+		Busy bool `json:"busy"`
+	}{Busy: rt.activeLocked()})
+}
