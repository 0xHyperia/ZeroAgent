+++ b/internal/backend/trajectory_concurrent_sections_test.go
@@ -0,0 +1,58 @@
+package backend
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestTrajectorySectionConcurrentDeduplication(t *testing.T) {
+	root := t.TempDir()
+	rt := &runtimeSession{id: "parallel-review", eventDir: root}
+	server := &Server{eventDir: root}
+	for round := 0; round < 12; round++ {
+		content := strings.Repeat(string(rune('a'+round)), 32*1024)
+		id := sectionDigest(content)
+		gate := make(chan struct{})
+		errors := make(chan error, 48)
+		var workers sync.WaitGroup
+		for i := 0; i < 48; i++ {
+			workers.Add(1)
+			go func() {
+				defer workers.Done()
+				<-gate
+				got, err := rt.storeTrajectorySection("base", content)
+				if err != nil {
+					errors <- err
+					return
+				}
+				if got != id {
+					t.Errorf("section identity changed: %s", got)
+					return
+				}
+				// A UI/observer can read the published immutable section while
+				// another reviewer is still attempting to publish the same bytes.
+				file, err := os.Open(filepath.Join(root, "sections", rt.id, id+".json"))
+				if err != nil {
+					errors <- err
+					return
+				}
+				time.Sleep(time.Millisecond)
+				file.Close()
+			}()
+		}
+		close(gate)
+		workers.Wait()
+		close(errors)
+		for err := range errors {
+			t.Error(err)
+		}
+		section, err := server.readTrajectorySection(rt.id, id)
+		if err != nil || section.Content != content {
+			t.Fatalf("stored section changed: %v", err)
+		}
+	}
+}
