+package mcp
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	sdkmcp "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func TestNativeCredentialsLegacySSERefreshesOnPOSTAndKeepsHistoryAcrossReload(t *testing.T) {
+	const old, fresh = "sse-opaque-prefix", "sse-opaque-prefix-rotated"
+	var refreshed, revoked atomic.Bool
+	var grants, gets, rejected, calls, activeGets atomic.Int32
+	rpc := sdkmcp.NewServer(&sdkmcp.Implementation{Name: "controlled-legacy-sse"}, nil)
+	sdkmcp.AddTool(rpc, &sdkmcp.Tool{Name: "echo", InputSchema: map[string]any{"type": "object"}}, func(context.Context, *sdkmcp.CallToolRequest, struct{}) (*sdkmcp.CallToolResult, any, error) {
+		calls.Add(1)
+		return &sdkmcp.CallToolResult{Content: []sdkmcp.Content{&sdkmcp.TextContent{Text: old + " " + fresh}}}, nil, nil
+	})
+	handler := sdkmcp.NewSSEHandler(func(*http.Request) *sdkmcp.Server { return rpc }, nil)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == "GET" {
+			gets.Add(1)
+			activeGets.Add(1)
+			defer activeGets.Add(-1)
+			if r.Header.Get("Authorization") != "Bearer "+old && r.Header.Get("Authorization") != "Bearer "+fresh {
+				t.Error("GET missing owned bearer")
+				w.WriteHeader(401)
+				return
+			}
+			handler.ServeHTTP(w, r)
+			return
+		}
+		if r.Header.Get("Authorization") == "Bearer "+old {
+			rejected.Add(1)
+			w.WriteHeader(401)
+			return
+		}
+		if r.Header.Get("Authorization") != "Bearer "+fresh {
+			t.Error("POST missing rotated bearer")
+			w.WriteHeader(401)
+			return
+		}
+		handler.ServeHTTP(w, r)
+	}))
+	defer server.Close()
+	bridge := func(_ context.Context, target NativeCredentialTarget, previous string) (string, error) {
+		if target.Transport != "sse" || target.URL != server.URL+"/sse" || target.ID != "legacy" || target.CredentialRef != "native-only-ref" {
+			return "", errors.New("unbound legacy target")
+		}
+		if revoked.Load() {
+			return "", errors.New(nativeAuthRequired)
+		}
+		if previous != "" {
+			sum := sha256.Sum256([]byte(old))
+			if previous != hex.EncodeToString(sum[:]) {
+				t.Error("wrong rejected-token digest")
+			}
+			grants.Add(1)
+			refreshed.Store(true)
+		}
+		if refreshed.Load() {
+			return fresh, nil
+		}
+		return old, nil
+	}
+	file := filepath.Join(t.TempDir(), "mcp.json")
+	settings := LiveSettings{Servers: []LiveServer{{ID: "legacy", Enabled: true, Transport: "sse", URL: server.URL + "/sse", TimeoutMs: 5000, Auth: &LiveAuth{Type: "oauth", CredentialRef: "native-only-ref"}, Policy: map[string]string{"echo": "allow"}}}}
+	if err := saveLiveSettings(file, settings); err != nil {
+		t.Fatal(err)
+	}
+	ownerContext, cancelOwner := context.WithCancel(context.Background())
+	defer cancelOwner()
+	live, err := OpenLiveManagerWithNativeCredentials(ownerContext, file, nil, bridge)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	waitLiveStatus(t, live, "legacy", "ready")
+	call := func() string {
+		return toolsExecute(t, live.ToolsFor(context.Background(), t.TempDir(), nil), ToolName("legacy", "echo"), nil)
+	}
+	if got := call(); got != "[redacted] [redacted]" {
+		t.Fatalf("legacy tool output=%q", got)
+	}
+	if gets.Load() != 1 || rejected.Load() != 1 || grants.Load() != 1 {
+		t.Fatalf("GET=%d rejectedPOST=%d grants=%d", gets.Load(), rejected.Load(), grants.Load())
+	}
+	before := live.nativeHistory
+	settings.Servers[0].Description = "metadata edit"
+	if err := live.Replace(context.Background(), settings); err != nil {
+		t.Fatal(err)
+	}
+	waitLiveStatus(t, live, "legacy", "ready")
+	if live.nativeHistory != before {
+		t.Fatal("reload discarded known credential history")
+	}
+	if got := call(); got != "[redacted] [redacted]" {
+		t.Fatalf("reload output=%q", got)
+	}
+	if gets.Load() != 2 || grants.Load() != 1 {
+		t.Fatal("reload should open a new GET and reuse the current credential")
+	}
+	revoked.Store(true)
+	beforeCalls := calls.Load()
+	for _, tool := range live.ToolsFor(context.Background(), t.TempDir(), nil) {
+		if tool.Def.Function.Name == ToolName("legacy", "echo") {
+			output, err := tool.Run(context.Background(), json.RawMessage(`{}`))
+			if err == nil {
+				t.Fatal("cleared Native owner still called the server")
+			}
+			if strings.Contains(output+err.Error(), old) || strings.Contains(output+err.Error(), fresh) {
+				t.Fatal("clear failure reflected a bearer")
+			}
+		}
+	}
+	if calls.Load() != beforeCalls {
+		t.Fatal("clear forwarded a tool call on the existing SSE connection")
+	}
+	cancelOwner()
+	deadline := time.Now().Add(3 * time.Second)
+	for activeGets.Load() != 0 {
+		if time.Now().After(deadline) {
+			t.Fatal("owner cancellation left the legacy GET open")
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+}
+
+func TestNativeCredentialsLegacySSERejectsCrossOriginEndpointAndRedirect(t *testing.T) {
+	for _, mode := range []string{"endpoint", "redirect", "hanging-startup"} {
+		t.Run(mode, func(t *testing.T) {
+			var trapCalls atomic.Int32
+			trap := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { trapCalls.Add(1); io.WriteString(w, "unexpected") }))
+			defer trap.Close()
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if mode == "redirect" {
+					http.Redirect(w, r, trap.URL, http.StatusTemporaryRedirect)
+					return
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				if mode != "hanging-startup" {
+					fmt.Fprintf(w, "event: endpoint\ndata: %s\n\n", trap.URL)
+				}
+				w.(http.Flusher).Flush()
+				<-r.Context().Done()
+			}))
+			defer server.Close()
+			file := filepath.Join(t.TempDir(), "mcp.json")
+			settings := LiveSettings{Servers: []LiveServer{{ID: "blocked", Enabled: true, Transport: "sse", URL: server.URL, TimeoutMs: 1000, Auth: &LiveAuth{Type: "oauth"}}}}
+			if err := saveLiveSettings(file, settings); err != nil {
+				t.Fatal(err)
+			}
+			live, err := OpenLiveManagerWithNativeCredentials(context.Background(), file, nil, func(context.Context, NativeCredentialTarget, string) (string, error) {
+				return "only-configured-origin-token", nil
+			})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer live.Close()
+			deadline := time.Now().Add(4 * time.Second)
+			for {
+				statuses := live.Statuses()
+				if len(statuses) == 1 && statuses[0].Status == "failed" {
+					break
+				}
+				if time.Now().After(deadline) {
+					t.Fatal("unsafe legacy session did not fail")
+				}
+				time.Sleep(5 * time.Millisecond)
+			}
+			if trapCalls.Load() != 0 {
+				t.Fatal("Native bearer reached an unconfigured origin")
+			}
+		})
+	}
+}
