+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	sdkmcp "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func TestCredentialHistoryFiltersDecodedPublicToolOutputBeforeTruncation(t *testing.T) {
+	secret := strings.Repeat("private-opaque-", 4000) // Below the Native bearer limit, above output truncation.
+	rpc := sdkmcp.NewServer(&sdkmcp.Implementation{Name: "controlled-public-mcp"}, nil)
+	sdkmcp.AddTool(rpc, &sdkmcp.Tool{Name: "echo", Description: secret, InputSchema: map[string]any{"type": "object", "description": secret}}, func(context.Context, *sdkmcp.CallToolRequest, struct{}) (*sdkmcp.CallToolResult, any, error) {
+		return &sdkmcp.CallToolResult{Content: []sdkmcp.Content{&sdkmcp.TextContent{Text: "start " + secret + " end"}}}, nil, nil
+	})
+	server := httptest.NewServer(sdkmcp.NewStreamableHTTPHandler(func(*http.Request) *sdkmcp.Server { return rpc }, &sdkmcp.StreamableHTTPOptions{Stateless: true, JSONResponse: true}))
+	defer server.Close()
+	file := filepath.Join(t.TempDir(), "mcp.json")
+	if err := saveLiveSettings(file, LiveSettings{}); err != nil {
+		t.Fatal(err)
+	}
+	live, err := OpenLiveManagerWithNativeCredentials(context.Background(), file, nil, func(context.Context, NativeCredentialTarget, string) (string, error) {
+		return "", errors.New("public server must not request credentials")
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer live.Close()
+	if err := live.nativeHistory.learn(secret); err != nil {
+		t.Fatal(err)
+	}
+	if err := live.Replace(context.Background(), LiveSettings{Servers: []LiveServer{{ID: "public", Enabled: true, Transport: "http", URL: server.URL, Policy: map[string]string{"echo": "allow"}}}}); err != nil {
+		t.Fatal(err)
+	}
+	waitLiveStatus(t, live, "public", "ready")
+	available := live.ToolsFor(context.Background(), t.TempDir(), nil)
+	for _, tool := range available {
+		data, err := json.Marshal(tool.Def)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if strings.Contains(string(data), secret) {
+			t.Fatal("tool metadata reflected a known Native credential")
+		}
+	}
+	output := toolsExecute(t, available, ToolName("public", "echo"), nil)
+	if output != "start [redacted] end" {
+		t.Fatal("decoded credential was truncated before redaction")
+	}
+}
