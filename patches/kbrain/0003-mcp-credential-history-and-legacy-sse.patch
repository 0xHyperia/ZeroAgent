@@ -0,0 +1,261 @@
+package mcp
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"math/rand"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type observedCredentialRead struct {
+	io.ReadCloser
+	started chan struct{}
+	once    sync.Once
+}
+
+func (r *observedCredentialRead) Read(out []byte) (int, error) {
+	r.once.Do(func() { close(r.started) })
+	return r.ReadCloser.Read(out)
+}
+
+func TestCredentialHistoryLearnsWhileAResponseReadIsBlocked(t *testing.T) {
+	h := newCredentialHistory()
+	if err := h.learn("old-prefix"); err != nil {
+		t.Fatal(err)
+	}
+	reader, writer := io.Pipe()
+	started := make(chan struct{})
+	body := newHistoryRedactingBody(&observedCredentialRead{ReadCloser: reader, started: started}, h)
+	defer body.Close()
+	defer writer.Close()
+	result := make(chan string, 1)
+	failure := make(chan error, 1)
+	go func() {
+		data, err := io.ReadAll(body)
+		if err != nil {
+			failure <- err
+			return
+		}
+		result <- string(data)
+	}()
+	select {
+	case <-started:
+	case <-time.After(5 * time.Second):
+		t.Fatal("body read did not start")
+	}
+	fresh := "old-prefix-rotated"
+	if err := h.learn(fresh); err != nil {
+		t.Fatal(err)
+	}
+	for _, part := range []string{"old-pre", "fix-rot", "ated old-", "prefix"} {
+		if _, err := io.WriteString(writer, part); err != nil {
+			t.Fatal(err)
+		}
+	}
+	writer.Close()
+	select {
+	case value := <-result:
+		if value != "[redacted] [redacted]" {
+			t.Fatalf("redaction=%q", value)
+		}
+	case err := <-failure:
+		t.Fatal(err)
+	case <-time.After(5 * time.Second):
+		t.Fatal("blocked response did not finish")
+	}
+}
+
+func TestCredentialHistoryRechecksQueuedRawBytesBeforePublication(t *testing.T) {
+	h := newCredentialHistory()
+	if err := h.learn("old-value"); err != nil {
+		t.Fatal(err)
+	}
+	body := newHistoryRedactingBody(io.NopCloser(strings.NewReader("x fresh-value old-value")), h)
+	defer body.Close()
+	var first [1]byte
+	if n, err := body.Read(first[:]); n != 1 || err != nil || first[0] != 'x' {
+		t.Fatalf("initial read=%d %v", n, err)
+	}
+	if err := h.learn("fresh-value"); err != nil {
+		t.Fatal(err)
+	}
+	remaining, err := io.ReadAll(body)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(remaining) != " [redacted] [redacted]" {
+		t.Fatalf("queued redaction=%q", remaining)
+	}
+}
+
+func TestCredentialHistorySurvivesRequestsAndTransportRecreation(t *testing.T) {
+	const old, fresh = "opaque-prefix", "opaque-prefix-rotated"
+	var current atomic.Bool
+	var rejected atomic.Bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/rotate" && r.Header.Get("Authorization") == "Bearer "+old {
+			rejected.Store(true)
+			w.WriteHeader(401)
+			return
+		}
+		w.Header().Set("X-Reflection", old+" "+fresh)
+		io.WriteString(w, old+" "+fresh)
+	}))
+	defer server.Close()
+	h := newCredentialHistory()
+	resolve := func(_ context.Context, previous string) (string, error) {
+		if previous != "" {
+			current.Store(true)
+		}
+		if current.Load() {
+			return fresh, nil
+		}
+		return old, nil
+	}
+	makeClient := func() *http.Client {
+		return &http.Client{Transport: &nativeCredentialTransport{base: http.DefaultTransport, endpoint: server.URL, resolve: resolve, history: h}}
+	}
+	first, err := makeClient().Get(server.URL + "/initial")
+	if err != nil {
+		t.Fatal(err)
+	}
+	io.Copy(io.Discard, first.Body)
+	first.Body.Close()
+	rotated, err := makeClient().Get(server.URL + "/rotate")
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(rotated.Body)
+	rotated.Body.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !rejected.Load() || string(body) != "[redacted] [redacted]" || rotated.Header.Get("X-Reflection") != "[redacted] [redacted]" {
+		t.Fatal("rotation response or header was not fully redacted")
+	}
+	last, err := makeClient().Get(server.URL + "/later")
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err = io.ReadAll(last.Body)
+	last.Body.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(body) != "[redacted] [redacted]" {
+		t.Fatalf("historical redaction=%q", body)
+	}
+}
+
+type credentialClosedBody struct{ closed bool }
+
+func (*credentialClosedBody) Read([]byte) (int, error) { return 0, io.EOF }
+func (b *credentialClosedBody) Close() error           { b.closed = true; return nil }
+
+type credentialRoundTripFunc func(*http.Request) (*http.Response, error)
+
+func (f credentialRoundTripFunc) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestCredentialHistoryCapacityFailsBeforeSendingWithoutEviction(t *testing.T) {
+	h := &credentialHistory{maxEntries: 1, maxBytes: 1024}
+	if err := h.learn("already-known"); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.learn("already-known"); err != nil {
+		t.Fatal(err)
+	}
+	sent := 0
+	body := &credentialClosedBody{}
+	transport := &nativeCredentialTransport{base: credentialRoundTripFunc(func(*http.Request) (*http.Response, error) { sent++; return nil, errors.New("must not send") }), endpoint: "https://fixture.invalid/mcp", history: h, resolve: func(context.Context, string) (string, error) { return "new-unrecordable-token", nil }}
+	req, _ := http.NewRequest("POST", "https://fixture.invalid/mcp", body)
+	_, err := transport.RoundTrip(req)
+	if !errors.Is(err, errCredentialHistoryFull) || sent != 0 || !body.closed {
+		t.Fatalf("capacity rejection err=%v sent=%d closed=%v", err, sent, body.closed)
+	}
+	h.mu.RLock()
+	masked := h.redactValueLocked("already-known")
+	h.mu.RUnlock()
+	if masked != "[redacted]" {
+		t.Fatal("an older credential was evicted")
+	}
+}
+
+type credentialChunkReader struct {
+	io.Reader
+	size int
+}
+
+func (r credentialChunkReader) Read(out []byte) (int, error) {
+	return r.Reader.Read(out[:min(r.size, len(out))])
+}
+
+func referenceCredentialMask(value string, secrets []string) string {
+	masked := make([]bool, len(value))
+	for _, secret := range secrets {
+		encoded, _ := json.Marshal(secret)
+		for _, pattern := range []string{secret, string(encoded[1 : len(encoded)-1])} {
+			if pattern == "" {
+				continue
+			}
+			for from := 0; from <= len(value)-len(pattern); {
+				at := strings.Index(value[from:], pattern)
+				if at < 0 {
+					break
+				}
+				at += from
+				for i := at; i < at+len(pattern); i++ {
+					masked[i] = true
+				}
+				from = at + 1
+			}
+		}
+	}
+	var result strings.Builder
+	inside := false
+	for i, b := range []byte(value) {
+		if masked[i] {
+			if !inside {
+				result.WriteString("[redacted]")
+			}
+			inside = true
+		} else {
+			result.WriteByte(b)
+			inside = false
+		}
+	}
+	return result.String()
+}
+func TestCredentialHistoryStreamingMatchesIndependentOverlapMask(t *testing.T) {
+	rng := rand.New(rand.NewSource(531))
+	for iteration := 0; iteration < 160; iteration++ {
+		alphabet := []byte("abc\\\"")
+		makeText := func(n int) string {
+			b := make([]byte, n)
+			for i := range b {
+				b[i] = alphabet[rng.Intn(len(alphabet))]
+			}
+			return string(b)
+		}
+		secrets := []string{makeText(1 + rng.Intn(9)), makeText(1 + rng.Intn(9)), "prefix", "prefix-rotated"}
+		value := makeText(120) + " prefix-rotated " + secrets[0] + secrets[1]
+		for _, size := range []int{1, 2, 7, 31} {
+			body := newCredentialRedactingBody(io.NopCloser(credentialChunkReader{Reader: strings.NewReader(value), size: size}), secrets)
+			got, err := io.ReadAll(body)
+			body.Close()
+			if err != nil {
+				t.Fatal(err)
+			}
+			if string(got) != referenceCredentialMask(value, secrets) {
+				t.Fatalf("stream mask mismatch iteration=%d chunk=%d", iteration, size)
+			}
+		}
+	}
+}
