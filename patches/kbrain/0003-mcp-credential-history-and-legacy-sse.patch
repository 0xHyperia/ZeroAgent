diff --git a/internal/mcp/credential_history.go b/internal/mcp/credential_history.go
new file mode 100644
index 0000000000000000000000000000000000000000..43a7e39afe644b49c3e286251b899b1378ebdc42
--- /dev/null
+++ b/internal/mcp/credential_history.go
@@ -0,0 +1,321 @@
+package mcp
+
+import (
+	"encoding/json"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+)
+
+var errCredentialHistoryFull = errors.New("MCP_OAUTH_CREDENTIAL_HISTORY_LIMIT: restart the backend")
+
+// One Native-enabled LiveManager owns this ledger through reloads/reconnections.
+// Exhaustion rejects a new bearer before sending it; old values are never evicted.
+type credentialHistory struct {
+	mu                   sync.RWMutex
+	values               map[string]bool
+	seenPatterns         map[string]bool
+	patterns             []credentialPattern
+	bytes                int
+	maxEntries, maxBytes int
+}
+
+func newCredentialHistory() *credentialHistory {
+	return &credentialHistory{maxEntries: 4096, maxBytes: 8 * 1024 * 1024}
+}
+func (*credentialHistory) String() string   { return "Native MCP credential history" }
+func (*credentialHistory) GoString() string { return "Native MCP credential history" }
+
+type credentialPattern struct {
+	value   []byte
+	failure []int
+}
+
+func (h *credentialHistory) learn(secret string) error {
+	if secret == "" {
+		return nil
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.values[secret] {
+		return nil
+	}
+	encoded, _ := json.Marshal(secret)
+	var added []string
+	cost := len(secret)
+	for _, value := range []string{secret, string(encoded[1 : len(encoded)-1])} {
+		if h.seenPatterns[value] {
+			continue
+		}
+		duplicate := false
+		for _, v := range added {
+			if v == value {
+				duplicate = true
+			}
+		}
+		if !duplicate {
+			added = append(added, value)
+			cost += len(value)
+		}
+	}
+	if len(h.values) >= h.maxEntries || cost > h.maxBytes-h.bytes {
+		return errCredentialHistoryFull
+	}
+	if h.values == nil {
+		h.values = map[string]bool{}
+		h.seenPatterns = map[string]bool{}
+	}
+	for _, value := range added {
+		p := credentialPattern{value: []byte(value), failure: make([]int, len(value))}
+		for i, j := 1, 0; i < len(value); i++ {
+			for j > 0 && value[i] != value[j] {
+				j = p.failure[j-1]
+			}
+			if value[i] == value[j] {
+				j++
+			}
+			p.failure[i] = j
+		}
+		h.patterns = append(h.patterns, p)
+		h.seenPatterns[value] = true
+	}
+	h.values[secret] = true
+	h.bytes += cost
+	return nil
+}
+
+// Complete-match spans are retained as raw positions until publication. This
+// masks unions of overlapping/prefix tokens without exposing a rotated suffix.
+type credentialSpan struct{ start, end int64 }
+
+func addCredentialSpan(spans []credentialSpan, span credentialSpan) []credentialSpan {
+	for len(spans) > 0 && spans[len(spans)-1].end >= span.start {
+		last := spans[len(spans)-1]
+		if last.start < span.start {
+			span.start = last.start
+		}
+		if last.end > span.end {
+			span.end = last.end
+		}
+		spans = spans[:len(spans)-1]
+	}
+	return append(spans, span)
+}
+func unionCredentialSpans(a, b []credentialSpan) []credentialSpan {
+	out := make([]credentialSpan, 0, len(a)+len(b))
+	for len(a) > 0 || len(b) > 0 {
+		var next credentialSpan
+		if len(b) == 0 || (len(a) > 0 && a[0].start <= b[0].start) {
+			next = a[0]
+			a = a[1:]
+		} else {
+			next = b[0]
+			b = b[1:]
+		}
+		out = addCredentialSpan(out, next)
+	}
+	return out
+}
+
+type credentialRedactingBody struct {
+	body         io.ReadCloser
+	history      *credentialHistory
+	patterns     []credentialPattern
+	matched      []int
+	data, marker []byte
+	base, safe   int64
+	spans        []credentialSpan
+	inMask       bool
+	terminal     error
+}
+
+func newCredentialRedactingBody(body io.ReadCloser, secrets []string) io.ReadCloser {
+	h := newCredentialHistory()
+	for _, secret := range secrets {
+		if err := h.learn(secret); err != nil {
+			return &credentialRedactingBody{body: body, history: h, terminal: err}
+		}
+	}
+	return newHistoryRedactingBody(body, h)
+}
+func newHistoryRedactingBody(body io.ReadCloser, h *credentialHistory) io.ReadCloser {
+	return &credentialRedactingBody{body: body, history: h}
+}
+
+func (r *credentialRedactingBody) advance(b byte, end int64) {
+	full, keep := 0, 0
+	for i, p := range r.patterns {
+		j := r.matched[i]
+		for j > 0 && b != p.value[j] {
+			j = p.failure[j-1]
+		}
+		if b == p.value[j] {
+			j++
+		}
+		if j == len(p.value) {
+			if j > full {
+				full = j
+			}
+			j = p.failure[j-1]
+		}
+		r.matched[i] = j
+		if j > keep {
+			keep = j
+		}
+	}
+	if full > 0 {
+		r.spans = addCredentialSpan(r.spans, credentialSpan{end - int64(full), end})
+	}
+	r.safe = end - int64(keep)
+}
+
+// The caller holds the ledger's read lock. Re-evaluate all unpublished raw data
+// when another request learns a token, preserving spans already discovered.
+func (r *credentialRedactingBody) synchronize() {
+	if len(r.patterns) == len(r.history.patterns) {
+		return
+	}
+	r.patterns = r.history.patterns
+	r.matched = make([]int, len(r.patterns))
+	old := r.spans
+	r.spans = nil
+	r.safe = r.base
+	for i, b := range r.data {
+		r.advance(b, r.base+int64(i)+1)
+	}
+	r.spans = unionCredentialSpans(old, r.spans)
+	if r.terminal != nil {
+		r.safe = r.base + int64(len(r.data))
+	}
+}
+func (r *credentialRedactingBody) consume(n int) {
+	r.data = r.data[n:]
+	r.base += int64(n)
+	for len(r.spans) > 0 && r.spans[0].end <= r.base {
+		r.spans = r.spans[1:]
+	}
+}
+func (r *credentialRedactingBody) drain(out []byte) int {
+	written := 0
+	for len(out) > 0 {
+		if len(r.marker) > 0 {
+			n := copy(out, r.marker)
+			r.marker = r.marker[n:]
+			out = out[n:]
+			written += n
+			continue
+		}
+		if r.base >= r.safe {
+			break
+		}
+		if len(r.spans) > 0 && r.spans[0].start <= r.base {
+			if !r.inMask {
+				r.inMask = true
+				r.marker = []byte("[redacted]")
+				continue
+			}
+			end := min(r.safe, r.spans[0].end)
+			r.consume(int(end - r.base))
+			continue
+		}
+		r.inMask = false
+		end := r.safe
+		if len(r.spans) > 0 {
+			end = min(end, r.spans[0].start)
+		}
+		n := min(len(out), int(end-r.base))
+		copy(out, r.data[:n])
+		r.consume(n)
+		out = out[n:]
+		written += n
+	}
+	return written
+}
+func (r *credentialRedactingBody) Read(out []byte) (int, error) {
+	if len(out) == 0 {
+		return 0, nil
+	}
+	for {
+		r.history.mu.RLock()
+		r.synchronize()
+		n := r.drain(out)
+		terminal := r.terminal
+		r.history.mu.RUnlock()
+		if n > 0 {
+			return n, nil
+		}
+		if terminal != nil {
+			return 0, terminal
+		}
+		var chunk [16 * 1024]byte
+		n, err := r.body.Read(chunk[:]) // Never hold the ledger across network IO.
+		r.history.mu.RLock()
+		r.synchronize()
+		start := len(r.data)
+		r.data = append(r.data, chunk[:n]...)
+		for i, b := range r.data[start:] {
+			r.advance(b, r.base+int64(start+i)+1)
+		}
+		if err != nil {
+			r.terminal = err
+			r.safe = r.base + int64(len(r.data))
+		}
+		r.history.mu.RUnlock()
+		if n == 0 && err == nil {
+			return 0, nil
+		}
+	}
+}
+func (r *credentialRedactingBody) Close() error { return r.body.Close() }
+
+func (h *credentialHistory) redactValueLocked(value string) string {
+	r := &credentialRedactingBody{history: h, patterns: h.patterns, matched: make([]int, len(h.patterns)), data: []byte(value)}
+	for i, b := range r.data {
+		r.advance(b, int64(i)+1)
+	}
+	r.safe = int64(len(r.data))
+	r.terminal = io.EOF
+	var result strings.Builder
+	var chunk [4096]byte
+	for {
+		n := r.drain(chunk[:])
+		if n == 0 {
+			break
+		}
+		result.Write(chunk[:n])
+	}
+	return result.String()
+}
+func (h *credentialHistory) protectResponse(resp *http.Response) {
+	h.mu.RLock()
+	resp.Status = h.redactValueLocked(resp.Status)
+	for key, values := range resp.Header {
+		for i, value := range values {
+			values[i] = h.redactValueLocked(value)
+		}
+		resp.Header[key] = values
+	}
+	h.mu.RUnlock()
+	if resp.Body == nil {
+		resp.Body = http.NoBody
+	}
+	resp.Body = newHistoryRedactingBody(resp.Body, h)
+	resp.ContentLength = -1
+	resp.Header.Del("Content-Length")
+}
+
+func (h *credentialHistory) redactValue(value string) string {
+	h.mu.RLock()
+	defer h.mu.RUnlock()
+	return h.redactValueLocked(value)
+}
+
+type credentialOutputError struct {
+	message string
+	cause   error
+}
+
+func (e *credentialOutputError) Error() string { return e.message }
+func (e *credentialOutputError) Unwrap() error { return e.cause }
