+package mcp
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	sdkmcp "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+func TestMCPAppOutputsUseNativeCredentialHistory(t *testing.T) {
+	const secret = "native-test-bearer"
+	const uri = "ui://board/view.html"
+	history := newCredentialHistory()
+	if err := history.learn(secret); err != nil {
+		t.Fatal(err)
+	}
+	cfg := ServerConfig{nativeHistory: history}
+	result := cfg.nativeAppResult(&sdkmcp.CallToolResult{
+		Content:           []sdkmcp.Content{&sdkmcp.TextContent{Text: secret}},
+		StructuredContent: map[string]any{"nested": map[string]string{"reflection": secret}, "label": "Sales"},
+	})
+	if !json.Valid(result) || strings.Contains(string(result), secret) || !strings.Contains(string(result), "Sales") {
+		t.Fatalf("invalid or unredacted MCP App result: %s", result)
+	}
+	if got := cfg.nativeUIResourceURI(sdkmcp.Meta{"ui/resourceUri": uri + "?value=" + secret}); got != "" {
+		t.Fatalf("credential embedded in a resource URI should suppress that declaration: %q", got)
+	}
+	resource, err := cfg.nativeUIContent(&sdkmcp.ReadResourceResult{Contents: []*sdkmcp.ResourceContents{{
+		URI: uri, MIMEType: "text/html", Blob: []byte("<p>Sales " + secret + "</p>"),
+	}}}, uri)
+	if err != nil || !strings.Contains(resource.HTML, "Sales") || strings.Contains(resource.HTML, secret) {
+		t.Fatalf("decoded MCP App HTML must be redacted: %+v %v", resource, err)
+	}
+}
