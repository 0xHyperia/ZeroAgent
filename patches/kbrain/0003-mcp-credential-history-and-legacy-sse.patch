+++ b/internal/mcp/native_sse.go
@@ -0,0 +1,44 @@
+package mcp
+
+import (
+	"context"
+	"net/http"
+
+	sdkmcp "github.com/modelcontextprotocol/go-sdk/mcp"
+)
+
+// Manager's initialization context ends after ListTools. The legacy GET must
+// instead live until Connection.Close, while cancellation still interrupts its
+// initial response/endpoint handshake. Initialize/ListTools retain their own
+// unchanged startup context and close the connection on failure.
+type ownedSSEClientTransport struct {
+	endpoint string
+	client   *http.Client
+}
+
+func (t *ownedSSEClientTransport) Connect(ctx context.Context) (sdkmcp.Connection, error) {
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	lifetime, cancel := context.WithCancel(context.WithoutCancel(ctx))
+	stop := context.AfterFunc(ctx, cancel)
+	connection, err := (&sdkmcp.SSEClientTransport{Endpoint: t.endpoint, HTTPClient: t.client}).Connect(lifetime)
+	stop()
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	if err := ctx.Err(); err != nil {
+		cancel()
+		connection.Close()
+		return nil, err
+	}
+	return &ownedSSEConnection{Connection: connection, cancel: cancel}, nil
+}
+
+type ownedSSEConnection struct {
+	sdkmcp.Connection
+	cancel context.CancelFunc
+}
+
+func (c *ownedSSEConnection) Close() error { c.cancel(); return c.Connection.Close() }
