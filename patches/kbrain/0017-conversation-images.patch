+}
+
+func (f finishedConversationImageJobs) GetJob(ctx context.Context, scope imaging.Scope, id string) (imaging.ImageJob, error) {
+	job, err := f.imageHTTPJobsFake.GetJob(ctx, scope, id)
+	if err == nil {
+		job.Status = imaging.JobSucceeded
+		job.AssetIDs = []string{"ia_fixture"}
+	}
+	return job, err
+}
+
+func TestConversationImageToolUsesAuthorizedConversationAndCurrentAttachment(t *testing.T) {
+	s := imageHTTPFixture(t)
+	scope := imageTestScope()
+	ctx := context.WithValue(context.Background(), conversationImageScopeKey{}, scope)
+	options := protocol.RunOptions{Mode: "chat", ImageCreation: &protocol.RunImageCreation{}}
+	if got := s.conversationImageTools(context.Background(), "chat-a", "run-a", options, nil); len(got) != 0 {
+		t.Fatal("an unauthenticated run was offered images")
+	}
+	tool := s.conversationImageTools(ctx, "chat-a", "run-a", options, nil)[0]
+	result, err := tool.Run(ctx, []byte(`{"prompt":"Create a test image"}`))
+	if err != nil || !strings.Contains(result, "needs_configuration") {
+		t.Fatalf("missing model: %s %v", result, err)
+	}
+	options.Sandbox = &protocol.RunSandbox{Mode: "workspace", Network: false}
+	if got := s.conversationImageTools(ctx, "chat-a", "run-a", options, nil); len(got) != 0 {
+		t.Fatal("an offline run was offered a provider tool")
+	}
+	options.Sandbox = nil
+
+	cfg := config.Default()
+	target := imageTestTarget()
+	target.Enabled = true
+	target.Capabilities.Operations = append(target.Capabilities.Operations, imaging.OperationEdit)
+	target.Capabilities.MaxInputs = 1
+	cfg.Image = &imaging.ImageSettings{Connections: []imaging.ImageConnection{imageTestConnection()}, Targets: []imaging.ImageTarget{target}}
+	s.image.Settings, err = NewImageSettingsManager(NewSettingsStore(cfg, func(*config.Config) error { return nil }), filepath.Join(t.TempDir(), "secrets.json"), ImageSettingsOptions{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s.image.Jobs = finishedConversationImageJobs{s.image.Jobs.(*imageHTTPJobsFake)}
+	options.ImageCreation.TargetID = target.ID
+	prior := []ai.Message{{Role: "tool", Name: conversationImageToolName, Content: `{"status":"needs_configuration"}`}}
+	textOnly := s.conversationImageTools(ctx, "chat-text", "resume-after-setup", options, prior)
+	if len(textOnly) != 1 || textOnly[0].Def.Function.Name != conversationImageToolName ||
+		string(textOnly[0].Def.Function.Parameters) != `{"type":"object","properties":{"prompt":{"type":"string"}},"required":["prompt"],"additionalProperties":false}` {
+		t.Fatalf("text-only generation offered reference parameters: %+v", textOnly)
+	}
+	result, err = textOnly[0].Run(tools.WithToolCallID(ctx, "text-only"), []byte(`{"prompt":"A cat in space"}`))
+	if err != nil || !strings.Contains(result, `"status":"succeeded"`) {
+		t.Fatalf("generation after choosing a model: %s %v", result, err)
+	}
+	prior = append(prior, ai.Message{Role: "tool", Name: conversationImageToolName, Content: result})
+	withPrevious := s.conversationImageTools(ctx, "chat-text", "edit-prior", options, prior)
+	if len(withPrevious) != 2 || !strings.Contains(string(withPrevious[1].Def.Function.Parameters), `"enum":["ia_fixture"]`) {
+		t.Fatalf("prior result unavailable to the edit tool: %+v", withPrevious)
+	}
+	root := t.TempDir()
+	file, err := os.Create(filepath.Join(root, "reference.png"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	err = png.Encode(file, image.NewRGBA(image.Rect(0, 0, 32, 32)))
+	file.Close()
+	if err != nil {
+		t.Fatal(err)
+	}
+	options.WorkspaceRoots = []protocol.WorkspaceRoot{{Path: root, Access: "read"}}
+	options.ImageCreation = &protocol.RunImageCreation{TargetID: target.ID, Attachments: []string{file.Name()}}
+	withAttachment := s.conversationImageTools(ctx, "chat-a", "run-b", options, nil)
+	tool = withAttachment[1]
+	if tool.Def.Function.Name != conversationImageEditToolName {
+		t.Fatalf("expected edit tool, got %s", tool.Def.Function.Name)
+	}
+	raw := []byte(`{"prompt":"Make this blue","reference":"attachment:1"}`)
+	result, err = tool.Run(tools.WithToolCallID(ctx, "call-a"), raw)
+	if err != nil || !strings.Contains(result, `"status":"succeeded"`) || !strings.Contains(result, "ia_fixture") {
+		t.Fatalf("image result: %s %v", result, err)
+	}
+	second, _ := withAttachment[0].Run(ctx, []byte(`{"prompt":"Second image"}`))
+	if !strings.Contains(second, "already_requested") {
+		t.Fatalf("unexpected second execution: %s", second)
+	}
+	project, err := s.image.Store.EnsureConversationProject(ctx, scope, "chat-a")
+	if err != nil {
+		t.Fatal(err)
+	}
+	jobs, err := s.image.Jobs.ListJobs(ctx, scope, project.ID, imaging.PageRequest{Limit: 10})
+	if err != nil || len(jobs.Items) != 1 || jobs.Items[0].Request.Operation != imaging.OperationEdit || len(jobs.Items[0].Request.Inputs) != 1 {
+		t.Fatalf("unexpected scoped job: %+v %v", jobs, err)
+	}
+	options.WorkspaceRoots = []protocol.WorkspaceRoot{{Path: t.TempDir(), Access: "read"}}
+	tool = s.conversationImageTools(ctx, "chat-b", "run-c", options, nil)[1]
+	result, _ = tool.Run(ctx, raw)
+	if !strings.Contains(result, "reference_unavailable") {
+		t.Fatalf("out-of-root attachment accepted: %s", result)
+	}
+}
