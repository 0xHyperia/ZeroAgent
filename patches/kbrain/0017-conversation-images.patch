+
+func (s *Store) EnsureConversationProject(ctx context.Context, scope Scope, conversationID string) (ImageProject, error) {
+	ref := "zeroagent:conversation:" + conversationID
+	var project ImageProject
+	err := s.Update(WithScope(ctx, scope), func(tx *Transaction) error {
+		for _, record := range tx.data.Projects {
+			if record.DeletedAt == nil && record.Scope.matches(scope) && record.Value.WorkspaceRef == ref {
+				project = record.Value
+				return nil
+			}
+		}
+		id, err := newProjectID()
+		if err != nil {
+			return err
+		}
+		project = ImageProject{ID: id, Title: "Conversation images", WorkspaceRef: ref, Revision: 1, CreatedAt: tx.now, UpdatedAt: tx.now}
+		return tx.PutProject(project)
+	})
+	return project, err
+}
