diff --git a/internal/backend/conversation_images.go b/internal/backend/conversation_images.go
new file mode 100644
index 0000000000000000000000000000000000000000..0a02f265a20052bcda79acda2ed9d82b676d3abc
--- /dev/null
+++ b/internal/backend/conversation_images.go
@@ -0,0 +1,241 @@
+package backend
+
+import (
+	"bufio"
+	"context"
+	"crypto/sha256"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"path/filepath"
+	"regexp"
+	"slices"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	"github.com/Stack-Cairn/K-brain/internal/ai"
+	"github.com/Stack-Cairn/K-brain/internal/imaging"
+	"github.com/Stack-Cairn/K-brain/internal/protocol"
+	"github.com/Stack-Cairn/K-brain/internal/tools"
+)
+
+const (
+	conversationImageToolName     = "generate_image"
+	conversationImageEditToolName = "edit_image"
+)
+
+type conversationImageScopeKey struct{}
+
+var conversationImageAssetID = regexp.MustCompile(`^ia_[A-Za-z0-9_-]{1,96}$`)
+
+func (s *Server) conversationImageTools(ctx context.Context, conversationID, runID string, options protocol.RunOptions, history []ai.Message) []tools.Tool {
+	scope, allowed := ctx.Value(conversationImageScopeKey{}).(imaging.Scope)
+	module := s.image
+	if !allowed || module == nil || module.Jobs == nil || module.Store == nil || module.Settings == nil ||
+		options.ImageCreation == nil || options.PlanModeEnabled || options.ApprovalPolicy == "deny" ||
+		isUnattendedRun(ctx) || (options.Sandbox != nil && !options.Sandbox.Network) {
+		return nil
+	}
+	references := conversationImageReferences(options.ImageCreation.Attachments, history)
+	var attempted atomic.Bool
+	run := func(edit bool) func(context.Context, json.RawMessage) (string, error) {
+		return func(ctx context.Context, raw json.RawMessage) (string, error) {
+			var args conversationImageInput
+			decoder := json.NewDecoder(strings.NewReader(string(raw)))
+			decoder.DisallowUnknownFields()
+			var trailing any
+			if len(raw) > 32<<10 || decoder.Decode(&args) != nil || decoder.Decode(&trailing) != io.EOF ||
+				strings.TrimSpace(args.Prompt) == "" || (edit != (args.Reference != "")) {
+				return conversationImageReply("invalid_request", "", nil), nil
+			}
+			if edit && !slices.Contains(references, args.Reference) {
+				return conversationImageReply("reference_unavailable", "", nil), nil
+			}
+			if !attempted.CompareAndSwap(false, true) {
+				return conversationImageReply("already_requested", "", nil), nil
+			}
+			return module.createConversationImage(ctx, scope, conversationID, runID, *options.ImageCreation, options.WorkspaceRoots, args), nil
+		}
+	}
+	result := []tools.Tool{{
+		NoInherit: true,
+		Def: ai.NewTool(conversationImageToolName,
+			"Generate a new image from text when explicitly requested, including continuing an earlier generation after image-model setup. On success the app displays the image. Do not invent a link, substitute a workspace file, or retry an unconfirmed outcome.",
+			`{"type":"object","properties":{"prompt":{"type":"string"}},"required":["prompt"],"additionalProperties":false}`),
+		Run: run(false),
+	}}
+	if len(references) > 0 {
+		enum, _ := json.Marshal(references)
+		schema := fmt.Sprintf(`{"type":"object","properties":{"prompt":{"type":"string"},"reference":{"type":"string","enum":%s}},"required":["prompt","reference"],"additionalProperties":false}`, enum)
+		result = append(result, tools.Tool{
+			NoInherit: true,
+			Def: ai.NewTool(conversationImageEditToolName,
+				"Edit one existing image only when the user asks. Select attachment:N for the Nth image attached to the current message, or a listed asset ID from this conversation. On success the app displays the result. Never retry an unconfirmed outcome.",
+				schema),
+			Run: run(true),
+		})
+	}
+	return result
+}
+
+type conversationImageInput struct {
+	Prompt    string `json:"prompt"`
+	Reference string `json:"reference"`
+}
+
+func conversationImageReferences(attachments []string, history []ai.Message) []string {
+	var references []string
+	for i := range min(len(attachments), 16) {
+		references = append(references, "attachment:"+strconv.Itoa(i+1))
+	}
+	limit := len(references) + 8
+	for i := len(history) - 1; i >= 0 && len(references) < limit; i-- {
+		message := history[i]
+		if message.Role != "tool" || (message.Name != conversationImageToolName && message.Name != conversationImageEditToolName) {
+			continue
+		}
+		line, _, _ := strings.Cut(message.TextContent(), "\n")
+		var result struct {
+			Status   string   `json:"status"`
+			AssetIDs []string `json:"asset_ids"`
+		}
+		if json.Unmarshal([]byte(line), &result) != nil || (result.Status != "succeeded" && result.Status != "partial_succeeded") {
+			continue
+		}
+		for _, id := range result.AssetIDs {
+			if conversationImageAssetID.MatchString(id) && !slices.Contains(references, id) {
+				references = append(references, id)
+			}
+			if len(references) >= limit {
+				break
+			}
+		}
+	}
+	return references
+}
+
+func conversationImageReply(status, jobID string, assetIDs []string) string {
+	raw, _ := json.Marshal(struct {
+		Status   string   `json:"status"`
+		JobID    string   `json:"job_id,omitempty"`
+		AssetIDs []string `json:"asset_ids,omitempty"`
+	}{status, jobID, assetIDs})
+	return string(raw)
+}
+
+func (m *ImageModule) createConversationImage(ctx context.Context, scope imaging.Scope, conversationID, runID string, config protocol.RunImageCreation, roots []protocol.WorkspaceRoot, args conversationImageInput) string {
+	reply := func(status string) string { return conversationImageReply(status, "", nil) }
+	targetID := config.TargetID
+	if targetID == "" {
+		return reply("needs_configuration")
+	}
+	target, err := m.Settings.ResolveTarget(ctx, scope, targetID)
+	if err != nil {
+		return reply("model_unavailable")
+	}
+	project, err := m.Store.EnsureConversationProject(ctx, scope, conversationID)
+	if err != nil {
+		return reply("failed")
+	}
+	request := imaging.CreateJobRequest{ProjectID: project.ID, TargetID: targetID, Prompt: strings.TrimSpace(args.Prompt), Operation: imaging.OperationGenerate, Count: 1}
+	if args.Reference != "" {
+		role := "source"
+		request.Operation = imaging.OperationEdit
+		if !slices.Contains(target.Capabilities.Operations, imaging.OperationEdit) {
+			request.Operation, role = imaging.OperationReference, "reference"
+		}
+		if !slices.Contains(target.Capabilities.Operations, request.Operation) {
+			return reply("unsupported_edit")
+		}
+		assetID := args.Reference
+		if index, attached := strings.CutPrefix(assetID, "attachment:"); attached {
+			n, err := strconv.Atoi(index)
+			if m.Assets == nil || err != nil || n < 1 || n > len(config.Attachments) {
+				return reply("reference_unavailable")
+			}
+			assetID, err = m.importConversationImage(ctx, scope, roots, config.Attachments[n-1])
+			if err != nil {
+				return reply("reference_unavailable")
+			}
+		} else {
+			asset, assetErr := m.Store.ReadAsset(scope, assetID)
+			if assetErr != nil || !asset.Available || asset.JobID == "" {
+				return reply("reference_unavailable")
+			}
+			parent, parentErr := m.Jobs.GetJob(ctx, scope, asset.JobID)
+			if parentErr != nil || parent.ProjectID != project.ID || !slices.Contains(parent.AssetIDs, assetID) {
+				return reply("reference_unavailable")
+			}
+			request.ParentAssetID = assetID
+		}
+		request.Inputs = []imaging.InputAsset{{AssetID: assetID, Role: role}}
+	}
+	key := fmt.Sprintf("conversation-image:%x", sha256.Sum256([]byte(strconv.Quote(conversationID)+strconv.Quote(runID)+strconv.Quote(tools.ToolCallID(ctx)))))
+	job, _, err := m.Jobs.CreateJob(ctx, scope, key, request)
+	if err != nil {
+		return reply("failed")
+	}
+	ticker := time.NewTicker(350 * time.Millisecond)
+	defer ticker.Stop()
+	timeout := time.NewTimer(6 * time.Minute)
+	defer timeout.Stop()
+	for {
+		if imageTerminal(job.Status) {
+			return conversationImageReply(string(job.Status), job.ID, job.AssetIDs)
+		}
+		select {
+		case <-ctx.Done():
+			cancelCtx, cancel := context.WithTimeout(context.WithoutCancel(ctx), 2*time.Second)
+			_, _ = m.Jobs.CancelJob(cancelCtx, scope, job.ID)
+			cancel()
+			return conversationImageReply("cancelled", job.ID, nil)
+		case <-timeout.C:
+			return conversationImageReply("result_unknown", job.ID, nil)
+		case <-ticker.C:
+			next, err := m.Jobs.GetJob(ctx, scope, job.ID)
+			if err == nil {
+				job = next
+			}
+		}
+	}
+}
+
+func (m *ImageModule) importConversationImage(ctx context.Context, scope imaging.Scope, roots []protocol.WorkspaceRoot, absolutePath string) (string, error) {
+	if !filepath.IsAbs(absolutePath) {
+		return "", errors.New("attachment path is not absolute")
+	}
+	for _, entry := range roots {
+		relative, err := filepath.Rel(entry.Path, absolutePath)
+		if err != nil || !filepath.IsLocal(relative) || relative == "." {
+			continue
+		}
+		root, err := os.OpenRoot(entry.Path)
+		if err != nil {
+			continue
+		}
+		defer root.Close()
+		info, err := root.Stat(relative)
+		if err != nil || !info.Mode().IsRegular() {
+			break
+		}
+		file, err := root.Open(relative)
+		if err != nil {
+			break
+		}
+		defer file.Close()
+		reader := bufio.NewReader(file)
+		prefix, _ := reader.Peek(512)
+		mime := http.DetectContentType(prefix)
+		if mime != "image/png" && mime != "image/jpeg" && mime != "image/webp" {
+			break
+		}
+		asset, err := m.Assets.ImportAsset(ctx, scope, reader, mime)
+		return asset.ID, err
+	}
+	return "", errors.New("attached image unavailable")
+}
