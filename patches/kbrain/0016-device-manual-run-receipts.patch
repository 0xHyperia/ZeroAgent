+func (c *cronStore) manualReceipt(taskID, executionID string) (CronRunNowResponse, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.task(taskID) != nil {
+		for _, run := range c.disk.Runs {
+			if run.TaskID == taskID && run.ID == executionID && !run.Counted {
+				return CronRunNowResponse{ExecutionID: run.ID, StartedAt: run.StartedAt}, true
+			}
+		}
+	}
+	return CronRunNowResponse{}, false
+}
