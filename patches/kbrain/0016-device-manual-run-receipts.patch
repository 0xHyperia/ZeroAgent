+func (s *Server) cronManualRun(w http.ResponseWriter, r *http.Request, taskID, executionID string) {
+	w.Header().Set("Cache-Control", "no-store")
+	if len(executionID) != 43 || !strings.HasPrefix(executionID, "manual-") || !validID(executionID) {
+		writeJSONError(w, http.StatusBadRequest, "invalid manual cron execution id")
+		return
+	}
+	var receipt CronRunNowResponse
+	if r.Method == http.MethodGet {
+		var found bool
+		receipt, found = s.cron.store.manualReceipt(taskID, executionID)
+		if !found {
+			writeJSON(w, http.StatusOK, map[string]string{"status": "missing"})
+			return
+		}
+	} else {
+		var err error
+		receipt, err = s.cron.startWithExecutionID(taskID, false, executionID)
+		if err != nil {
+			writeJSON(w, http.StatusOK, map[string]string{"status": "rejected"})
+			return
+		}
+	}
+	writeJSON(w, http.StatusOK, map[string]any{
+		"status": "admitted", "executionId": receipt.ExecutionID, "startedAt": receipt.StartedAt,
+	})
+}
