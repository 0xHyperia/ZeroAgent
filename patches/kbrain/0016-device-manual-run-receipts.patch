diff --git a/internal/backend/cron_manual_receipt_test.go b/internal/backend/cron_manual_receipt_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..2f51ea198df4d4282b9d520161e4ee4539cbfe04
--- /dev/null
+++ b/internal/backend/cron_manual_receipt_test.go
@@ -0,0 +1,110 @@
+package backend
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"sync/atomic"
+	"testing"
+
+	"github.com/Stack-Cairn/K-brain/internal/agent"
+	"github.com/Stack-Cairn/K-brain/internal/protocol"
+	"github.com/Stack-Cairn/K-brain/internal/session"
+)
+
+func TestManualCronReceiptIsExactAndPersistsAcrossRestart(t *testing.T) {
+	var requests atomic.Int32
+	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		requests.Add(1)
+		w.WriteHeader(http.StatusNoContent)
+	}))
+	defer upstream.Close()
+	root := t.TempDir()
+	sessions, err := session.Open(filepath.Join(root, "sessions"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer sessions.Close()
+	factory := func(context.Context, string, protocol.ModelRef) (*agent.Agent, error) {
+		return agent.New(&cronTestClient{}, "model", 128, ""), nil
+	}
+	options := Options{Store: sessions, Factory: factory, EventDir: filepath.Join(root, "events"),
+		DefaultCWD: root, MemoryRoot: filepath.Join(root, "memory")}
+	newServer := func() (*Server, *httptest.Server) {
+		t.Helper()
+		backend, err := New(options)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return backend, httptest.NewServer(backend)
+	}
+	backend, server := newServer()
+	defer backend.Close()
+	defer server.Close()
+	create := map[string]any{"baseRevision": 0, "ops": []any{
+		map[string]any{"op": "create", "item": map[string]any{
+			"id": "manual-task", "name": "manual", "cron": "0 0 0 1 1 *", "enabled": false,
+			"type": "http", "requests": []any{map[string]any{"url": upstream.URL, "method": "GET"}},
+			"remainingExecutions": 1,
+		}},
+	}}
+	if status := doCronJSON(t, server.URL+"/v1/cron", http.MethodPut, create, nil); status != http.StatusOK {
+		t.Fatalf("create status %d", status)
+	}
+	const id = "manual-aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
+	path := "/v1/cron/manual-task/run-now/" + id
+	type response struct {
+		Status string `json:"status"`
+		CronRunNowResponse
+	}
+	get := func(server *httptest.Server, method, route string) response {
+		t.Helper()
+		var got response
+		if code := doCronJSON(t, server.URL+route, method, nil, &got); code != http.StatusOK {
+			t.Fatalf("%s %s status %d", method, route, code)
+		}
+		return got
+	}
+	if got := get(server, http.MethodGet, path); got.Status != "missing" {
+		t.Fatalf("read-only query unexpectedly admitted a run: %+v", got)
+	}
+	first := get(server, http.MethodPost, path)
+	if first.Status != "admitted" || first.ExecutionID != id || first.StartedAt <= 0 {
+		t.Fatalf("wrong admission: %+v", first)
+	}
+	completed := waitCronRuns(t, server.URL, "manual-task", func(runs []CronRunRecord) bool {
+		return len(runs) == 1 && runs[0].State == "done"
+	})
+	if !completed[0].Success || requests.Load() != 1 {
+		t.Fatalf("expected one completed request, got %d requests and %+v", requests.Load(), completed)
+	}
+	if repeat := get(server, http.MethodPost, path); repeat != first {
+		t.Fatalf("same execution returned a different receipt: %+v", repeat)
+	}
+	if other := get(server, http.MethodGet, "/v1/cron/other/run-now/"+id); other.Status != "missing" {
+		t.Fatalf("another task could read the receipt: %+v", other)
+	}
+	server.Close()
+	backend.Close()
+	restarted, restartedHTTP := newServer()
+	defer restarted.Close()
+	defer restartedHTTP.Close()
+	if got := get(restartedHTTP, http.MethodGet, path); got != first {
+		t.Fatalf("receipt lost after restart: %+v", got)
+	}
+	if repeat := get(restartedHTTP, http.MethodPost, path); repeat != first {
+		t.Fatalf("same execution after restart returned a different receipt: %+v", repeat)
+	}
+	var history struct {
+		Runs []CronRunRecord `json:"runs"`
+	}
+	if code := doCronJSON(t, restartedHTTP.URL+"/v1/cron/manual-task/runs", http.MethodGet, nil, &history); code != http.StatusOK ||
+		len(history.Runs) != 1 || history.Runs[0].ID != id || history.Runs[0].Counted || requests.Load() != 1 {
+		t.Fatalf("unexpected executions: %d %+v", code, history)
+	}
+	snapshot := restarted.cron.store.snapshot()
+	if count := snapshot.Tasks[0].RemainingExecutions; count == nil || *count != 1 {
+		t.Fatalf("manual run changed the scheduled count: %v", count)
+	}
+}
