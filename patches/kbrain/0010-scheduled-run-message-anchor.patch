+func (s *Server) cronRunAnchor(w http.ResponseWriter, taskID, executionID string) {
+	w.Header().Set("Cache-Control", "no-store")
+	runs, err := s.cron.store.runs(taskID, cronRunLimit)
+	if err != nil {
+		writeJSONError(w, http.StatusNotFound, err.Error())
+		return
+	}
+	for _, run := range runs {
+		if run.ID != executionID {
+			continue
+		}
+		anchor := map[string]string{}
+		if validID(run.SessionID) && run.RunID != "" {
+			records, err := s.loadCheckpoints(run.SessionID)
+			if err != nil {
+				writeJSONError(w, http.StatusInternalServerError, "cannot read run checkpoint")
+				return
+			}
+			for _, record := range records {
+				if record.RunID != run.RunID || record.TurnID == "" {
+					continue
+				}
+				// A rewind or edit can retire a checkpoint's original message.
+				if _, err := s.store.MessageSequence(run.SessionID, record.TurnID); err == nil {
+					anchor = map[string]string{"sessionId": run.SessionID, "runId": run.RunID, "messageId": record.TurnID}
+					break
+				}
+			}
+		}
+		writeJSON(w, http.StatusOK, anchor)
+		return
+	}
+	writeJSONError(w, http.StatusNotFound, "cron execution not found")
+}
