diff --git a/internal/mcp/selfhost_fixture_test.go b/internal/mcp/selfhost_fixture_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..d8f09f7c0be265b04ad89536dbd2816153be4a51
--- /dev/null
+++ b/internal/mcp/selfhost_fixture_test.go
@@ -0,0 +1,65 @@
+package mcp
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+)
+
+const selfHostFixturePrefix = "kbrain-selfhost-fixture-"
+
+var selfHostBuild struct {
+	once              sync.Once
+	directory, binary string
+	err               error
+}
+
+func TestMain(m *testing.M) {
+	code := m.Run()
+	if selfHostBuild.directory != "" {
+		directory, err := filepath.Abs(selfHostBuild.directory)
+		temporary, tempErr := filepath.Abs(os.TempDir())
+		if err != nil || tempErr != nil || filepath.Dir(directory) != filepath.Clean(temporary) || !strings.HasPrefix(filepath.Base(directory), selfHostFixturePrefix) {
+			fmt.Fprintln(os.Stderr, "refusing to remove an unowned self-host fixture directory")
+			code = 1
+		} else if err := os.RemoveAll(directory); err != nil {
+			fmt.Fprintln(os.Stderr, "failed to remove the owned self-host fixture directory")
+			code = 1
+		}
+	}
+	os.Exit(code)
+}
+
+func selfHostBinary(t *testing.T) string {
+	t.Helper()
+	selfHostBuild.once.Do(func() {
+		t.Log("building shared self-host CLI with CGO=0, trimpath and production stripped linking")
+		started := time.Now()
+		selfHostBuild.directory, selfHostBuild.err = os.MkdirTemp("", selfHostFixturePrefix)
+		if selfHostBuild.err != nil {
+			return
+		}
+		selfHostBuild.binary = filepath.Join(selfHostBuild.directory, "k-brain")
+		if runtime.GOOS == "windows" {
+			selfHostBuild.binary += ".exe"
+		}
+		command := exec.CommandContext(context.Background(), "go", "build", "-trimpath", "-ldflags", "-s -w", "-o", selfHostBuild.binary, "../../cmd/kn")
+		command.Env = append(os.Environ(), "CGO_ENABLED=0")
+		if out, err := command.CombinedOutput(); err != nil {
+			selfHostBuild.err = fmt.Errorf("build self-host CLI: %w\n%s", err, out)
+			return
+		}
+		t.Logf("shared self-host CLI built in %s", time.Since(started))
+	})
+	if selfHostBuild.err != nil {
+		t.Fatal(selfHostBuild.err)
+	}
+	return selfHostBuild.binary
+}
