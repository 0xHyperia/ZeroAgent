new file mode 100644
index 0000000..bb9c9c8
--- /dev/null
+++ b/internal/backend/device_skills_test.go
@@ -0,0 +1,117 @@
+package backend
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"github.com/Stack-Cairn/K-brain/internal/protocol"
+	"github.com/Stack-Cairn/K-brain/internal/session"
+)
+
+func TestAccountSkillSnapshotResolvesAtAdmissionAndPreservesOriginalHistory(t *testing.T) {
+	const token = "fixture-device-capability-0123456789abcdef"
+	const marker = "fixed-revision-device-fixture"
+	var calls atomic.Int32
+	var retired atomic.Bool
+	native := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		var input struct {
+			Protocol   string           `json:"protocol"`
+			References []deviceSkillRef `json:"references"`
+		}
+		if r.Method != http.MethodPost || r.URL.Path != "/v1/device/skills" ||
+			r.Header.Get("Authorization") != "Bearer "+token ||
+			json.NewDecoder(r.Body).Decode(&input) != nil || input.Protocol != deviceSkillProtocol ||
+			len(input.References) != 1 || input.References[0] != (deviceSkillRef{"shared-package", 2, "review"}) {
+			t.Error("unexpected account skill request")
+			http.Error(w, "invalid fixture request", http.StatusBadRequest)
+			return
+		}
+		if retired.Load() {
+			http.NotFound(w, r)
+			return
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"skills": []deviceSkillSnapshot{{
+			deviceSkillRef: input.References[0],
+			Entry:          "SKILL.md",
+			Files:          map[string]string{"SKILL.md": marker, "references/notes.md": "source note"},
+		}}})
+	}))
+	defer native.Close()
+	t.Setenv("ZEROAGENT_DEVICE_SKILL_ENDPOINT", native.URL+"/v1/device/skills")
+	t.Setenv("ZEROAGENT_DEVICE_SKILL_TOKEN", token)
+	resolver, err := DeviceSkillResolverFromEnv()
+	if err != nil || resolver == nil || os.Getenv("ZEROAGENT_DEVICE_SKILL_TOKEN") != "" ||
+		os.Getenv("ZEROAGENT_DEVICE_SKILL_ENDPOINT") != "" {
+		t.Fatal("private resolver capability was not consumed", err)
+	}
+	store, err := session.Open(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer store.Close()
+	model := &scriptedClient{response: "review complete"}
+	service, server := newTestServer(t, store, t.TempDir(), model)
+	service.deviceSkillResolver = resolver
+	sess := createTestSession(t, server.URL)
+	path := server.URL + "/v1/sessions/" + sess.ID + "/runs"
+	prompt := "Use [Review](zeroagent-skill:shared-package/2/review)."
+	input := protocol.PromptRequest{ClientRequestID: "account-skill", Prompt: prompt}
+	var accepted protocol.RunAccepted
+	first := postJSON(t, http.DefaultClient, path, input, &accepted)
+	first.Body.Close()
+	if first.StatusCode != http.StatusAccepted {
+		t.Fatalf("first status = %d", first.StatusCode)
+	}
+	waitForRunTerminal(t, server.URL, sess.ID, accepted.RunID)
+	model.mu.Lock()
+	var userContext string
+	for _, request := range model.requests {
+		for _, message := range request {
+			if message.Role == "user" {
+				userContext += message.Content
+				for _, part := range message.Parts {
+					userContext += part.Text
+				}
+			}
+		}
+	}
+	model.mu.Unlock()
+	if !strings.Contains(userContext, marker) || !strings.Contains(userContext, "source note") {
+		t.Fatalf("model did not receive the fixed instruction and its resource: %q", userContext)
+	}
+	_, history, err := store.Load(sess.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, message := range history {
+		if message.Role == "user" {
+			found = found || message.Content == prompt
+			if strings.Contains(message.Content, marker) {
+				t.Fatal("model-only skill context appeared in user message history")
+			}
+		}
+	}
+	if !found {
+		t.Fatal("the original user message was not retained")
+	}
+	retired.Store(true)
+	var replay protocol.RunAccepted
+	retry := postJSON(t, http.DefaultClient, path, input, &replay)
+	retry.Body.Close()
+	if retry.StatusCode != http.StatusOK || replay != accepted || calls.Load() != 1 {
+		t.Fatalf("accepted request resolved again: status %d, lookups %d", retry.StatusCode, calls.Load())
+	}
+	input.ClientRequestID = "new-account-skill"
+	unavailable := postJSON(t, http.DefaultClient, path, input, nil)
+	unavailable.Body.Close()
+	if unavailable.StatusCode != http.StatusUnprocessableEntity || calls.Load() != 2 {
+		t.Fatalf("unavailable revision accepted: status %d, lookups %d", unavailable.StatusCode, calls.Load())
+	}
+}
