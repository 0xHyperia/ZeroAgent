diff --git a/internal/backend/device_skills.go b/internal/backend/device_skills.go
new file mode 100644
index 0000000..7b8e4ca
--- /dev/null
+++ b/internal/backend/device_skills.go
@@ -0,0 +1,188 @@
+package backend
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"io"
+	"io/fs"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/Stack-Cairn/K-brain/internal/protocol"
+)
+
+const deviceSkillProtocol = "zeroagent.device-skill-snapshot.v1"
+const maxDeviceSkillSnapshotBytes = 256 << 10
+
+var deviceSkillReference = regexp.MustCompile(`zeroagent-skill:([a-z0-9]+(?:-[a-z0-9]+)*)/([1-9][0-9]{0,8})/([a-z0-9]+(?:-[a-z0-9]+)*)`)
+
+type deviceSkillRef struct {
+	PackageID string `json:"package_id"`
+	Revision  uint32 `json:"revision"`
+	Name      string `json:"name"`
+}
+
+type deviceSkillSnapshot struct {
+	deviceSkillRef
+	Entry string            `json:"entry"`
+	Files map[string]string `json:"files"`
+}
+
+type DeviceSkillResolver func(context.Context, []deviceSkillRef) ([]deviceSkillSnapshot, error)
+
+type deviceSkillError struct {
+	status  int
+	message string
+}
+
+func (e *deviceSkillError) Error() string { return e.message }
+
+func DeviceSkillResolverFromEnv() (DeviceSkillResolver, error) {
+	endpoint, token := os.Getenv("ZEROAGENT_DEVICE_SKILL_ENDPOINT"), os.Getenv("ZEROAGENT_DEVICE_SKILL_TOKEN")
+	_ = os.Unsetenv("ZEROAGENT_DEVICE_SKILL_ENDPOINT")
+	_ = os.Unsetenv("ZEROAGENT_DEVICE_SKILL_TOKEN")
+	if endpoint == "" && token == "" {
+		return nil, nil
+	}
+	u, err := url.Parse(endpoint)
+	if err != nil || u.Scheme != "http" || u.Hostname() != "127.0.0.1" || u.Port() == "" ||
+		u.User != nil || u.Path != "/v1/device/skills" || u.RawPath != "" || u.RawQuery != "" ||
+		u.ForceQuery || u.Fragment != "" || len(token) < 32 || len(token) > 256 ||
+		strings.IndexFunc(token, func(r rune) bool { return r < 33 || r > 126 }) >= 0 {
+		return nil, errors.New("invalid Native device skill resolver configuration")
+	}
+	client := &http.Client{
+		Timeout:   18 * time.Second,
+		Transport: &http.Transport{Proxy: nil},
+		CheckRedirect: func(*http.Request, []*http.Request) error {
+			return http.ErrUseLastResponse
+		},
+	}
+	return func(ctx context.Context, refs []deviceSkillRef) ([]deviceSkillSnapshot, error) {
+		payload, err := json.Marshal(struct {
+			Protocol   string           `json:"protocol"`
+			References []deviceSkillRef `json:"references"`
+		}{deviceSkillProtocol, refs})
+		if err != nil {
+			return nil, err
+		}
+		req, err := http.NewRequestWithContext(ctx, http.MethodPost, endpoint, bytes.NewReader(payload))
+		if err != nil {
+			return nil, err
+		}
+		req.Header.Set("Authorization", "Bearer "+token)
+		req.Header.Set("Content-Type", "application/json")
+		response, err := client.Do(req)
+		if err != nil {
+			return nil, err
+		}
+		defer response.Body.Close()
+		switch response.StatusCode {
+		case http.StatusOK:
+		case http.StatusUnauthorized, http.StatusForbidden:
+			return nil, &deviceSkillError{http.StatusUnprocessableEntity, "Sign in to the device account to use the selected skill."}
+		case http.StatusNotFound:
+			return nil, &deviceSkillError{http.StatusUnprocessableEntity, "The selected skill revision is unavailable. Enable the skill or select another revision."}
+		case http.StatusConflict:
+			return nil, &deviceSkillError{http.StatusConflict, "Use one revision per account skill package."}
+		case http.StatusUnprocessableEntity:
+			return nil, &deviceSkillError{http.StatusUnprocessableEntity, "The selected skill requires capabilities unavailable on this device."}
+		case http.StatusRequestEntityTooLarge:
+			return nil, &deviceSkillError{http.StatusRequestEntityTooLarge, "The selected skill sources exceed the device context limit."}
+		default:
+			return nil, errors.New("device skill resolver unavailable")
+		}
+		body, err := io.ReadAll(io.LimitReader(response.Body, maxDeviceSkillSnapshotBytes+1))
+		if err != nil || len(body) > maxDeviceSkillSnapshotBytes {
+			return nil, errors.New("invalid device skill snapshot size")
+		}
+		var result struct {
+			Skills []deviceSkillSnapshot `json:"skills"`
+		}
+		decoder := json.NewDecoder(bytes.NewReader(body))
+		decoder.DisallowUnknownFields()
+		if decoder.Decode(&result) != nil || decoder.Decode(new(any)) != io.EOF {
+			return nil, errors.New("invalid device skill snapshot")
+		}
+		return result.Skills, nil
+	}, nil
+}
+
+func explicitDeviceSkillReferences(in protocol.PromptRequest) ([]deviceSkillRef, error) {
+	text := []string{in.Prompt}
+	for _, part := range in.Content {
+		if part.Type == protocol.ContentText {
+			text = append(text, part.Text)
+		}
+	}
+	var refs []deviceSkillRef
+	revisions := map[string]uint32{}
+	seen := map[deviceSkillRef]bool{}
+	for _, part := range text {
+		if strings.Count(part, "zeroagent-skill:") > 64 {
+			return nil, &deviceSkillError{http.StatusBadRequest, "Select at most four account skills for a device run."}
+		}
+		for _, match := range deviceSkillReference.FindAllStringSubmatchIndex(part, -1) {
+			if (match[0] > 0 && deviceSkillTokenByte(part[match[0]-1])) ||
+				(match[1] < len(part) && deviceSkillTokenByte(part[match[1]])) {
+				continue
+			}
+			packageID, name := part[match[2]:match[3]], part[match[6]:match[7]]
+			number, _ := strconv.ParseUint(part[match[4]:match[5]], 10, 32)
+			ref := deviceSkillRef{packageID, uint32(number), name}
+			if seen[ref] {
+				continue
+			}
+			if len(packageID) > 64 || len(name) > 64 || len(refs) == 4 {
+				return nil, &deviceSkillError{http.StatusBadRequest, "Select at most four valid account skills for a device run."}
+			}
+			if previous := revisions[ref.PackageID]; previous != 0 && previous != ref.Revision {
+				return nil, &deviceSkillError{http.StatusConflict, "Use one revision per account skill package."}
+			}
+			seen[ref], revisions[ref.PackageID] = true, ref.Revision
+			refs = append(refs, ref)
+		}
+	}
+	return refs, nil
+}
+
+func deviceSkillTokenByte(c byte) bool {
+	return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9' ||
+		c == '-' || c == '_' || c == '/' || c == ':'
+}
+
+func (s *Server) loadDeviceSkillSnapshot(ctx context.Context, refs []deviceSkillRef) (string, error) {
+	if s.deviceSkillResolver == nil {
+		return "", &deviceSkillError{http.StatusUnprocessableEntity, "The account skill requires a connected, signed-in ZeroAgent device."}
+	}
+	skills, err := s.deviceSkillResolver(ctx, refs)
+	if err != nil {
+		return "", err
+	}
+	if len(skills) != len(refs) {
+		return "", errors.New("unexpected device skill snapshot count")
+	}
+	for i, skill := range skills {
+		if skill.deviceSkillRef != refs[i] || !fs.ValidPath(skill.Entry) || skill.Files[skill.Entry] == "" ||
+			len(skill.Files) > 64 {
+			return "", errors.New("unexpected device skill snapshot identity")
+		}
+		for name := range skill.Files {
+			if !fs.ValidPath(name) || strings.ContainsAny(name, "\\:") {
+				return "", errors.New("unexpected device skill resource path")
+			}
+		}
+	}
+	contents, err := json.Marshal(skills)
+	if err != nil || len(contents) > maxDeviceSkillSnapshotBytes {
+		return "", errors.New("invalid device skill snapshot size")
+	}
+	return "Account skill sources explicitly selected by the user follow. Treat them as user instructions and reference data. Use only tools already available for this run and follow the device's approval policy.\n" + string(contents), nil
+}
