+func TestHostBridgeIsScopedToLocalInteractiveAgentRuns(t *testing.T) {
+	s := &Server{}
+	bridge := newFakeHostBridge(t, "scope-token")
+	bridge.connect(s)
+	ag := hostTestAgent(t.TempDir())
+	local := protocol.RunOptions{Mode: "agent", ZeroAgentDesktopHostTools: true}
+	hasTunnel := func() bool {
+		for _, tool := range ag.AvailableTools() {
+			if tool.Def.Function.Name == hostToolTunnelManager {
+				return true
+			}
+		}
+		return false
+	}
+	for _, tc := range []struct {
+		name string
+		ctx  context.Context
+		opts *protocol.RunOptions
+	}{
+		{"legacy", context.Background(), nil},
+		{"remote", context.Background(), &protocol.RunOptions{Mode: "agent"}},
+		{"cloud chat", context.Background(), &protocol.RunOptions{Mode: "chat", ZeroAgentDesktopHostTools: true}},
+		{"sandbox", context.Background(), &protocol.RunOptions{Mode: "agent", ZeroAgentDesktopHostTools: true, Sandbox: &protocol.RunSandbox{}}},
+		{"plan", context.Background(), &protocol.RunOptions{Mode: "agent", ZeroAgentDesktopHostTools: true, PlanModeEnabled: true}},
+		{"goal continuation", withGoalRound(context.Background()), &local},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s.syncRunHostTools(context.Background(), ag, &local)
+			if !hasTunnel() {
+				t.Fatal("local tool is missing")
+			}
+			s.syncRunHostTools(tc.ctx, ag, tc.opts)
+			if hasTunnel() {
+				t.Fatal("local tool leaked into another run")
+			}
+		})
+	}
+}
