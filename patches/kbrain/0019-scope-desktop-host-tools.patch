+	bridge.connect(s)
+	tool := s.tunnelManagerTool(hostTestAgent(t.TempDir()))
+	result, err := tool.Run(allowGate(context.Background()), json.RawMessage(`{"action":"create","targetUrl":"http://localhost:3000"}`))
+	if err != nil || result != "Remote tunnel tun-1 was saved; Gateway registration is pending." {
+		t.Fatalf("offline create = %q, %v", result, err)
+	}
+}
