+func TestHostBridgeTunnelCreateKeepsOfflineReceiptPending(t *testing.T) {
+	s := &Server{}
+	bridge := newFakeHostBridge(t, "pending-token")
+	bridge.override = func(_ *http.Request, command string, _ map[string]any) (int, any, bool) {
+		if command != "gateway_tunnel_state" {
