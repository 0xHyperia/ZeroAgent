+func TestClawHubHTTPForwardsCatalogParameters(t *testing.T) {
+	t.Setenv(datapath.LiveAgentHomeEnv, t.TempDir())
+	registry := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/api/v1/skills" || r.URL.Query().Get("sort") != "stars" || r.URL.Query().Get("limit") != "2" || r.URL.Query().Get("cursor") != "next+/=" {
+			t.Errorf("request parameters lost: %s", r.URL)
+		}
+		fmt.Fprint(w, `{"items":[{"slug":"fixture","ownerHandle":"publisher","latestVersion":{"version":"1.0.0"}}],"nextCursor":"third"}`)
+	}))
+	defer registry.Close()
+	m, err := skills.NewManager()
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = m.SetHTTPClient(registry.Client())
+	_ = m.SetStoreURL(registry.URL)
+	store, err := session.Open(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s, err := New(Options{Store: store, Factory: func(_ context.Context, _ string, model protocol.ModelRef) (*agent.Agent, error) {
+		return agent.New(&scriptedClient{response: "ok"}, model.Model, 100, "system"), nil
+	}, EventDir: t.TempDir(), Token: "fixture-token"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	req := httptest.NewRequest(http.MethodGet, "/v1/skills/store/search?sort=stars&limit=2&cursor=next%2B%2F%3D", nil)
+	req.Header.Set("Authorization", "Bearer fixture-token")
+	res := httptest.NewRecorder()
+	s.ServeHTTP(res, req)
+	if res.Code != 200 || !strings.Contains(res.Body.String(), `"nextCursor":"third"`) || !strings.Contains(res.Body.String(), `"latestVersion":"1.0.0"`) {
+		t.Fatalf("catalog response %d: %s", res.Code, res.Body)
+	}
+	for _, limit := range []string{"bad", "0", "201"} {
+		req = httptest.NewRequest(http.MethodGet, "/v1/skills/store/search?limit="+limit, nil)
+		req.Header.Set("Authorization", "Bearer fixture-token")
+		res = httptest.NewRecorder()
+		s.ServeHTTP(res, req)
+		if res.Code != 400 {
+			t.Fatalf("invalid limit accepted: %s (%d)", limit, res.Code)
+		}
+	}
+}
