+++ b/internal/skills/clawhub_download.go
@@ -0,0 +1,65 @@
+package skills
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"regexp"
+	"strings"
+)
+
+var clawHubRepo = regexp.MustCompile(`^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$`)
+var clawHubCommit = regexp.MustCompile(`^[a-fA-F0-9]{40}$`)
+var clawHubHash = regexp.MustCompile(`^[a-fA-F0-9]{64}$`)
+
+// Hosted skills are ZIPs. A current GitHub-backed skill instead returns this
+// public registry handoff. Only its exact commit archive and skill subtree are used.
+func (m *Manager) installClawHubHandoff(ctx context.Context, source, name, conflict string, meta *SourceMetadata, progress func(int64, int64)) (InstallResult, bool, error) {
+	f, err := os.Open(source)
+	if err != nil {
+		return InstallResult{}, false, err
+	}
+	body, err := io.ReadAll(io.LimitReader(f, 64<<10))
+	_ = f.Close()
+	if err != nil {
+		return InstallResult{}, false, err
+	}
+	if !strings.HasPrefix(strings.TrimSpace(string(body)), "{") {
+		return InstallResult{}, false, nil
+	}
+	var descriptor struct{ SourceRef, Repo, Commit, Path, ContentHash, ArchiveURL string }
+	if err = json.Unmarshal(body, &descriptor); err != nil {
+		return InstallResult{}, true, fmt.Errorf("ClawHub download descriptor: %w", err)
+	}
+	if descriptor.SourceRef != "public-github" || !clawHubRepo.MatchString(descriptor.Repo) || strings.Contains(descriptor.Repo, "..") || !clawHubCommit.MatchString(descriptor.Commit) || !clawHubHash.MatchString(descriptor.ContentHash) {
+		return InstallResult{}, true, errors.New("invalid ClawHub GitHub handoff")
+	}
+	folder := strings.TrimSuffix(descriptor.Path, "/")
+	if folder == "" {
+		folder = "."
+	}
+	if folder != "" && folder != "." {
+		if _, err = childPath(folder); err != nil {
+			return InstallResult{}, true, err
+		}
+	}
+	expected := "https://api.github.com/repos/" + descriptor.Repo + "/zipball/" + descriptor.Commit
+	if descriptor.ArchiveURL != expected {
+		return InstallResult{}, true, errors.New("ClawHub GitHub archive does not match the pinned repository and commit")
+	}
+	archive, err := m.download(ctx, expected, progress)
+	if err != nil {
+		return InstallResult{}, true, err
+	}
+	defer os.Remove(archive)
+	extracted, err := m.zipSourceFolder(archive, folder)
+	if err != nil {
+		return InstallResult{}, true, err
+	}
+	defer os.RemoveAll(extracted)
+	result, err := m.installDir(ctx, extracted, name, meta, conflict)
+	return result, true, err
+}
