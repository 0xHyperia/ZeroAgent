+
+func (m *Manager) registryBase() string {
+	managedWriteMu.Lock()
+	defer managedWriteMu.Unlock()
+	return m.storeURL
+}
+
+const maxClawHubResponse = 2 << 20
+
+type clawHubItem struct {
+	Slug, DisplayName, Summary, OwnerHandle, Version string
+	Topics                                           []string
+	UpdatedAt                                        *int64
+	LatestVersion                                    json.RawMessage
+	Tags                                             struct{ Latest string }
+	Owner                                            struct{ Handle string }
+	Stats                                            struct{ Downloads, Stars, InstallsCurrent, Installs int64 }
+	Downloads, Stars, InstallsCurrent                int64
+}
+
+func (m *Manager) clawHubDownloadURL(slug, owner, version string) string {
+	q := url.Values{"slug": {slug}, "ownerHandle": {owner}}
+	if version == "" || version == "latest" {
+		q.Set("tag", "latest")
+	} else {
+		q.Set("version", version)
+	}
+	return m.registryBase() + "/api/v1/download?" + q.Encode()
+}
+
+func remoteHTTPError(resp *http.Response, label string) error {
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 512))
+	detail := strings.TrimSpace(string(body))
+	if retry := resp.Header.Get("Retry-After"); resp.StatusCode == 429 && retry != "" {
+		detail += " (Retry-After: " + retry + ")"
+	}
+	return fmt.Errorf("%s returned HTTP %d: %s", label, resp.StatusCode, detail)
+}
+
+func (m *Manager) searchStore(ctx context.Context, a map[string]any) ([]ClawHubCard, string, error) {
+	query := strings.TrimSpace(stringArg(a, "query"))
+	endpoint := "/api/v1/skills"
+	q := url.Values{"nonSuspiciousOnly": {"true"}}
+	limit := intArg(a, "limit", 24)
+	maximum := 200
+	if query != "" {
+		endpoint = "/api/v1/search"
+		q.Set("q", query)
+		maximum = 100
+	} else {
+		order := stringArg(a, "sort")
+		if order == "" {
+			order = "downloads"
+		}
+		switch order {
+		case "downloads", "stars", "installs", "updated", "newest":
+		default:
+			return nil, "", errors.New("invalid ClawHub sort")
+		}
+		q.Set("sort", order)
+		if cursor := stringArg(a, "cursor"); cursor != "" {
+			q.Set("cursor", cursor)
+		}
+	}
+	if limit < 1 || limit > maximum {
+		return nil, "", fmt.Errorf("ClawHub limit must be between 1 and %d", maximum)
+	}
+	q.Set("limit", strconv.Itoa(limit))
+	if owner := stringArg(a, "ownerHandle"); owner != "" {
+		q.Set("ownerHandle", owner)
+	}
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, m.registryBase()+endpoint+"?"+q.Encode(), nil)
+	if err != nil {
+		return nil, "", err
+	}
+	req.Header.Set("Accept", "application/json")
+	resp, err := m.client.Do(req)
+	if err != nil {
+		return nil, "", fmt.Errorf("ClawHub: %w", err)
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return nil, "", remoteHTTPError(resp, "ClawHub request")
+	}
+	body, err := io.ReadAll(io.LimitReader(resp.Body, maxClawHubResponse+1))
+	if err != nil {
+		return nil, "", fmt.Errorf("ClawHub: %w", err)
+	}
+	if len(body) > maxClawHubResponse {
+		return nil, "", errors.New("ClawHub response is too large")
+	}
+	var root struct {
+		Items, Results *[]clawHubItem
+		NextCursor     string
+	}
+	if err = json.Unmarshal(body, &root); err != nil {
+		return nil, "", fmt.Errorf("ClawHub response: %w", err)
+	}
+	items, cursor := root.Items, root.NextCursor
+	if query != "" {
+		items, cursor = root.Results, ""
+	}
+	if items == nil {
+		return nil, "", errors.New("ClawHub response is missing its item array")
+	}
+	out := make([]ClawHubCard, 0, len(*items))
+	for _, item := range *items {
+		if item.Slug == "" {
+			return nil, "", errors.New("ClawHub response has an empty skill slug")
+		}
+		version := item.Version
+		if len(item.LatestVersion) > 0 && string(item.LatestVersion) != "null" {
+			var latest struct{ Version string }
+			if json.Unmarshal(item.LatestVersion, &latest) == nil {
+				version = latest.Version
+			} else {
+				_ = json.Unmarshal(item.LatestVersion, &version)
+			}
+		}
+		if version == "" {
+			version = item.Tags.Latest
+		}
+		owner := item.OwnerHandle
+		if owner == "" {
+			owner = item.Owner.Handle
+		}
+		if item.DisplayName == "" {
+			item.DisplayName = item.Slug
+		}
+		if item.Topics == nil {
+			item.Topics = []string{}
+		}
+		downloads, stars, installs := item.Stats.Downloads, item.Stats.Stars, item.Stats.InstallsCurrent
+		if downloads == 0 {
+			downloads = item.Downloads
+		}
+		if stars == 0 {
+			stars = item.Stars
+		}
+		if installs == 0 {
+			installs = item.Stats.Installs
+		}
+		if installs == 0 {
+			installs = item.InstallsCurrent
+		}
+		web := ""
+		if owner != "" {
+			web = m.registryBase() + "/" + url.PathEscape(owner) + "/skills/" + url.PathEscape(item.Slug)
+		}
+		out = append(out, ClawHubCard{Slug: item.Slug, DisplayName: item.DisplayName, Summary: item.Summary, LatestVersion: version, OwnerHandle: owner, Downloads: downloads, Stars: stars, InstallsCurrent: installs, UpdatedAt: item.UpdatedAt, Topics: item.Topics, WebURL: web, DownloadURL: m.clawHubDownloadURL(item.Slug, owner, version)})
+	}
+	return out, cursor, nil
+}
