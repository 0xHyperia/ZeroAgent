+func skillZip(t *testing.T, path, name string) []byte {
+	t.Helper()
+	var b bytes.Buffer
+	z := zip.NewWriter(&b)
+	f, err := z.Create(path + "SKILL.md")
+	if err != nil {
+		t.Fatal(err)
+	}
+	fmt.Fprintf(f, "---\nname: %s\ndescription: A registry fixture\n---\n\nFixture instructions, never execute scripts.\n", name)
+	if err = z.Close(); err != nil {
+		t.Fatal(err)
+	}
+	return b.Bytes()
+}
