+func TestClawHubVersionedAndAsyncInstallation(t *testing.T) {
+	payload := skillZip(t, "", "registry-fixture")
+	m := clawhubFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		q := r.URL.Query()
+		if r.URL.Path != "/api/v1/download" || q.Get("slug") != "registry-fixture" || q.Get("ownerHandle") != "publisher" || q.Get("version") != "2.3.4" || q.Has("tag") {
+			t.Errorf("wrong version download: %s", r.URL)
+		}
+		w.Header().Set("Content-Type", "application/zip")
+		_, _ = w.Write(payload)
+	})
+	args := map[string]any{"action": "clawhub_install", "ownerHandle": "publisher", "slug": "registry-fixture", "version": "2.3.4", "conflict": "fail"}
+	got, err := m.Manage(context.Background(), args)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(got.Installed) != 1 {
+		t.Fatalf("no install: %+v", got)
+	}
+	b, err := os.ReadFile(filepath.Join(m.root, "registry-fixture", "_meta.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var meta SourceMetadata
+	_ = json.Unmarshal(b, &meta)
+	if meta.Registry != "clawhub" || meta.OwnerHandle != "publisher" || meta.Version != "2.3.4" {
+		t.Fatalf("source metadata: %s", b)
+	}
+	if _, err = m.Manage(context.Background(), args); err == nil {
+		t.Fatal("conflict=fail overwritten")
+	}
+	if _, err = m.Delete("registry-fixture"); err != nil {
+		t.Fatal(err)
+	}
+	// This is the exact UI install_start contract: source plus owner, slug and version.
+	args["action"] = "install_start"
+	args["source"] = m.storeURL + "/api/v1/download?slug=registry-fixture&ownerHandle=publisher&tag=latest"
+	got, err = m.Manage(context.Background(), args)
+	if err != nil {
+		t.Fatal(err)
+	}
+	j := waitClawHubJob(t, m, got.InstallJob.JobID)
+	if j.Phase != "completed" || j.DownloadedBytes != int64(len(payload)) {
+		t.Fatalf("async install: %+v", j)
+	}
+	entries, _ := os.ReadDir(m.root)
+	for _, e := range entries {
+		if strings.HasPrefix(e.Name(), ".staging") {
+			t.Fatalf("leaked staging: %s", e.Name())
+		}
+	}
+}
