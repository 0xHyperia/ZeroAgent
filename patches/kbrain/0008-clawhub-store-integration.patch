+func waitClawHubJob(t *testing.T, m *Manager, id string) *Job {
+	t.Helper()
+	deadline := time.Now().Add(5 * time.Second)
+	for time.Now().Before(deadline) {
+		j, e := m.job(id)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if j.FinishedAt > 0 {
+			return j
+		}
+		time.Sleep(5 * time.Millisecond)
+	}
+	t.Fatal("install job did not finish")
+	return nil
+}
