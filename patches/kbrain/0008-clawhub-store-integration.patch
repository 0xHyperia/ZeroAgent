+				fmt.Fprint(w, `{"items":[{"slug":"example","displayName":"Example","summary":"A skill","ownerHandle":"publisher","topics":["coding"],"stats":{"downloads":123,"stars":9,"installsCurrent":7},"updatedAt":1793000000000,"latestVersion":{"version":"2.3.4"}}],"nextCursor":"third"}`)
+			})
+			got, err := m.Manage(context.Background(), map[string]any{"action": "clawhub_search", "sort": order, "limit": 2, "cursor": "page+/=two"})
