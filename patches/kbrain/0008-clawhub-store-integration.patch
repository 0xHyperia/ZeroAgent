+)
+
+type clawHubRoundTrip func(*http.Request) (*http.Response, error)
+
+func (f clawHubRoundTrip) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+func TestClawHubGitHubHandoffPinnedSubtree(t *testing.T) {
+	const commit = "0123456789012345678901234567890123456789"
+	payload := skillZip(t, "repo-hash/skills/fixture/", "github-fixture")
+	for _, tc := range []struct {
+		name, path, archive string
+		ok                  bool
+	}{
+		{"valid", "skills/fixture", "https://api.github.com/repos/publisher/repo/zipball/" + commit, true},
+		{"escape", "../fixture", "https://api.github.com/repos/publisher/repo/zipball/" + commit, false},
+		{"foreign-host", "skills/fixture", "https://other.example/repo.zip", false},
+		{"mutable-branch", "skills/fixture", "https://api.github.com/repos/publisher/repo/zipball/main", false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := clawhubFixture(t, func(w http.ResponseWriter, r *http.Request) {
+				_ = json.NewEncoder(w).Encode(map[string]any{"sourceRef": "public-github", "repo": "publisher/repo", "commit": commit, "path": tc.path, "contentHash": strings.Repeat("a", 64), "archiveUrl": tc.archive})
+			})
+			base := m.client.Transport
+			downloads := 0
+			m.client.Transport = clawHubRoundTrip(func(r *http.Request) (*http.Response, error) {
+				if r.URL.Host == "api.github.com" {
+					downloads++
+					if r.URL.String() != "https://api.github.com/repos/publisher/repo/zipball/"+commit {
+						t.Errorf("unpinned URL: %s", r.URL)
+					}
+					return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"application/zip"}}, Body: io.NopCloser(bytes.NewReader(payload)), ContentLength: int64(len(payload))}, nil
+				}
+				return base.RoundTrip(r)
+			})
+			got, err := m.Manage(context.Background(), map[string]any{"action": "clawhub_install", "slug": "github-fixture", "ownerHandle": "publisher"})
+			if tc.ok {
+				if err != nil || len(got.Installed) != 1 || downloads != 1 {
+					t.Fatalf("handoff failed: %+v %v downloads=%d", got, err, downloads)
+				}
+			} else if err == nil || downloads != 0 {
+				t.Fatalf("unsafe handoff accepted: %v downloads=%d", err, downloads)
+			}
+		})
+	}
+}
+
+func clawhubFixture(t *testing.T, handler http.HandlerFunc) *Manager {
+	t.Helper()
+	t.Setenv("LIVEAGENT_HOME", t.TempDir())
+	srv := httptest.NewTLSServer(handler)
+	t.Cleanup(srv.Close)
+	m, err := NewManager()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = m.SetHTTPClient(srv.Client()); err != nil {
+		t.Fatal(err)
+	}
+	if err = m.SetStoreURL(srv.URL); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func TestClawHubBrowseSortCursorAndMetadata(t *testing.T) {
+	for _, order := range []string{"downloads", "stars", "installs", "updated", "newest"} {
