+func TestClawHubCancellationCleansPartialDownload(t *testing.T) {
+	entered := make(chan struct{})
+	m := clawhubFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/zip")
+		_, _ = w.Write([]byte("PK\x03\x04"))
+		w.(http.Flusher).Flush()
+		close(entered)
+		<-r.Context().Done()
+	})
+	got, err := m.Manage(context.Background(), map[string]any{"action": "install_start", "source": m.storeURL + "/api/v1/download?slug=slow&ownerHandle=publisher", "slug": "slow", "ownerHandle": "publisher"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		t.Fatal("download did not start")
+	}
+	if _, err = m.cancelJob(got.InstallJob.JobID); err != nil {
+		t.Fatal(err)
+	}
+	if j := waitClawHubJob(t, m, got.InstallJob.JobID); j.Phase != "cancelled" {
+		t.Fatalf("cancel: %+v", j)
+	}
+	entries, _ := os.ReadDir(m.root)
+	for _, e := range entries {
+		if strings.HasPrefix(e.Name(), ".staging") {
+			t.Fatalf("leaked partial: %s", e.Name())
+		}
+	}
+}
