diff --git a/internal/backend/prompt_cache_settings_test.go b/internal/backend/prompt_cache_settings_test.go
new file mode 100644
index 0000000..1689b09
--- /dev/null
+++ b/internal/backend/prompt_cache_settings_test.go
@@ -0,0 +1,87 @@
+package backend
+
+import (
+	"encoding/json"
+	"github.com/Stack-Cairn/K-brain/internal/config"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+)
+
+func TestInheritedModelDefaultsHaveStableReadVersions(t *testing.T) {
+	cfg := &config.Config{Providers: map[string]config.Provider{"p": {Type: "codex"}}, Models: map[string]config.Model{
+		"z": {ID: "z", Providers: []string{"p"}}, "a": {ID: "a", Providers: []string{"p"}}, "m": {ID: "m", Providers: []string{"p"}},
+	}}
+	for range 64 {
+		if got := projectSettings(cfg).Providers[0].ActiveModels; !reflect.DeepEqual(got, []string{"a", "m", "z"}) {
+			t.Fatalf("unstable implicit enabled list: %v", got)
+		}
+	}
+	provider := cfg.Providers["p"]
+	provider.ActiveModels = []string{"z", "a"}
+	cfg.Providers["p"] = provider
+	if got := projectSettings(cfg).Providers[0].ActiveModels; !reflect.DeepEqual(got, []string{"z", "a"}) {
+		t.Fatalf("explicit enabled order changed: %v", got)
+	}
+}
+
+func TestPromptCacheInheritancePersistsAndClearsWithoutCrossProviderLeaks(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "config.json")
+	store := NewSettingsStore(&config.Config{Providers: map[string]config.Provider{}, Models: map[string]config.Model{}}, func(c *config.Config) error { return c.SaveFile(path) })
+	server := &Server{settings: store}
+	put := func(body string, want int) {
+		t.Helper()
+		out := httptest.NewRecorder()
+		server.handleSettings(out, httptest.NewRequest(http.MethodPut, "/v1/settings", strings.NewReader(body)))
+		if out.Code != want {
+			t.Fatalf("status=%d body=%s", out.Code, out.Body.String())
+		}
+	}
+	put(`{"providers":[{"id":"a","type":"codex","promptCacheHintMode":"auto","models":[{"id":"shared","promptCacheHintMode":"none"}]},{"id":"b","type":"codex","promptCacheHintMode":"openrouter-session","models":[{"id":"shared"}]}]}`, 200)
+	put(`{"providers":[{"id":"a","name":"rename","models":[{"id":"shared"}]},{"id":"b","name":"rename b"}]}`, 200)
+	loaded, err := config.LoadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.Models["shared"].ForProvider("a").PromptCacheHintMode != "none" || loaded.Models["shared"].ForProvider("b").PromptCacheHintMode != "" {
+		t.Fatal("per-provider model override was lost or leaked")
+	}
+	if loaded.Providers["a"].PromptCacheHintMode != "auto" || loaded.Providers["b"].PromptCacheHintMode != "openrouter-session" {
+		t.Fatal("provider choices lost")
+	}
+	server.settings = NewSettingsStore(loaded, func(c *config.Config) error { return c.SaveFile(path) })
+	out := httptest.NewRecorder()
+	server.handleSettings(out, httptest.NewRequest(http.MethodGet, "/v1/settings", nil))
+	var projection settingsProjection
+	if err = json.Unmarshal(out.Body.Bytes(), &projection); err != nil {
+		t.Fatal(err)
+	}
+	if providerModel(t, projection, "a", "shared").PromptCacheHintMode != "none" || providerModel(t, projection, "b", "shared").PromptCacheHintMode != "" {
+		t.Fatal("read projection lost inheritance")
+	}
+	revision := server.settings.Revision()
+	put(`{"providers":[{"id":"a","promptCacheHintMode":"invented"}]}`, 400)
+	put(`{"providers":[{"id":"a","models":[{"id":"shared","promptCacheHintMode":"inherit"}]}]}`, 400)
+	if server.settings.Revision() != revision {
+		t.Fatal("invalid cache choice changed configuration")
+	}
+	put(`{"providers":[{"id":"a","models":[{"id":"shared","promptCacheHintMode":""}]}]}`, 200)
+	loaded, err = config.LoadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.Models["shared"].ForProvider("a").PromptCacheHintMode != "" {
+		t.Fatal("inherit did not clear persisted override")
+	}
+	put(`{"providers":[{"id":"old","type":"codex","promptCachingEnabled":false,"models":[]}]}`, 200)
+	loaded, err = config.LoadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.Providers["old"].PromptCachingEnabled == nil || *loaded.Providers["old"].PromptCachingEnabled {
+		t.Fatal("legacy explicit disable reset")
+	}
+}
