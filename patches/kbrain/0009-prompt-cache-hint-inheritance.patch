+		{"https://team.api.openai.com/v1", ai.APIChatCompletions, "openai-key"},
+		{"https://openrouter.ai/api/v1", ai.APIChatCompletions, "openrouter-session"},
+		{"https://team.openrouter.ai/api/v1", ai.APIChatCompletions, "openrouter-session"},
+		{"https://api.openai.com.attacker.test/v1", ai.APIChatCompletions, "none"},
+		{"https://relay.test/api.openai.com", ai.APIChatCompletions, "none"},
+		{"https://relay.test/openrouter.ai", ai.APIChatCompletions, "none"},
+		{"http://127.0.0.1:1234", ai.APIChatCompletions, "none"},
+	} {
+		t.Run(tc.url+tc.api, func(t *testing.T) {
+			got := resolvePromptCacheHint(config.Provider{Type: "codex", BaseURL: tc.url, API: tc.api, PromptCacheHintMode: "auto"})
