+func TestCacheModelOverrideFollowsActualFailoverDestination(t *testing.T) {
+	ResetFailoverBreakers()
+	var firstKey, secondKey any
+	var firstSession, secondSession string
+	first := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]any
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		firstKey, firstSession = body["prompt_cache_key"], r.Header.Get("x-session-id")
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer first.Close()
+	second := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		var body map[string]any
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		secondKey, secondSession = body["prompt_cache_key"], r.Header.Get("x-session-id")
+		w.Header().Set("Content-Type", "text/event-stream")
+		_, _ = w.Write([]byte("data: {\"choices\":[{\"delta\":{\"content\":\"ok\"},\"finish_reason\":\"stop\"}]}\n\ndata: [DONE]\n\n"))
+	}))
+	defer second.Close()
+	policy := map[string]any{"mode": "off", "failover": map[string]any{"maxSwitches": 1}}
+	model := config.Model{ID: "m", Providers: []string{"a", "b"}, Context: 32768, MaxOut: 256, PromptCacheHintMode: "none"}
+	model.SetProviderMetadata("b", config.Model{Context: 32768, MaxOut: 256, PromptCacheHintMode: "openrouter-session"})
+	cfg := &config.Config{Models: map[string]config.Model{"m": model}, Providers: map[string]config.Provider{
+		"a": {Type: "codex", API: ai.APIChatCompletions, BaseURL: first.URL, APIKey: "fixture", PromptCacheHintMode: "openai-key", RetryPolicy: policy},
+		"b": {Type: "codex", API: ai.APIChatCompletions, BaseURL: second.URL, APIKey: "fixture", PromptCacheHintMode: "none", RetryPolicy: policy},
+	}}
+	route, err := ResolveFailoverRouteContext(t.Context(), cfg, "m", "a", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	route.Client.SetCacheKey("destination-session")
+	_, _, err = route.Client.Stream(t.Context(), ai.Request{Model: "m", MaxTokens: 64, Messages: []ai.Message{{Role: "user", Content: "hi"}}}, func(string) {}, func(string) {}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if firstKey != nil || firstSession != "" || secondKey != nil || secondSession != "destination-session" {
+		t.Fatalf("primary=%v/%q fallback=%v/%q", firstKey, firstSession, secondKey, secondSession)
+	}
+}
