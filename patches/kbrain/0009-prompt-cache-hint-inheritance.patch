diff --git a/internal/routing/prompt_cache_hint.go b/internal/routing/prompt_cache_hint.go
new file mode 100644
index 0000000..4df7832
--- /dev/null
+++ b/internal/routing/prompt_cache_hint.go
@@ -0,0 +1,44 @@
+package routing
+
+import (
+	"github.com/Stack-Cairn/K-brain/internal/ai"
+	"github.com/Stack-Cairn/K-brain/internal/config"
+	"strings"
+)
+
+func providerWithModelCacheHint(provider config.Provider, model config.Model) config.Provider {
+	if model.PromptCacheHintMode != "" {
+		provider.PromptCacheHintMode = model.PromptCacheHintMode
+	}
+	return provider
+}
+
+func officialCacheHost(host, domain string) bool {
+	return host == domain || strings.HasSuffix(host, "."+domain)
+}
+
+// LiveAgent's last pre-Go resolver: Responses carries a session key even behind
+// a relay; unknown Chat Completions endpoints receive no extra hints.
+func resolvePromptCacheHint(provider config.Provider) string {
+	if mode := provider.PromptCacheHintMode; mode != "" && mode != "auto" {
+		return mode
+	}
+	if provider.PromptCacheHintMode == "" && provider.PromptCachingEnabled != nil && !*provider.PromptCachingEnabled {
+		return "none"
+	}
+	api := provider.API
+	if api == "" {
+		api = provider.RequestFormat
+	}
+	if api == ai.APIResponses || (api == "" && provider.Type == "codex") {
+		return "openai-key"
+	}
+	host := ai.CacheEndpointHost(provider.BaseURL)
+	if officialCacheHost(host, "api.openai.com") {
+		return "openai-key"
+	}
+	if officialCacheHost(host, "openrouter.ai") {
+		return "openrouter-session"
+	}
+	return "none"
+}
