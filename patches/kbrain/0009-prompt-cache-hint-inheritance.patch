+func TestOpenRouterModePreservesDeclaredAnthropicBlockTTLWithoutOpenAIFields(t *testing.T) {
+	var body map[string]any
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_ = json.NewDecoder(r.Body).Decode(&body)
+		_, _ = w.Write([]byte(`{"choices":[{"message":{"content":"ok"}}]}`))
+	}))
+	defer server.Close()
+	yes := true
+	client, err := ClientForProvider(config.Provider{Type: "codex", API: ai.APIChatCompletions, BaseURL: server.URL, APIKey: "fixture", PromptCacheHintMode: "openrouter-session", PromptCacheRetention: "long", CacheControlFormat: "anthropic", CacheCapabilities: ai.CacheCapabilities{SupportsLongRetention: &yes}}, "p", 0)
+	if err != nil {
+		t.Fatal(err)
+	}
+	client.SetCacheKey("session")
+	if _, _, err = client.Complete(t.Context(), ai.Request{Model: "claude-fixture", Messages: []ai.Message{{Role: "user", Content: "hi"}}}); err != nil {
+		t.Fatal(err)
+	}
+	if body["prompt_cache_key"] != nil || body["prompt_cache_retention"] != nil || body["prompt_cache_options"] != nil {
+		t.Fatal("OpenRouter mode leaked OpenAI extensions")
+	}
+	block := body["messages"].([]any)[0].(map[string]any)["content"].([]any)[0].(map[string]any)
+	if block["cache_control"].(map[string]any)["ttl"] != "1h" {
+		t.Fatal("explicit compatible block TTL was lost")
+	}
