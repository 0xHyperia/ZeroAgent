+func TestPromptCacheSettingsReachActualModelRequest(t *testing.T) {
+	for _, failover := range []bool{false, true} {
+		for _, tc := range []struct {
+			name, api, providerMode, modelMode string
+			legacyOff, key, header             bool
+		}{
+			{name: "responses auto", api: ai.APIResponses, providerMode: "auto", key: true},
+			{name: "responses missing defaults", api: ai.APIResponses, key: true},
+			{name: "responses off", api: ai.APIResponses, providerMode: "none"},
+			{name: "legacy false", api: ai.APIResponses, legacyOff: true},
+			{name: "openrouter only header", api: ai.APIResponses, providerMode: "openrouter-session", header: true},
+			{name: "unknown chat auto", api: ai.APIChatCompletions, providerMode: "auto"},
+			{name: "chat explicit key", api: ai.APIChatCompletions, providerMode: "openai-key", key: true},
+			{name: "chat explicit router", api: ai.APIChatCompletions, providerMode: "openrouter-session", header: true},
+			{name: "model off overrides auto", api: ai.APIResponses, providerMode: "auto", modelMode: "none"},
+			{name: "model auto overrides off", api: ai.APIResponses, providerMode: "none", modelMode: "auto", legacyOff: true, key: true},
+			{name: "model key overrides legacy off", api: ai.APIResponses, modelMode: "openai-key", legacyOff: true, key: true},
+			{name: "model router overrides key", api: ai.APIResponses, providerMode: "openai-key", modelMode: "openrouter-session", header: true},
+		} {
+			t.Run(tc.name+map[bool]string{true: " failover", false: " direct"}[failover], func(t *testing.T) {
+				var body map[string]any
+				var headers http.Header
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+					headers = r.Header.Clone()
+					if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+						t.Error(err)
+					}
+					w.Header().Set("Content-Type", "application/json")
+					if tc.api == ai.APIResponses {
+						_, _ = w.Write([]byte(`{"status":"completed","output":[{"type":"message","role":"assistant","content":[{"type":"output_text","text":"ok"}]}]}`))
+					} else {
+						_, _ = w.Write([]byte(`{"choices":[{"message":{"role":"assistant","content":"ok"}}]}`))
+					}
+				}))
+				defer server.Close()
+				provider := config.Provider{Type: "codex", API: tc.api, BaseURL: server.URL, APIKey: "fixture", PromptCacheHintMode: tc.providerMode}
+				if tc.legacyOff {
+					off := false
+					provider.PromptCachingEnabled = &off
+				}
+				cfg := &config.Config{Providers: map[string]config.Provider{"p": provider}, Models: map[string]config.Model{"m": {ID: "m", Providers: []string{"p"}, Context: 32000, MaxOut: 256, PromptCacheHintMode: tc.modelMode}}}
+				var route Route
+				var err error
+				if failover {
+					route, err = ResolveFailoverRouteContext(t.Context(), cfg, "m", "p", false)
+				} else {
+					route, err = ResolveRoute(cfg, "m", "p", false)
+				}
+				if err != nil {
+					t.Fatal(err)
+				}
+				route.Client.SetCacheKey("stable-session")
+				if _, _, err = route.Client.Complete(context.Background(), ai.Request{Model: "m", Messages: []ai.Message{{Role: "user", Content: "hello"}}}); err != nil {
+					t.Fatal(err)
+				}
+				if (body["prompt_cache_key"] == "stable-session") != tc.key {
+					t.Fatalf("cache key=%v", body["prompt_cache_key"])
+				}
+				if (headers.Get("x-session-id") == "stable-session") != tc.header {
+					t.Fatalf("affinity=%q", headers.Get("x-session-id"))
+				}
+				if body["prompt_cache_options"] != nil || body["prompt_cache_retention"] != nil {
+					t.Fatal("strict relay received unsupported cache fields")
+				}
+				if cfg.Providers["p"].PromptCacheHintMode != tc.providerMode {
+					t.Fatal("model policy modified provider settings")
+				}
+			})
+		}
+	}
+}
