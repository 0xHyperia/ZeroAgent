+++ b/internal/skills/zeroagent_builtin_test.go
@@ -0,0 +1,100 @@
+package skills
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestZeroAgentCodeReviewOwnershipAndProtection(t *testing.T) {
+	t.Setenv("LIVEAGENT_HOME", t.TempDir())
+	m, err := NewManager()
+	if err != nil {
+		t.Fatal(err)
+	}
+	target := fixtureSkill(t, m.Root(), "zeroagent-code-review")
+	list, _, err := m.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, s := range list {
+		if s.Name == "zeroagent-code-review" && s.BuiltIn {
+			t.Fatal("unmanaged name collision must not be a trusted builtin")
+		}
+	}
+	marker := filepath.Join(target, "_zeroagent_builtin.json")
+	if err := os.WriteFile(marker, []byte("{\"schemaVersion\":1,\"owner\":\"ZeroAgent\",\"skill\":\"zeroagent-code-review\"}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	list, _, err = m.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	found := false
+	for _, s := range list {
+		if s.Name == "zeroagent-code-review" {
+			found = s.BuiltIn
+		}
+	}
+	if !found {
+		t.Fatal("host-owned code review must be exposed as builtIn")
+	}
+	if _, err := m.Delete("zeroagent-code-review"); err == nil {
+		t.Fatal("builtin delete accepted")
+	}
+	if _, err := m.Create("zeroagent-code-review", "changed", "changed", "overwrite", nil); err == nil {
+		t.Fatal("builtin create overwrite accepted")
+	}
+	source := fixtureSkill(t, t.TempDir(), "replacement")
+	if _, err := m.Install(context.Background(), source, "zeroagent-code-review", "overwrite", nil, nil); err == nil {
+		t.Fatal("builtin install overwrite accepted")
+	}
+	if _, err := m.SaveSettings("", SkillSettings{Enabled: true, Selected: []string{"zeroagent-code-review"}}); err != nil {
+		t.Fatal(err)
+	}
+	selected, _, err := m.Effective(t.TempDir())
+	if err != nil {
+		t.Fatal(err)
+	}
+	found = false
+	for _, s := range selected {
+		if s.Name == "zeroagent-code-review" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("selected builtin missing from effective model skills")
+	}
+	if err := os.WriteFile(marker, []byte("{\"owner\":\"someone-else\"}"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.Delete("zeroagent-code-review"); err != nil {
+		t.Fatal("unmanaged collision must retain user ownership", err)
+	}
+}
+
+func TestZeroAgentBuiltinMarkerDoesNotFollowLinks(t *testing.T) {
+	t.Setenv("LIVEAGENT_HOME", t.TempDir())
+	m, err := NewManager()
+	if err != nil {
+		t.Fatal(err)
+	}
+	target := fixtureSkill(t, m.Root(), "zeroagent-code-review")
+	outside := filepath.Join(t.TempDir(), "marker.json")
+	if err := os.WriteFile(outside, []byte("{\"schemaVersion\":1,\"owner\":\"ZeroAgent\",\"skill\":\"zeroagent-code-review\"}\n"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.Symlink(outside, filepath.Join(target, "_zeroagent_builtin.json")); err != nil {
+		t.Skip("symlink unavailable", err)
+	}
+	list, _, err := m.List()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, s := range list {
+		if s.Name == "zeroagent-code-review" && s.BuiltIn {
+			t.Fatal("linked marker cannot assert builtin ownership")
+		}
+	}
+}
