+
+// The desktop host seeds its own workflow before this manager starts. An exact
+// ownership marker distinguishes it from an existing user skill with the same name.
+func (m *Manager) isBuiltin(n string) bool {
+	if n == "skills-creator" || n == "skills-installer" {
+		return true
+	}
+	if n != "zeroagent-code-review" {
+		return false
+	}
+	path, err := safePath(m.root, n+"/_zeroagent_builtin.json")
+	if err != nil {
+		return false
+	}
+	file, err := os.Open(path)
+	if err != nil {
+		return false
+	}
+	defer file.Close()
+	body, err := io.ReadAll(io.LimitReader(file, 512))
+	return err == nil && string(body) == "{\"schemaVersion\":1,\"owner\":\"ZeroAgent\",\"skill\":\"zeroagent-code-review\"}\n"
+}
 
