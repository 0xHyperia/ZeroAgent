diff --git a/internal/plugins/install.go b/internal/plugins/install.go
new file mode 100644
index 0000000..5f099fa
--- /dev/null
+++ b/internal/plugins/install.go
@@ -0,0 +1,190 @@
+package plugins
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+const (
+	maxInstallEntries = 4096
+	maxInstallDepth   = 24
+	maxInstallFile    = 16 << 20
+	maxInstallBytes   = 64 << 20
+)
+
+func (m *Manager) Install(src string) error {
+	return m.InstallWithin(src, "")
+}
+
+// InstallWithin anchors reads to the supplied workspace for device installs.
+// A local caller that picked the directory can omit the workspace. The
+// manifest is parsed from the staged copy only after its source was bounded.
+func (m *Manager) InstallWithin(src, workspace string) error {
+	src, err := filepath.Abs(src)
+	if err != nil {
+		return err
+	}
+	parent, relative := src, "."
+	if workspace != "" {
+		parent, err = filepath.Abs(workspace)
+		if err != nil {
+			return err
+		}
+		relative, err = filepath.Rel(parent, src)
+		if err != nil || !filepath.IsLocal(relative) {
+			return errors.New("plugin source is outside the authorized workspace")
+		}
+	}
+
+	meta, err := os.Lstat(parent)
+	if err != nil || !meta.IsDir() {
+		return errors.New("plugin source must be a directory without symbolic links")
+	}
+	root, err := os.OpenRoot(parent)
+	if err != nil {
+		return err
+	}
+	defer root.Close()
+	opened, err := root.Stat(".")
+	if err != nil || !os.SameFile(meta, opened) {
+		return errors.New("plugin source changed during installation")
+	}
+
+	home := pluginHome()
+	if home == "" {
+		return errors.New("plugin directory is unavailable")
+	}
+	if err := os.MkdirAll(home, 0o750); err != nil {
+		return err
+	}
+	staging, err := os.MkdirTemp(home, ".plugin-install-")
+	if err != nil {
+		return err
+	}
+	// staging is a freshly allocated child of the process-owned plugin home.
+	// Once renamed, this cleanup only addresses its old temporary name.
+	defer os.RemoveAll(staging)
+	if err := copyInstallDirectory(root, relative, staging, 0, &installBudget{
+		entries: maxInstallEntries,
+		bytes:   maxInstallBytes,
+	}); err != nil {
+		return err
+	}
+	p, err := Load(staging)
+	if err != nil {
+		return err
+	}
+	pluginsDir := filepath.Join(home, "plugins")
+	if err := os.MkdirAll(pluginsDir, 0o750); err != nil {
+		return err
+	}
+	info, err := os.Lstat(pluginsDir)
+	if err != nil || !info.IsDir() {
+		return errors.New("plugin destination must be a directory without symbolic links")
+	}
+	dst := filepath.Join(pluginsDir, p.Name)
+	if _, err := os.Lstat(dst); !errors.Is(err, os.ErrNotExist) {
+		if err != nil {
+			return err
+		}
+		return fmt.Errorf("plugin %q is already installed", p.Name)
+	}
+	if err := os.Rename(staging, dst); err != nil {
+		return err
+	}
+	return m.Reload()
+}
+
+type installBudget struct {
+	entries int
+	bytes   int64
+}
+
+func copyInstallDirectory(root *os.Root, relative, dst string, depth int, budget *installBudget) error {
+	if depth > maxInstallDepth {
+		return errors.New("plugin directory is too deeply nested")
+	}
+	meta, err := root.Lstat(relative)
+	if err != nil || !meta.IsDir() {
+		return errors.New("plugin directories must not be symbolic links")
+	}
+	dir, err := root.OpenRoot(relative)
+	if err != nil {
+		return err
+	}
+	defer dir.Close()
+	opened, err := dir.Stat(".")
+	if err != nil || !os.SameFile(meta, opened) {
+		return errors.New("plugin directory changed during installation")
+	}
+	reader, err := dir.Open(".")
+	if err != nil {
+		return err
+	}
+	entries, readErr := reader.ReadDir(budget.entries + 1)
+	reader.Close()
+	if readErr != nil && !errors.Is(readErr, io.EOF) {
+		return readErr
+	}
+	if len(entries) > budget.entries {
+		return errors.New("plugin contains too many files or directories")
+	}
+	budget.entries -= len(entries)
+	for _, entry := range entries {
+		name := entry.Name()
+		to := filepath.Join(dst, name)
+		info, err := dir.Lstat(name)
+		if err != nil {
+			return err
+		}
+		switch {
+		case info.IsDir():
+			if err := os.Mkdir(to, 0o750); err != nil {
+				return err
+			}
+			if err := copyInstallDirectory(dir, name, to, depth+1, budget); err != nil {
+				return err
+			}
+		case info.Mode().IsRegular():
+			if err := copyInstallFile(dir, name, to, info, budget); err != nil {
+				return err
+			}
+		default:
+			return errors.New("plugins must contain only ordinary files and directories")
+		}
+	}
+	return nil
+}
+
+func copyInstallFile(root *os.Root, name, dst string, info os.FileInfo, budget *installBudget) error {
+	limit := min(int64(maxInstallFile), budget.bytes)
+	if info.Size() > limit {
+		return errors.New("plugin files exceed the installation size limit")
+	}
+	file, err := root.OpenFile(name, installReadFlags, 0)
+	if err != nil {
+		return err
+	}
+	defer file.Close()
+	opened, err := file.Stat()
+	if err != nil || !opened.Mode().IsRegular() || !os.SameFile(info, opened) {
+		return errors.New("plugin file changed during installation")
+	}
+	target, err := os.OpenFile(dst, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0o640)
+	if err != nil {
+		return err
+	}
+	written, copyErr := io.Copy(target, io.LimitReader(file, limit+1))
+	closeErr := target.Close()
+	if err := errors.Join(copyErr, closeErr); err != nil {
+		return err
+	}
+	if written > limit {
+		return errors.New("plugin files exceed the installation size limit")
+	}
+	budget.bytes -= written
+	return nil
+}
