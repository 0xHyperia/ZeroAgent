+package plugins
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestBoundedPluginInstall(t *testing.T) {
+	home := isolatePluginHome(t)
+	workspace := t.TempDir()
+	src := filepath.Join(workspace, "author", "demo")
+	writeManifest(t, src, `{"name":"demo","version":"1","command":["demo"]}`)
+	if err := os.Mkdir(filepath.Join(src, "assets"), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(src, "assets", "page.txt"), []byte("authored asset"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	manager, err := New("")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := manager.InstallWithin(src, workspace); err != nil {
+		t.Fatal(err)
+	}
+	asset, err := os.ReadFile(filepath.Join(home, "plugins", "demo", "assets", "page.txt"))
+	if err != nil || string(asset) != "authored asset" {
+		t.Fatalf("installed asset = %q, error = %v", asset, err)
+	}
+	outside := t.TempDir()
+	writeManifest(t, outside, `{"name":"other","command":["demo"]}`)
+	if err := manager.InstallWithin(outside, workspace); err == nil {
+		t.Fatal("installed from outside the scope")
+	}
+	link := filepath.Join(src, "external")
+	if err := os.Symlink(filepath.Join(outside, "plugin.json"), link); err != nil {
+		t.Logf("symlink fixture unavailable: %v", err)
+		return
+	}
+	if err := manager.InstallWithin(src, workspace); err == nil {
+		t.Fatal("installed an external link")
+	}
+	linked := filepath.Join(workspace, "link")
+	if err := os.Symlink(outside, linked); err != nil {
+		t.Skipf("directory symlink fixture unavailable: %v", err)
+	}
+	if err := manager.InstallWithin(linked, workspace); err == nil {
+		t.Fatal("installed from a linked directory")
+	}
+	if other, ok := manager.Get("other"); ok {
+		t.Fatalf("outside plugin was published: %+v", other)
+	}
+}
+
+func TestBoundedPluginInstallRejectsLinkedManifest(t *testing.T) {
+	home := isolatePluginHome(t)
+	src := t.TempDir()
+	outside := t.TempDir()
+	writeManifest(t, outside, `{"name":"linked","command":["demo"]}`)
+	if err := os.Symlink(filepath.Join(outside, "plugin.json"), filepath.Join(src, "plugin.json")); err != nil {
+		t.Skipf("symlink fixture unavailable: %v", err)
+	}
+	manager, err := New("")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := manager.Install(src); err == nil {
+		t.Fatal("installed a linked manifest")
+	}
+	if _, err := os.Stat(filepath.Join(home, "plugins", "linked")); !os.IsNotExist(err) {
+		t.Fatalf("rejected plugin was published: %v", err)
+	}
+}
+
+func TestBoundedPluginCopyBudgetAndCleanup(t *testing.T) {
+	home := isolatePluginHome(t)
+	src := t.TempDir()
+	writeManifest(t, src, `{"name":"large","command":["demo"]}`)
+	file, err := os.Create(filepath.Join(src, "large"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := file.Truncate(maxInstallFile + 1); err != nil {
+		file.Close()
+		t.Fatal(err)
+	}
+	if err := file.Close(); err != nil {
+		t.Fatal(err)
+	}
+	manager, err := New("")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := manager.Install(src); err == nil {
+		t.Fatal("installed an oversized tree")
+	}
+	if _, err := os.Stat(filepath.Join(home, "plugins", "large")); !os.IsNotExist(err) {
+		t.Fatalf("rejected plugin was published: %v", err)
+	}
+	pending, err := filepath.Glob(filepath.Join(home, ".plugin-install-*"))
+	if err != nil || len(pending) != 0 {
+		t.Fatalf("staging files left after rejection: %v, %v", pending, err)
+	}
+	root, err := os.OpenRoot(src)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer root.Close()
+	for _, budget := range []installBudget{{entries: 1, bytes: maxInstallBytes}, {entries: 10, bytes: 1}} {
+		if err := copyInstallDirectory(root, ".", t.TempDir(), 0, &budget); err == nil {
+			t.Fatal("copy exceeded its budget")
+		}
+	}
+}
