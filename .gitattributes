* text=auto eol=lf

# Embedded workflow releases are immutable payloads; keep their exact source bytes.
crates/agent-gateway/internal/account/skills/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
crates/agent-gateway/internal/account/skills-releases/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Unified-diff context prefixes are payload, including blank context lines and tabs.
# Keep patch bytes intact; applied K-brain source has its own formatting and tests.
patches/kbrain/*.patch -whitespace
# pnpm dependency patches also retain the upstream compiled-code context verbatim.
patches/@extend-ai__react-xlsx@0.19.0.patch -whitespace
