# Append reviewed values to the private Gateway env used by the base manifest.
# Never put the E2B management key or scope-signing key in the Gateway env.
CLOUD_EXECUTOR_IMAGE=ghcr.io/0xhyperia/zeroagent-cloud-executor@sha256:replace-with-reviewed-digest
CLOUD_EXECUTOR_ENV_FILE=/opt/usa0/config/zeroagent-cloud-executor.env
ZEROAGENT_CLOUD_EXECUTOR_TOKEN=replace-with-random-internal-token
ZEROAGENT_OBJECT_STORAGE_ENDPOINT=https://storage.example.invalid
ZEROAGENT_OBJECT_STORAGE_BUCKET=zeroagent-cloudchat
ZEROAGENT_OBJECT_STORAGE_REGION=us-east-1
ZEROAGENT_OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-storage-access-key
ZEROAGENT_OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret
ZEROAGENT_CLOUD_WEB_FETCH_ENABLED=false
ZEROAGENT_TAVILY_API_KEY=
# Operator limits. They do not renew sandboxes or increase the account/day budget.
ZEROAGENT_CLOUD_RUN_WORKERS=2
ZEROAGENT_CLOUD_RUN_TIMEOUT_SECONDS=900
ZEROAGENT_CLOUD_MODEL_MAX_ROUNDS=12
ZEROAGENT_CLOUD_TOOL_MAX_CALLS=32
ZEROAGENT_CLOUD_ACCOUNT_MAX_EXECUTING=1
ZEROAGENT_CLOUD_ACCOUNT_MAX_QUEUED=20
ZEROAGENT_CLOUD_EVENT_MAX_STREAMS=128
ZEROAGENT_CLOUD_EVENT_MAX_STREAMS_PER_ACCOUNT=8
CLOUD_EXECUTOR_MEMORY_LIMIT=2g
CLOUD_EXECUTOR_CPUS=2
