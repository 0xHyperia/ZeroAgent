# Separate private file, 0600, supplied only to the SDK adapter container.
ZEROAGENT_E2B_API_KEY=replace-with-dedicated-e2b-management-key
ZEROAGENT_E2B_TEMPLATE=replace-with-reviewed-template-id
ZEROAGENT_CLOUD_EXECUTOR_SCOPE_KEY=replace-with-stable-random-scope-signing-key
ZEROAGENT_CLOUD_EXECUTOR_NAMESPACE=zeroagent-cloudchat-production
# Logical serialized receipt budget, not filesystem disk usage; initial limits.
ZEROAGENT_CLOUD_EXECUTOR_MAX_RECEIPTS=1000000
ZEROAGENT_CLOUD_EXECUTOR_MAX_JOURNAL_BYTES=1073741824
