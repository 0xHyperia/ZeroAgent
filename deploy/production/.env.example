APP_IMAGE=ghcr.io/0xhyperia/zeroagent-gateway@sha256:replace-with-release-digest
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine
USA0_DATA_ROOT=/opt/usa0/data
TZ=Asia/Shanghai
POSTGRES_USER=zeroagent
POSTGRES_PASSWORD=replace-with-random-password
POSTGRES_DB=zeroagent
REDIS_PASSWORD=replace-with-different-random-password
# Gateway 调用同机 Sub2API 时走 Docker 内网，避免绕行 Cloudflare。
USA_ZERO_ORIGIN=http://sub2api:8080
# 浏览器授权页面必须保留公开 HTTPS 地址。
USA_ZERO_AUTHORIZATION_ORIGIN=https://usa0.top
ZEROAGENT_WEB_OAUTH_CLIENT_SECRET=replace-with-shared-oauth-client-secret
ZEROAGENT_GATEWAY_PUBLIC_ORIGIN=https://agent.usa0.top
ZEROAGENT_GATEWAY_WEB_SESSION_TTL=720h
ZEROAGENT_GATEWAY_SELECTION_LEASE_TTL=8h
ZEROAGENT_GATEWAY_HTTP_ADDR=0.0.0.0:8080
ZEROAGENT_GATEWAY_TLS_CERT=
ZEROAGENT_GATEWAY_TLS_KEY=
ZEROAGENT_GATEWAY_REQUEST_TIMEOUT=2m
ZEROAGENT_GATEWAY_CHAT_PREPARE_TIMEOUT=2s
ZEROAGENT_GATEWAY_CHAT_DELIVERY_TIMEOUT=5s
ZEROAGENT_GATEWAY_CHAT_START_TIMEOUT=5s
ZEROAGENT_GATEWAY_CHAT_RENDER_START_TIMEOUT=10s
ZEROAGENT_GATEWAY_HEARTBEAT_PERIOD=30s
ZEROAGENT_GATEWAY_WS_HEARTBEAT_PERIOD=15s
ZEROAGENT_GATEWAY_WS_HEARTBEAT_GRACE=5s
ZEROAGENT_GATEWAY_WS_WRITE_TIMEOUT=10s
ZEROAGENT_GATEWAY_WS_WRITE_QUEUE_SIZE=512
ZEROAGENT_GATEWAY_GRPC_MAX_MESSAGE_BYTES=33554432
ZEROAGENT_GATEWAY_RELAY_BUFFER_SECONDS=30
ZEROAGENT_GATEWAY_COMMAND_QUEUE_TIMEOUT=30s
SMOKE_EMAIL=
SMOKE_PASSWORD=
